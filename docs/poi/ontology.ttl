       rdfs:subClassOf :VisualLandmark ;
       :hasTypeConfiguration :Tower-configuration ;
       rdfs:comment "A tower, such as a bell tower or observation tower."@en ;
       rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
       rdfs:label "Tower"@en .


