###  http://w3id.org/trajecto/poi#Transition
:Transition rdf:type owl:Class ;
            rdfs:subClassOf <http://w3id.org/trajecto#PointOfInterest> ;
            :hasTypeConfiguration :TransitionPOI-configuration ;
            rdfs:comment "A feature that connects spaces or levels, such as an entrance, exit, staircase or elevator."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
            rdfs:label "Transition"@en .


###  http://w3id.org/trajecto/poi#TransitionPoint
:TransitionPoint rdf:type owl:Class ;
                 rdfs:subClassOf :POICategory ;
                 rdfs:comment "Points of interest that mark transitions between different spaces."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                 rdfs:label "Transition Point"@en .


###  http://w3id.org/trajecto/poi#Transportation
