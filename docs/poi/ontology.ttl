@prefix : <http://w3id.org/trajecto/poi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://w3id.org/trajecto/poi#> .

<http://w3id.org/trajecto/poi> rdf:type owl:Ontology ;
                                owl:versionIRI <http://w3id.org/trajecto/poi/1.1.0> ;
                                <http://purl.org/dc/terms/created> "2025-05-09"^^xsd:date ;
                                <http://purl.org/dc/terms/creator> "Konstantinos Kotis" ,
                                                                   "Sotirios Angelis" ;
                                <http://purl.org/dc/terms/description> "Point-of-interest taxonomy (aligned to OpenStreetMap tags), POI functions and attraction levels, POI sequences, and the POI interaction hierarchy (passing, meaningful, immersive, extended, dominant, start, destination). The module also carries one POITypeConfiguration individual per POI type with the dwell thresholds (minimum meaningful, typical, maximum reasonable duration) that classify interactions as passing, meaningful or immersive."@en ;
                                <http://purl.org/dc/terms/issued> "2026-10-01"^^xsd:date ;
                                <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/> ;
                                <http://purl.org/dc/terms/modified> "2026-10-01"^^xsd:date ;
                                <http://purl.org/dc/terms/publisher> "i-Lab, Department of Cultural Technology and Communication, University of the Aegean" ;
                                <http://purl.org/dc/terms/title> "Trajecto POI Module"@en ;
                                <http://purl.org/vocab/vann/preferredNamespacePrefix> "poi" ;
                                <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/trajecto/poi#" ;
                                rdfs:label "trajecto-poi"@en ;
                                owl:priorVersion <http://w3id.org/trajecto/poi/1.0> ;
                                owl:versionInfo "1.1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://w3id.org/trajecto/poi#hasMaximumReasonableDuration
:hasMaximumReasonableDuration rdf:type owl:AnnotationProperty ;
                              rdfs:comment "Maximum reasonable duration for interaction with this POI category before it becomes anomalous."@en ;
                              rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                              rdfs:label "has maximum reasonable duration"@en ;
                              <http://www.w3.org/2004/02/skos/core#definition> "The upper threshold beyond which an interaction duration is considered unusually long."@en ;
                              rdfs:range xsd:duration ;
                              rdfs:domain :POITypeConfiguration .


###  http://w3id.org/trajecto/poi#hasMinimumMeaningfulDuration
:hasMinimumMeaningfulDuration rdf:type owl:AnnotationProperty ;
                              rdfs:comment "Minimum duration required for an interaction to be considered meaningful for this POI category."@en ;
                              rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                              rdfs:label "has minimum meaningful duration"@en ;
                              <http://www.w3.org/2004/02/skos/core#definition> "The threshold duration below which an interaction is considered too brief to be meaningful for the specific POI type."@en ;
                              rdfs:range xsd:duration ;
                              rdfs:domain :POITypeConfiguration .


###  http://w3id.org/trajecto/poi#hasTypeConfiguration
:hasTypeConfiguration rdf:type owl:AnnotationProperty ;
                      rdfs:comment "Links a POI class to the configuration individual carrying its dwell parameters."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                      rdfs:label "has type configuration"@en ;
                      rdfs:range :POITypeConfiguration .


###  http://w3id.org/trajecto/poi#hasTypicalDuration
:hasTypicalDuration rdf:type owl:AnnotationProperty ;
                    rdfs:comment "Typical or expected duration for meaningful engagement with this POI category."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                    rdfs:label "has typical duration"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The average or expected duration for normal engagement with this type of POI."@en ;
                    rdfs:range xsd:duration ;
                    rdfs:domain :POITypeConfiguration .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#related
<http://www.w3.org/2004/02/skos/core#related> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://w3id.org/trajecto/poi#covisitedWith
:covisitedWith rdf:type owl:ObjectProperty ;
               rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
               rdfs:range <http://w3id.org/trajecto#PointOfInterest> ;
               rdfs:comment "Two POIs are interacted with meaningfully in the same trajectory."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
               rdfs:label "covisited with"@en .


###  http://w3id.org/trajecto/poi#followedBy
:followedBy rdf:type owl:ObjectProperty ;
            rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
            rdfs:range <http://w3id.org/trajecto#PointOfInterest> ;
            rdfs:comment "A POI is interacted with meaningfully immediately before another in at least one trajectory."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
            rdfs:label "followed by"@en .


###  http://w3id.org/trajecto/poi#hasInteractionClassification
:hasInteractionClassification rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                              rdfs:domain :POIInteraction ;
                              rdfs:range :InteractionClassification ;
                              rdfs:comment "Associates a POI interaction with its duration-based classification."@en ;
                              rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                              rdfs:label "has interaction classification"@en .


###  http://w3id.org/trajecto/poi#hasNextPOI
:hasNextPOI rdf:type owl:ObjectProperty ,
                     owl:TransitiveProperty ;
            rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
            rdfs:range <http://w3id.org/trajecto#PointOfInterest> ;
            rdfs:comment "Links a point of interest to the next one in a sequence."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
            rdfs:label "has next POI"@en .


###  http://w3id.org/trajecto/poi#hasPOIAttraction
:hasPOIAttraction rdf:type owl:ObjectProperty ;
                  rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
                  rdfs:range :AttractionLevel ;
                  rdfs:comment "Specifies the level of attraction a POI has for visitors."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                  rdfs:label "has POI attraction"@en .


###  http://w3id.org/trajecto/poi#hasPOICategory
:hasPOICategory rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
                rdfs:range :POICategory ;
                rdfs:comment "Associates a point of interest with its category."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                rdfs:label "has POI category"@en .


###  http://w3id.org/trajecto/poi#hasPOIInteraction
:hasPOIInteraction rdf:type owl:ObjectProperty ;
                   rdfs:domain <http://www.datacron-project.eu/datAcron#TrajectoryPart> ;
                   rdfs:range :POIInteraction ;
                   rdfs:comment "Links a trajectory part to an interaction with a point of interest."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                   rdfs:label "has POI interaction"@en .


###  http://w3id.org/trajecto/poi#hasPOISequence
:hasPOISequence rdf:type owl:ObjectProperty ;
                rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                rdfs:range :POISequence ;
                rdfs:comment "Links a trajectory to a sequence of visited points of interest."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                rdfs:label "has POI sequence"@en .


###  http://w3id.org/trajecto/poi#hasPrimaryFunction
:hasPrimaryFunction rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                    rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
                    rdfs:range :POIFunction ;
                    rdfs:comment "Associates a point of interest with its main function."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                    rdfs:label "has primary function"@en .


###  http://w3id.org/trajecto/poi#hasRoom
:hasRoom rdf:type owl:ObjectProperty ;
         rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
         rdfs:comment "The room in which an artwork is exhibited."@en ;
         rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
         rdfs:label "has room"@en .


###  http://w3id.org/trajecto/poi#interactsWith
:interactsWith rdf:type owl:ObjectProperty ;
               rdfs:domain :POIInteraction ;
               rdfs:range <http://w3id.org/trajecto#PointOfInterest> ;
               rdfs:comment "Specifies the point of interest involved in an interaction."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
               rdfs:label "interacts with"@en .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://w3id.org/trajecto/poi#creationPeriod
:creationPeriod rdf:type owl:DatatypeProperty ;
                rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
                rdfs:range xsd:string ;
                rdfs:comment "Creation date or period of an artwork point of interest."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                rdfs:label "creation period"@en .


###  http://w3id.org/trajecto/poi#creator
:creator rdf:type owl:DatatypeProperty ;
         rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
         rdfs:range xsd:string ;
         rdfs:comment "Creator or artist of an artwork point of interest."@en ;
         rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
         rdfs:label "creator"@en .


###  http://w3id.org/trajecto/poi#hasAttractionStrength
:hasAttractionStrength rdf:type owl:DatatypeProperty ;
                       rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
                       rdfs:range xsd:float ;
                       rdfs:comment "Numerical value indicating the strength of attraction of a POI."@en ;
                       rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                       rdfs:label "has attraction strength"@en .


###  http://w3id.org/trajecto/poi#hasDwellTime
:hasDwellTime rdf:type owl:DatatypeProperty ;
              rdfs:domain :POIInteraction ;
              rdfs:range xsd:duration ;
              rdfs:comment "Duration of time spent at a point of interest."@en ;
              rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
              rdfs:label "has dwell time"@en .


###  http://w3id.org/trajecto/poi#hasDwellTimeInSeconds
:hasDwellTimeInSeconds rdf:type owl:DatatypeProperty ;
                       rdfs:domain :POIInteraction ;
                       rdfs:range xsd:float ;
                       rdfs:comment "Duration of time spent at a point of interest, in seconds. Numeric counterpart of hasDwellTime."@en ;
                       rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                       rdfs:label "has dwell time in seconds"@en .


###  http://w3id.org/trajecto/poi#hasEra
:hasEra rdf:type owl:DatatypeProperty ;
        rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
        rdfs:range xsd:string ;
        rdfs:comment "The art-historical era of an artwork."@en ;
        rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
        rdfs:label "has era"@en .


###  http://w3id.org/trajecto/poi#hasPopularity
:hasPopularity rdf:type owl:DatatypeProperty ;
               rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
               rdfs:range xsd:float ;
               rdfs:comment "Numerical value indicating the popularity of a POI."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
               rdfs:label "has popularity"@en .


###  http://w3id.org/trajecto/poi#hasRevisitCount
:hasRevisitCount rdf:type owl:DatatypeProperty ;
                 rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
                 rdfs:range xsd:positiveInteger ;
                 rdfs:comment "Number of times a point of interest is revisited in a trajectory."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                 rdfs:label "has revisit count"@en .


###  http://w3id.org/trajecto/poi#hasType
:hasType rdf:type owl:DatatypeProperty ;
         rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
         rdfs:range xsd:string ;
         rdfs:comment "Medium or type of an artwork (e.g. Oil on canvas, Bronze)."@en ;
         rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
         rdfs:label "has type"@en .


#################################################################
#    Classes
#################################################################

###  http://w3id.org/trajecto#Interaction
<http://w3id.org/trajecto#Interaction> rdf:type owl:Class .


###  http://w3id.org/trajecto#PointOfInterest
<http://w3id.org/trajecto#PointOfInterest> rdf:type owl:Class ;
                                           :hasTypeConfiguration :Default-configuration ;
                                           rdfs:label "Point of Interest"@en .


###  http://w3id.org/trajecto/poi#ATM
:ATM rdf:type owl:Class ;
     rdfs:subClassOf :PrivateService ,
                     :Service ;
     :hasTypeConfiguration :ATM-configuration ;
     rdfs:comment "Automated teller machines."@en ;
     rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
     rdfs:label "ATM"@en .


###  http://w3id.org/trajecto/poi#Accommodation
:Accommodation rdf:type owl:Class ;
               rdfs:subClassOf <http://w3id.org/trajecto#PointOfInterest> ;
               :hasTypeConfiguration :AccommodationPOI-configuration ;
               rdfs:comment "A place that offers overnight stays, such as a hotel or hostel."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
               rdfs:label "Accommodation"@en ;
               <http://www.w3.org/2004/02/skos/core#related> <http://w3id.org/trajecto/purpose/skos#AccommodationPurpose> .


###  http://w3id.org/trajecto/poi#Airport
:Airport rdf:type owl:Class ;
         rdfs:subClassOf :Transportation ;
         :hasTypeConfiguration :Airport-configuration ;
         rdfs:comment "An airport or airfield."@en ;
         rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
         rdfs:label "Airport"@en ;
         <http://www.w3.org/2004/02/skos/core#related> <http://w3id.org/trajecto/purpose/skos#AirportTransit> .


###  http://w3id.org/trajecto/poi#Amenity
:Amenity rdf:type owl:Class ;
         rdfs:subClassOf <http://w3id.org/trajecto#PointOfInterest> ,
                         :POICategory ;
         :hasTypeConfiguration :AmenityPOI-configuration ;
         rdfs:comment "Points of interest providing comfort or convenience amenities."@en ;
         rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
         rdfs:label "Amenity"@en .


###  http://w3id.org/trajecto/poi#AnomalousInteraction
:AnomalousInteraction rdf:type owl:Class ;
                      rdfs:subClassOf :POIInteraction ;
                      rdfs:comment "An interaction with duration that exceeds reasonable bounds, potentially indicating data quality issues or unusual circumstances."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                      rdfs:label "Anomalous Interaction"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A POI interaction with duration beyond reasonable limits, requiring investigation for data quality or exceptional circumstances."@en .


###  http://w3id.org/trajecto/poi#Artwork
:Artwork rdf:type owl:Class ;
         rdfs:subClassOf :Cultural ;
         :hasTypeConfiguration :ArtworkPOI-configuration ;
         rdfs:comment "Artworks as points of interest in cultural spaces."@en ;
         rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
         rdfs:label "Artwork"@en .


###  http://w3id.org/trajecto/poi#AttractionLevel
:AttractionLevel rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract> ;
                 rdfs:comment "Level of attraction a point of interest has for visitors."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                 rdfs:label "Attraction Level"@en .


###  http://w3id.org/trajecto/poi#Bank
:Bank rdf:type owl:Class ;
      rdfs:subClassOf :Service ;
      :hasTypeConfiguration :Bank-configuration ;
      rdfs:comment "A bank branch."@en ;
      rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
      rdfs:label "Bank"@en ;
      <http://www.w3.org/2004/02/skos/core#related> <http://w3id.org/trajecto/purpose/skos#Banking> .


###  http://w3id.org/trajecto/poi#Bar
:Bar rdf:type owl:Class ;
     rdfs:subClassOf :Nightlife ;
     :hasTypeConfiguration :Bar-configuration ;
     rdfs:comment "A bar or pub serving drinks."@en ;
     rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
     rdfs:label "Bar"@en .


###  http://w3id.org/trajecto/poi#Beach
:Beach rdf:type owl:Class ;
       rdfs:subClassOf :Leisure ;
       :hasTypeConfiguration :Beach-configuration ;
       rdfs:comment "A beach used for recreation."@en ;
       rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
       rdfs:label "Beach"@en ;
       <http://www.w3.org/2004/02/skos/core#related> <http://w3id.org/trajecto/purpose/skos#BeachVisit> .


###  http://w3id.org/trajecto/poi#Bench
:Bench rdf:type owl:Class ;
       rdfs:comment "A bench. Not yet placed in the POI hierarchy and not linked to its own dwell configuration (Bench-configuration); interactions with it use the default configuration."@en ;
       rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
       rdfs:label "Bench"@en .


###  http://w3id.org/trajecto/poi#Bottleneck
:Bottleneck rdf:type owl:Class ;
            rdfs:subClassOf :TransitionPoint ;
            rdfs:comment "Points where movement is constrained or restricted."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
            rdfs:label "Bottleneck"@en .


###  http://w3id.org/trajecto/poi#BriefObservation
:BriefObservation rdf:type owl:Class ;
                  rdfs:subClassOf :Observation ;
                  rdfs:comment "Short, passing observation of a point of interest."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                  rdfs:label "Brief Observation"@en .


###  http://w3id.org/trajecto/poi#BusStation
:BusStation rdf:type owl:Class ;
            rdfs:subClassOf :Transportation ;
            :hasTypeConfiguration :BusStation-configuration ;
            rdfs:comment "A bus station or major bus stop."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
            rdfs:label "Bus Station"@en ;
            <http://www.w3.org/2004/02/skos/core#related> <http://w3id.org/trajecto/purpose/skos#BusStationTransit> .


###  http://w3id.org/trajecto/poi#Cafe
:Cafe rdf:type owl:Class ;
      rdfs:subClassOf :Dining ;
      :hasTypeConfiguration :Cafe-configuration ;
      rdfs:comment "A cafe serving coffee, drinks and light food."@en ;
      rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
      rdfs:label "Cafe"@en ;
      <http://www.w3.org/2004/02/skos/core#related> <http://w3id.org/trajecto/purpose/skos#CafeVisit> .


###  http://w3id.org/trajecto/poi#Church
:Church rdf:type owl:Class ;
        rdfs:subClassOf :Religious ;
        :hasTypeConfiguration :Church-configuration ;
        rdfs:comment "A Christian place of worship."@en ;
        rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
        rdfs:label "Church"@en ;
        <http://www.w3.org/2004/02/skos/core#related> <http://w3id.org/trajecto/purpose/skos#Worship> .


###  http://w3id.org/trajecto/poi#Cinema
:Cinema rdf:type owl:Class ;
        rdfs:subClassOf :PerformanceVenue ;
        :hasTypeConfiguration :Cinema-configuration ;
        rdfs:comment "A cinema."@en ;
        rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
        rdfs:label "Cinema"@en .


###  http://w3id.org/trajecto/poi#Clinic
:Clinic rdf:type owl:Class ;
        rdfs:subClassOf :Healthcare ;
        :hasTypeConfiguration :Clinic-configuration ;
        rdfs:comment "A medical clinic or doctor's practice."@en ;
        rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
        rdfs:label "Clinic"@en ;
        <http://www.w3.org/2004/02/skos/core#related> <http://w3id.org/trajecto/purpose/skos#MedicalAppointment> .


###  http://w3id.org/trajecto/poi#Club
:Club rdf:type owl:Class ;
      rdfs:subClassOf :Nightlife ;
      :hasTypeConfiguration :Club-configuration ;
      rdfs:comment "A club, typically a nightlife venue."@en ;
      rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
      rdfs:label "Club"@en .


###  http://w3id.org/trajecto/poi#ComfortFunction
:ComfortFunction rdf:type owl:Class ;
                 rdfs:subClassOf :POIFunction ;
                 rdfs:comment "Function of providing comfort or rest."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                 rdfs:label "Comfort Function"@en .


###  http://w3id.org/trajecto/poi#Commercial
