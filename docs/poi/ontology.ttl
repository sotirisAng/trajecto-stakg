             rdfs:comment "A sports field or pitch."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
             rdfs:label "Sports Field"@en .


###  http://w3id.org/trajecto/poi#Stadium
:Stadium rdf:type owl:Class ;
         rdfs:subClassOf :Sports ;
         :hasTypeConfiguration :Stadium-configuration ;
         rdfs:comment "A stadium."@en ;
         rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
         rdfs:label "Stadium"@en ;
         <http://www.w3.org/2004/02/skos/core#related> <http://w3id.org/trajecto/purpose/skos#SportsAttendance> .


###  http://w3id.org/trajecto/poi#Staircase
:Staircase rdf:type owl:Class ;
           rdfs:subClassOf :Transition ;
           :hasTypeConfiguration :Staircase-configuration ;
           rdfs:comment "A staircase connecting floors or levels."@en ;
           rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
           rdfs:label "Staircase"@en .


###  http://w3id.org/trajecto/poi#StartInteraction
:StartInteraction rdf:type owl:Class ;
                  rdfs:subClassOf :MeaningfulInteraction ;
                  rdfs:comment "An interaction at the origin/start point of a trajectory."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                  rdfs:label "Start Interaction"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A meaningful interaction marking the beginning of a trajectory, typically representing the user's departure point."@en .


###  http://w3id.org/trajecto/poi#Temple
:Temple rdf:type owl:Class ;
        rdfs:subClassOf :Religious ;
        :hasTypeConfiguration :Temple-configuration ;
