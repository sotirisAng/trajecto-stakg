###  http://w3id.org/trajecto/poi#DominantInteraction
:DominantInteraction rdf:type owl:Class ;
                     rdfs:subClassOf :MeaningfulInteraction ;
                     rdfs:comment "The single interaction with the highest engagement score within a trajectory. Singleton per trajectory."@en ;
                     rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                     rdfs:label "Dominant Interaction"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "The POI interaction that scored highest on the engagement metric (0.8 * log_norm_dwell + 0.2 * inv_norm_distance) within its trajectory. Exactly one per trajectory."@en .


