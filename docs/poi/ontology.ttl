            :hasTypeConfiguration :University-configuration ;
            rdfs:comment "A university or college."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
            rdfs:label "University"@en ;
            <http://www.w3.org/2004/02/skos/core#related> <http://w3id.org/trajecto/purpose/skos#UniversityAttendance> .


###  http://w3id.org/trajecto/poi#VendingMachine
:VendingMachine rdf:type owl:Class ;
                rdfs:comment "A vending machine. Not yet placed in the POI hierarchy and not linked to its own dwell configuration (VendingMachine-configuration); interactions with it use the default configuration."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                rdfs:label "Vending Machine"@en .


###  http://w3id.org/trajecto/poi#ViewingPoint
