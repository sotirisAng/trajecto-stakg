                       :hasTypicalDuration "PT3H"^^xsd:duration ;
                       rdfs:comment "Dwell thresholds: an interaction is meaningful from 1 h, typical at 3 h, and anomalous beyond 12 h. Used by: Airport."@en ;
                       rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                       rdfs:label "Airport configuration"@en .


