                rdfs:subClassOf <http://w3id.org/trajecto#PointOfInterest> ;
                :hasTypeConfiguration :TransportationPOI-configuration ;
                rdfs:comment "A transport facility. Top category of stations, airports and parking areas. Excluded from recommendation."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                rdfs:label "Transportation"@en ;
                <http://www.w3.org/2004/02/skos/core#related> <http://w3id.org/trajecto/purpose/skos#TransportationPurpose> .


