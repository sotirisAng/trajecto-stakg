###  http://w3id.org/trajecto/poi#VisualLandmark
:VisualLandmark rdf:type owl:Class ;
                rdfs:subClassOf :Landmark ;
                :hasTypeConfiguration :VisualLandmark-configuration ;
                rdfs:comment "Visually distinctive landmarks."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                rdfs:label "Visual Landmark"@en .


###  http://w3id.org/trajecto/poi#WaterFountain
:WaterFountain rdf:type owl:Class ;
               rdfs:comment "A water fountain. Not yet placed in the POI hierarchy and not linked to its own dwell configuration (WaterFountain-configuration); interactions with it use the default configuration."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
               rdfs:label "Water Fountain"@en .


###  http://w3id.org/trajecto/poi#Waypoint
:Waypoint rdf:type owl:Class ;
          rdfs:subClassOf :NavigationLandmark ;
          :hasTypeConfiguration :Waypoint-configuration ;
          rdfs:comment "A point used for orientation along a route."@en ;
          rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
          rdfs:label "Waypoint"@en .


###  http://www.datacron-project.eu/datAcron#Trajectory
<http://www.datacron-project.eu/datAcron#Trajectory> rdf:type owl:Class .


###  http://www.datacron-project.eu/datAcron#TrajectoryPart
<http://www.datacron-project.eu/datAcron#TrajectoryPart> rdf:type owl:Class .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract> rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://w3id.org/trajecto/poi#ATM-configuration
:ATM-configuration rdf:type owl:NamedIndividual ,
                            :POITypeConfiguration ;
                   :hasMaximumReasonableDuration "PT15M"^^xsd:duration ;
                   :hasMinimumMeaningfulDuration "PT1M"^^xsd:duration ;
                   :hasTypicalDuration "PT3M"^^xsd:duration ;
                   rdfs:comment "Dwell thresholds: an interaction is meaningful from 1 min, typical at 3 min, and anomalous beyond 15 min. Used by: ATM."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                   rdfs:label "ATM configuration"@en .


###  http://w3id.org/trajecto/poi#AccommodationPOI-configuration
:AccommodationPOI-configuration rdf:type owl:NamedIndividual ,
                                         :POITypeConfiguration ;
                                :hasMaximumReasonableDuration "P1D"^^xsd:duration ;
                                :hasMinimumMeaningfulDuration "PT30M"^^xsd:duration ;
                                :hasTypicalDuration "PT2H"^^xsd:duration ;
                                rdfs:comment "Dwell thresholds: an interaction is meaningful from 30 min, typical at 2 h, and anomalous beyond P1D. Used by: Accommodation."@en ;
                                rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
                                rdfs:label "AccommodationPOI configuration"@en .


