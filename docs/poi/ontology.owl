        <rdfs:label xml:lang="en">Passing Interaction</rdfs:label>
        <skos:definition xml:lang="en">A POI interaction with duration below the minimum meaningful threshold, suggesting the visitor was merely passing by or made only brief contact.</skos:definition>
    </owl:Class>
    


