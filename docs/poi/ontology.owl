    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#MeaningfulInteraction -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#MeaningfulInteraction">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#POIInteraction"/>
        <rdfs:comment xml:lang="en">An interaction with sufficient duration to be considered meaningful engagement with a POI.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Meaningful Interaction</rdfs:label>
        <skos:definition xml:lang="en">A POI interaction that meets or exceeds the minimum meaningful duration threshold for the specific POI category.</skos:definition>
    </owl:Class>
    


