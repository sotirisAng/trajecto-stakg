        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">POI Function</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#POIInteraction -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#POIInteraction">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto#Interaction"/>
        <rdfs:comment xml:lang="en">Interaction between a moving object and a point of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">POI Interaction</rdfs:label>
        <skos:definition xml:lang="en">A specific interaction between a moving entity and a point of interest during a trajectory.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#POISequence -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#POISequence">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract"/>
        <rdfs:comment xml:lang="en">An ordered sequence of points of interest visited in a trajectory.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">POI Sequence</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#POITypeConfiguration -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#POITypeConfiguration">
        <rdfs:comment xml:lang="en">Carrier for the dwell parameters that define, per POI type, what counts as a meaningful interaction. A configuration describes a POI class; it is not itself a Point of Interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">POI Type Configuration</rdfs:label>
    </owl:Class>
    


