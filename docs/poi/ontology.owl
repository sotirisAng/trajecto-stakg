        <hasTypeConfiguration rdf:resource="http://w3id.org/trajecto/poi#CulturalPOI-configuration"/>
        <rdfs:comment xml:lang="en">Points of interest with cultural significance.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Cultural</rdfs:label>
        <skos:related rdf:resource="http://w3id.org/trajecto/purpose/skos#CulturalPurpose"/>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#CustomerService -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#CustomerService">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#PrivateService"/>
        <hasTypeConfiguration rdf:resource="http://w3id.org/trajecto/poi#ServicePOI-configuration"/>
        <rdfs:comment xml:lang="en">Customer service points.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Customer Service</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#DestinationInteraction -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#DestinationInteraction">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#MeaningfulInteraction"/>
        <rdfs:comment xml:lang="en">An interaction at the destination/end point of a trajectory.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Destination Interaction</rdfs:label>
        <skos:definition xml:lang="en">A meaningful interaction marking the end of a trajectory, typically representing the user&apos;s arrival point or final destination.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#DigitalDisplay -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#DigitalDisplay">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#Information"/>
        <hasTypeConfiguration rdf:resource="http://w3id.org/trajecto/poi#DigitalDisplay-configuration"/>
        <rdfs:comment xml:lang="en">An electronic display that shows information or advertising.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Digital Display</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#DigitalEngagement -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#DigitalEngagement">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#Engagement"/>
        <rdfs:comment xml:lang="en">Digital or electronic interaction with a point of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Digital Engagement</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#Dining -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#Dining">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#Commercial"/>
        <hasTypeConfiguration rdf:resource="http://w3id.org/trajecto/poi#DiningPOI-configuration"/>
        <rdfs:comment xml:lang="en">A place to eat or drink. Top category of restaurants, cafes, fast food and food courts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Dining</rdfs:label>
        <skos:related rdf:resource="http://w3id.org/trajecto/purpose/skos#DiningExperience"/>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#DominantInteraction -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#DominantInteraction">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#MeaningfulInteraction"/>
        <rdfs:comment xml:lang="en">The single interaction with the highest engagement score within a trajectory. Singleton per trajectory.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Dominant Interaction</rdfs:label>
        <skos:definition xml:lang="en">The POI interaction that scored highest on the engagement metric (0.8 * log_norm_dwell + 0.2 * inv_norm_distance) within its trajectory. Exactly one per trajectory.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#Educational -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#Educational">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <hasTypeConfiguration rdf:resource="http://w3id.org/trajecto/poi#EducationalPOI-configuration"/>
        <rdfs:comment xml:lang="en">A place of education or research. Top category of schools, universities and libraries.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Educational</rdfs:label>
        <skos:related rdf:resource="http://w3id.org/trajecto/purpose/skos#EducationalPurpose"/>
    </owl:Class>
    


