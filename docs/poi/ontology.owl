<?xml version="1.0"?>
<rdf:RDF xmlns="http://w3id.org/trajecto/poi#"
     xml:base="http://w3id.org/trajecto/poi"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:poi="http://w3id.org/trajecto/poi#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://w3id.org/trajecto/poi">
        <owl:versionIRI rdf:resource="http://w3id.org/trajecto/poi/1.1.0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-09</terms:created>
        <terms:creator>Konstantinos Kotis</terms:creator>
        <terms:creator>Sotirios Angelis</terms:creator>
        <terms:description xml:lang="en">Point-of-interest taxonomy (aligned to OpenStreetMap tags), POI functions and attraction levels, POI sequences, and the POI interaction hierarchy (passing, meaningful, immersive, extended, dominant, start, destination). The module also carries one POITypeConfiguration individual per POI type with the dwell thresholds (minimum meaningful, typical, maximum reasonable duration) that classify interactions as passing, meaningful or immersive.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:modified>
        <terms:publisher>i-Lab, Department of Cultural Technology and Communication, University of the Aegean</terms:publisher>
        <terms:title xml:lang="en">Trajecto POI Module</terms:title>
        <vann:preferredNamespacePrefix>poi</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://w3id.org/trajecto/poi#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">trajecto-poi</rdfs:label>
        <owl:priorVersion rdf:resource="http://w3id.org/trajecto/poi/1.0"/>
        <owl:versionInfo>1.1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://w3id.org/trajecto/poi#hasMaximumReasonableDuration -->


    <owl:AnnotationProperty rdf:about="http://w3id.org/trajecto/poi#hasMaximumReasonableDuration">
        <rdfs:comment xml:lang="en">Maximum reasonable duration for interaction with this POI category before it becomes anomalous.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has maximum reasonable duration</rdfs:label>
        <skos:definition xml:lang="en">The upper threshold beyond which an interaction duration is considered unusually long.</skos:definition>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/poi#POITypeConfiguration"/>
    </owl:AnnotationProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasMinimumMeaningfulDuration -->


    <owl:AnnotationProperty rdf:about="http://w3id.org/trajecto/poi#hasMinimumMeaningfulDuration">
        <rdfs:comment xml:lang="en">Minimum duration required for an interaction to be considered meaningful for this POI category.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has minimum meaningful duration</rdfs:label>
        <skos:definition xml:lang="en">The threshold duration below which an interaction is considered too brief to be meaningful for the specific POI type.</skos:definition>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/poi#POITypeConfiguration"/>
    </owl:AnnotationProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasTypeConfiguration -->


    <owl:AnnotationProperty rdf:about="http://w3id.org/trajecto/poi#hasTypeConfiguration">
        <rdfs:comment xml:lang="en">Links a POI class to the configuration individual carrying its dwell parameters.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has type configuration</rdfs:label>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/poi#POITypeConfiguration"/>
    </owl:AnnotationProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasTypicalDuration -->


    <owl:AnnotationProperty rdf:about="http://w3id.org/trajecto/poi#hasTypicalDuration">
        <rdfs:comment xml:lang="en">Typical or expected duration for meaningful engagement with this POI category.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has typical duration</rdfs:label>
        <skos:definition xml:lang="en">The average or expected duration for normal engagement with this type of POI.</skos:definition>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/poi#POITypeConfiguration"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#related -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#related"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#duration -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto/poi#covisitedWith -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/poi#covisitedWith">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:comment xml:lang="en">Two POIs are interacted with meaningfully in the same trajectory.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">covisited with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/poi#followedBy -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/poi#followedBy">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:comment xml:lang="en">A POI is interacted with meaningfully immediately before another in at least one trajectory.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">followed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasInteractionClassification -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/poi#hasInteractionClassification">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/poi#POIInteraction"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/poi#InteractionClassification"/>
        <rdfs:comment xml:lang="en">Associates a POI interaction with its duration-based classification.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has interaction classification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasNextPOI -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/poi#hasNextPOI">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:comment xml:lang="en">Links a point of interest to the next one in a sequence.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has next POI</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasPOIAttraction -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/poi#hasPOIAttraction">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/poi#AttractionLevel"/>
        <rdfs:comment xml:lang="en">Specifies the level of attraction a POI has for visitors.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has POI attraction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasPOICategory -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/poi#hasPOICategory">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/poi#POICategory"/>
        <rdfs:comment xml:lang="en">Associates a point of interest with its category.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has POI category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasPOIInteraction -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/poi#hasPOIInteraction">
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/poi#POIInteraction"/>
        <rdfs:comment xml:lang="en">Links a trajectory part to an interaction with a point of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has POI interaction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasPOISequence -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/poi#hasPOISequence">
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/poi#POISequence"/>
        <rdfs:comment xml:lang="en">Links a trajectory to a sequence of visited points of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has POI sequence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasPrimaryFunction -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/poi#hasPrimaryFunction">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/poi#POIFunction"/>
        <rdfs:comment xml:lang="en">Associates a point of interest with its main function.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has primary function</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasRoom -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/poi#hasRoom">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:comment xml:lang="en">The room in which an artwork is exhibited.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has room</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/poi#interactsWith -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/poi#interactsWith">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/poi#POIInteraction"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:comment xml:lang="en">Specifies the point of interest involved in an interaction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">interacts with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith -->


    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto/poi#creationPeriod -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/poi#creationPeriod">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Creation date or period of an artwork point of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">creation period</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/poi#creator -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/poi#creator">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Creator or artist of an artwork point of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">creator</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasAttractionStrength -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/poi#hasAttractionStrength">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Numerical value indicating the strength of attraction of a POI.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has attraction strength</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasDwellTime -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/poi#hasDwellTime">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/poi#POIInteraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment xml:lang="en">Duration of time spent at a point of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has dwell time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasDwellTimeInSeconds -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/poi#hasDwellTimeInSeconds">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/poi#POIInteraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Duration of time spent at a point of interest, in seconds. Numeric counterpart of hasDwellTime.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has dwell time in seconds</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasEra -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/poi#hasEra">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The art-historical era of an artwork.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has era</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasPopularity -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/poi#hasPopularity">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Numerical value indicating the popularity of a POI.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has popularity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasRevisitCount -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/poi#hasRevisitCount">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">Number of times a point of interest is revisited in a trajectory.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has revisit count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/poi#hasType -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/poi#hasType">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Medium or type of an artwork (e.g. Oil on canvas, Bronze).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">has type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto#Interaction -->


    <owl:Class rdf:about="http://w3id.org/trajecto#Interaction"/>
    


    <!-- http://w3id.org/trajecto#PointOfInterest -->


    <owl:Class rdf:about="http://w3id.org/trajecto#PointOfInterest">
        <hasTypeConfiguration rdf:resource="http://w3id.org/trajecto/poi#Default-configuration"/>
        <rdfs:label xml:lang="en">Point of Interest</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#ATM -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#ATM">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#PrivateService"/>
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#Service"/>
        <hasTypeConfiguration rdf:resource="http://w3id.org/trajecto/poi#ATM-configuration"/>
        <rdfs:comment xml:lang="en">Automated teller machines.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">ATM</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#Accommodation -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#Accommodation">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <hasTypeConfiguration rdf:resource="http://w3id.org/trajecto/poi#AccommodationPOI-configuration"/>
        <rdfs:comment xml:lang="en">A place that offers overnight stays, such as a hotel or hostel.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Accommodation</rdfs:label>
        <skos:related rdf:resource="http://w3id.org/trajecto/purpose/skos#AccommodationPurpose"/>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#Airport -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#Airport">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#Transportation"/>
        <hasTypeConfiguration rdf:resource="http://w3id.org/trajecto/poi#Airport-configuration"/>
        <rdfs:comment xml:lang="en">An airport or airfield.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Airport</rdfs:label>
        <skos:related rdf:resource="http://w3id.org/trajecto/purpose/skos#AirportTransit"/>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#Amenity -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#Amenity">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#POICategory"/>
        <hasTypeConfiguration rdf:resource="http://w3id.org/trajecto/poi#AmenityPOI-configuration"/>
        <rdfs:comment xml:lang="en">Points of interest providing comfort or convenience amenities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Amenity</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#AnomalousInteraction -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#AnomalousInteraction">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#POIInteraction"/>
        <rdfs:comment xml:lang="en">An interaction with duration that exceeds reasonable bounds, potentially indicating data quality issues or unusual circumstances.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Anomalous Interaction</rdfs:label>
        <skos:definition xml:lang="en">A POI interaction with duration beyond reasonable limits, requiring investigation for data quality or exceptional circumstances.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#Artwork -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#Artwork">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#Cultural"/>
        <hasTypeConfiguration rdf:resource="http://w3id.org/trajecto/poi#ArtworkPOI-configuration"/>
        <rdfs:comment xml:lang="en">Artworks as points of interest in cultural spaces.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">Artwork</rdfs:label>
    </owl:Class>
    


