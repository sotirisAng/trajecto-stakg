    <!-- http://w3id.org/trajecto/poi#POICategory -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#POICategory">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract"/>
        <rdfs:comment xml:lang="en">A category or classification of points of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/poi"/>
        <rdfs:label xml:lang="en">POI Category</rdfs:label>
        <skos:definition xml:lang="en">A classification system for points of interest based on their primary characteristics and function.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/poi#POIFunction -->


    <owl:Class rdf:about="http://w3id.org/trajecto/poi#POIFunction">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract"/>
