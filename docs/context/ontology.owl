<?xml version="1.0"?>
<rdf:RDF xmlns="http://w3id.org/trajecto/context#"
     xml:base="http://w3id.org/trajecto/context"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://w3id.org/trajecto/context">
        <owl:versionIRI rdf:resource="http://w3id.org/trajecto/context/1.1.0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-09</terms:created>
        <terms:creator>Konstantinos Kotis</terms:creator>
        <terms:creator>Sotirios Angelis</terms:creator>
        <terms:description xml:lang="en">This module extends the trajecto ontology with universal contextual dimensions applicable across different movement domains.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:modified>
        <terms:publisher>i-Lab, Department of Cultural Technology and Communication, University of the Aegean</terms:publisher>
        <terms:title xml:lang="en">Trajecto Context Module</terms:title>
        <vann:preferredNamespacePrefix>context</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://w3id.org/trajecto/context#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">trajecto-context</rdfs:label>
        <owl:priorVersion rdf:resource="http://w3id.org/trajecto/context/1.0"/>
        <owl:versionInfo>1.1.0</owl:versionInfo>
    </owl:Ontology>
    


