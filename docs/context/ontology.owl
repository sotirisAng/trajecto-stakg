    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto/context#hasConstraint -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/context#hasConstraint">
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/context#Constraint"/>
        <rdfs:comment xml:lang="en">Associates a trajectory with constraints that limit or influence movement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">has constraint</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/context#hasEnvironmentalContext -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/context#hasEnvironmentalContext">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/context#hasMovementContext"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/context#EnvironmentalContext"/>
        <rdfs:comment xml:lang="en">Associates a trajectory with its environmental context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">has environmental context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/context#hasExternalFactor -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/context#hasExternalFactor">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/context#ExternalFactor"/>
        <rdfs:comment xml:lang="en">Associates a trajectory with external factors that influence it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">has external factor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/context#hasMovementContext -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/context#hasMovementContext">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/context#MovementContext"/>
        <rdfs:comment xml:lang="en">Associates a trajectory with its contextual dimensions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">has movement context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/context#hasRoutineContext -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/context#hasRoutineContext">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/context#hasMovementContext"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/context#RoutineContext"/>
        <rdfs:comment xml:lang="en">Associates a trajectory with its routine context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">has routine context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/context#hasSocialContext -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/context#hasSocialContext">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/context#hasMovementContext"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/context#SocialContext"/>
        <rdfs:comment xml:lang="en">Associates a trajectory with its social context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">has social context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/context#hasTemporalContext -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/context#hasTemporalContext">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/context#hasMovementContext"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/context#TemporalContext"/>
        <rdfs:comment xml:lang="en">Associates a trajectory with its temporal context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">has temporal context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/context#influencedByCondition -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/context#influencedByCondition">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/context#hasExternalFactor"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/context#EnvironmentalCondition"/>
        <rdfs:comment xml:lang="en">Indicates that a trajectory is influenced by specific environmental conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">influenced by condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/context#influencedByEvent -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/context#influencedByEvent">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/context#hasExternalFactor"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto#EventOfInterest"/>
        <rdfs:comment xml:lang="en">Indicates that a trajectory is influenced by a specific event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">influenced by event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/context#influencedByPolicy -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/context#influencedByPolicy">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/context#hasExternalFactor"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/context#Policy"/>
        <rdfs:comment xml:lang="en">Indicates that a trajectory is influenced by specific policies or regulations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">influenced by policy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/context#influencedByRecommendation -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/context#influencedByRecommendation">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/context#hasExternalFactor"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/context#Recommendation"/>
        <rdfs:comment xml:lang="en">Indicates that a trajectory is influenced by recommendations from systems or people.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">influenced by recommendation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith -->


    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto/context#hasFrequency -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/context#hasFrequency">
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Describes how often a particular trajectory pattern occurs (e.g., daily, weekly, monthly).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">has frequency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/context#hasPaceVariation -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/context#hasPaceVariation">
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">A numerical value indicating how much the pace varies during a trajectory.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">has pace variation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/context#hasPathComplexity -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/context#hasPathComplexity">
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">A numerical value indicating the complexity of a trajectory path.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">has path complexity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/context#hasPredictability -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/context#hasPredictability">
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">A numerical value indicating how predictable a trajectory is (0.0 to 1.0).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">has predictability</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto#EventOfInterest -->


    <owl:Class rdf:about="http://w3id.org/trajecto#EventOfInterest"/>
    


    <!-- http://w3id.org/trajecto/context#AccessPolicy -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#AccessPolicy">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#Policy"/>
        <rdfs:comment xml:lang="en">Policies regarding access to spaces that influence movement patterns.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Access Policy</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#AccessibilityRequirement -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#AccessibilityRequirement">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#MobilityConcern"/>
        <rdfs:comment xml:lang="en">Requirements for accessibility that affect movement patterns.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Accessibility Requirement</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#Afternoon -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#Afternoon">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#TimeOfDay"/>
        <rdfs:comment xml:lang="en">Afternoon time period.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Afternoon</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#AmbientCondition -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#AmbientCondition">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#EnvironmentalCondition"/>
        <rdfs:comment xml:lang="en">Ambient conditions (lighting, noise, temperature) that influence movement patterns.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Ambient Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#Barrier -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#Barrier">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#PhysicalConstraint"/>
        <rdfs:comment xml:lang="en">Physical barriers that prevent or restrict movement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Barrier</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#Constraint -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#Constraint">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Situation"/>
        <rdfs:comment xml:lang="en">Limitations or restrictions that affect movement patterns.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Constraint</rdfs:label>
        <skos:definition xml:lang="en">A limiting factor that restricts or influences the possible movement patterns within a trajectory.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#Crowding -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#Crowding">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#SocialPresence"/>
        <rdfs:comment xml:lang="en">High density of people that influences movement patterns.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Crowding</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#Deadline -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#Deadline">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#TemporalConstraint"/>
        <rdfs:comment xml:lang="en">Time deadlines that affect movement patterns.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Deadline</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#EnvironmentalCondition -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#EnvironmentalCondition">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#ExternalFactor"/>
        <rdfs:comment xml:lang="en">Environmental conditions that influence movement patterns.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Environmental Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#EnvironmentalContext -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#EnvironmentalContext">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#MovementContext"/>
        <rdfs:comment xml:lang="en">The environmental aspects that influence or characterize movement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Environmental Context</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#Evening -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#Evening">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#TimeOfDay"/>
        <rdfs:comment xml:lang="en">Evening time period.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Evening</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#EventPeriod -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#EventPeriod">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#SpecialPeriod"/>
        <rdfs:comment xml:lang="en">Periods during special events that influence movement patterns.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Event Period</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#ExternalFactor -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#ExternalFactor">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Situation"/>
        <rdfs:comment xml:lang="en">External elements that influence movement patterns.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">External Factor</rdfs:label>
        <skos:definition xml:lang="en">Any external circumstance, condition, or situation that impacts or influences movement behavior.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#Fall -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#Fall">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#Season"/>
        <rdfs:comment xml:lang="en">Fall/Autumn season.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Fall</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#Family -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#Family">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#SocialContext"/>
        <rdfs:comment xml:lang="en">Movement by a family group.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Family</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#Forced -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#Forced">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#RoutineContext"/>
        <rdfs:comment xml:lang="en">Movement necessitated by emergency or obligation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/context"/>
        <rdfs:label xml:lang="en">Forced</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/context#Habitual -->


    <owl:Class rdf:about="http://w3id.org/trajecto/context#Habitual">
