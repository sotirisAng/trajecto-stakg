    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#TemporalAnomaly -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#TemporalAnomaly">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract"/>
        <rdfs:comment xml:lang="en">Detected anomalies in temporal dwell patterns.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Temporal Anomaly</rdfs:label>
        <skos:definition xml:lang="en">A deviation from expected temporal patterns in dwell behavior.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#TemporalComparison -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#TemporalComparison">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/temporal-dwell#ComparativeDwellMetrics"/>
        <rdfs:comment xml:lang="en">Comparison of dwell metrics across different time periods.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Temporal Comparison</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#TemporalDwellContext -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#TemporalDwellContext">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#MovementContext"/>
        <rdfs:comment xml:lang="en">Temporal context specifically related to dwell behavior.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Temporal Dwell Context</rdfs:label>
        <skos:definition xml:lang="en">Contextual information that describes the temporal circumstances and patterns associated with dwell events.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#TemporalDwellPattern -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#TemporalDwellPattern">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/patterns#BehavioralPattern"/>
        <rdfs:comment xml:lang="en">Patterns in dwelling behavior over temporal dimensions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Temporal Dwell Pattern</rdfs:label>
        <skos:definition xml:lang="en">Recurring patterns or regularities in dwell behavior across different temporal contexts.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#TimeSlot -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#TimeSlot">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/temporal-dwell#TemporalDwellContext"/>
        <rdfs:comment xml:lang="en">A defined time slot or period for temporal analysis.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Time Slot</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#UnusualTimingAnomaly -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#UnusualTimingAnomaly">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/temporal-dwell#TemporalAnomaly"/>
        <rdfs:comment xml:lang="en">Dwell events occurring at unusual times.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Unusual Timing Anomaly</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#VisitorTypeComparison -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#VisitorTypeComparison">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/temporal-dwell#ComparativeDwellMetrics"/>
        <rdfs:comment xml:lang="en">Comparison of dwell metrics across different visitor types.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Visitor Type Comparison</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#VolatileTrend -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#VolatileTrend">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellTrend"/>
        <rdfs:comment xml:lang="en">Highly variable, unpredictable dwell behavior.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Volatile Trend</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#WeekdayDwelling -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#WeekdayDwelling">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#Weekday"/>
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/temporal-dwell#TemporalDwellContext"/>
        <rdfs:comment xml:lang="en">Dwell activity occurring on weekdays.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Weekday Dwelling</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#WeekendDwelling -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#WeekendDwelling">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/context#Weekend"/>
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/temporal-dwell#TemporalDwellContext"/>
        <rdfs:comment xml:lang="en">Dwell activity occurring on weekends.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Weekend Dwelling</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#WeeklyDwellPattern -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#WeeklyDwellPattern">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/temporal-dwell#TemporalDwellPattern"/>
        <rdfs:comment xml:lang="en">Dwell patterns that repeat on a weekly basis.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Weekly Dwell Pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#WorkingHours -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#WorkingHours">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/temporal-dwell#ActivityPeriod"/>
        <rdfs:comment xml:lang="en">Standard working hours period (typically 9 AM - 5 PM on weekdays).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Working Hours</rdfs:label>
    </owl:Class>
    


