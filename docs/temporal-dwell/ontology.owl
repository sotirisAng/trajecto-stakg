    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto#hasPointOfInterest -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto#hasPointOfInterest"/>
    


    <!-- http://w3id.org/trajecto/context#hasMovementContext -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/context#hasMovementContext"/>
    


    <!-- http://w3id.org/trajecto/context#hasTemporalContext -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/context#hasTemporalContext"/>
    


    <!-- http://w3id.org/trajecto/patterns#exhibitsPattern -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/patterns#exhibitsPattern"/>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#dwellsAt -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#dwellsAt">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto#hasPointOfInterest"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:comment xml:lang="en">Specifies the point of interest where dwelling occurs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">dwells at</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#followedBy -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#followedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:comment xml:lang="en">Indicates temporal sequence between dwell events.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">followed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasActivityPeriod -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasActivityPeriod">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/temporal-dwell#hasTemporalDwellContext"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/temporal-dwell#ActivityPeriod"/>
        <rdfs:comment xml:lang="en">Associates a dwell event with the type of activity period it occurs in.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has activity period</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasComparativeDwellMetrics -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasComparativeDwellMetrics">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/temporal-dwell#ComparativeDwellMetrics"/>
        <rdfs:comment xml:lang="en">Associates a POI with comparative dwell time metrics.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has comparative dwell metrics</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasDwellAnalytics -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasDwellAnalytics">
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellAnalytics"/>
        <rdfs:comment xml:lang="en">Associates a trajectory with its comprehensive dwell analytics.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has dwell analytics</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasDwellClassification -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasDwellClassification">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellClassification"/>
        <rdfs:comment xml:lang="en">Classifies a dwell event based on duration and behavioral characteristics.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has dwell classification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasDwellDuration -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasDwellDuration">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellDuration"/>
        <rdfs:comment xml:lang="en">Associates a dwell event with its duration measurement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has dwell duration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasDwellEvent -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasDwellEvent">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:comment xml:lang="en">Associates a trajectory part with a dwell event that occurred there.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has dwell event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasSeasonalContext -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasSeasonalContext">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/context#hasTemporalContext"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/context#Season"/>
        <rdfs:comment xml:lang="en">Associates a dwell event with seasonal context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has seasonal context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasTemporalAnomaly -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasTemporalAnomaly">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/temporal-dwell#TemporalAnomaly"/>
        <rdfs:comment xml:lang="en">Associates a dwell event with detected temporal anomalies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has temporal anomaly</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasTemporalDwellContext -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasTemporalDwellContext">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/context#hasMovementContext"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/temporal-dwell#TemporalDwellContext"/>
        <rdfs:comment xml:lang="en">Associates a dwell event with its temporal context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has temporal dwell context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasTemporalPattern -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasTemporalPattern">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/patterns#exhibitsPattern"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/temporal-dwell#TemporalDwellPattern"/>
        <rdfs:comment xml:lang="en">Associates a dwell event with temporal patterns it exhibits.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has temporal pattern</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasTimeOfDay -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasTimeOfDay">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/context#hasTemporalContext"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/context#TimeOfDay"/>
        <rdfs:comment xml:lang="en">Associates a dwell event with its time of day classification.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has time of day</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasWeekdayClassification -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasWeekdayClassification">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/context#hasTemporalContext"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/context#Weekpart"/>
        <rdfs:comment xml:lang="en">Associates a dwell event with weekday vs weekend classification.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has weekday classification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#occursDuringTimeSlot -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#occursDuringTimeSlot">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/temporal-dwell#TimeSlot"/>
        <rdfs:comment xml:lang="en">Indicates the time slot during which the dwell event occurs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">occurs during time slot</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith -->


    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto/temporal-dwell#averageDwellTime -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#averageDwellTime">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellAnalytics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Average dwell time in minutes for analytical aggregation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">average dwell time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#dwellDurationMinutes -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#dwellDurationMinutes">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellDuration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Duration of dwelling in minutes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">dwell duration minutes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#dwellDurationSeconds -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#dwellDurationSeconds">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellDuration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Duration of dwelling in seconds for precise measurement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">dwell duration seconds</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#dwellEndTime -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#dwellEndTime">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">End timestamp of the dwell event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">dwell end time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#dwellFrequency -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#dwellFrequency">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellAnalytics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Number of dwell events in the analysis period.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">dwell frequency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#dwellStartTime -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#dwellStartTime">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Start timestamp of the dwell event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">dwell start time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#dwellVariability -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#dwellVariability">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellAnalytics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Standard deviation of dwell times indicating variability.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">dwell variability</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#engagementScore -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#engagementScore">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Calculated engagement score (0.0-1.0) based on dwell duration and context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">engagement score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasDayOfWeek -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasDayOfWeek">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
                    <rdf:Description rdf:about="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Day of week (1=Monday, 7=Sunday) when dwell event occurs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has day of week</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasHour -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasHour">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
                    <rdf:Description rdf:about="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Hour of day (0-23) when dwell event starts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has hour</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasMonth -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasMonth">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
                    <rdf:Description rdf:about="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Month of year (1-12) when dwell event occurs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has month</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#hasYear -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#hasYear">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
                    <rdf:Description rdf:about="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Year when dwell event occurs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">has year</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#isHoliday -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#isHoliday">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/trajecto/temporal-dwell#DwellEvent"/>
                    <rdf:Description rdf:about="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean indicating if the dwell event occurs on a holiday.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">is holiday</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#temporalAnomalyScore -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#temporalAnomalyScore">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#TemporalAnomaly"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Score indicating degree of temporal anomaly (higher = more anomalous).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">temporal anomaly score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#totalDwellTime -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/temporal-dwell#totalDwellTime">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellAnalytics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Total cumulative dwell time in minutes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">total dwell time</rdfs:label>
    </owl:DatatypeProperty>
    


