<?xml version="1.0"?>
<rdf:RDF xmlns="http://w3id.org/trajecto/temporal-dwell#"
     xml:base="http://w3id.org/trajecto/temporal-dwell"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://w3id.org/trajecto/temporal-dwell">
        <owl:versionIRI rdf:resource="http://w3id.org/trajecto/temporal-dwell/1.1.0"/>
        <owl:imports rdf:resource="http://w3id.org/trajecto/context"/>
        <owl:imports rdf:resource="http://w3id.org/trajecto/patterns"/>
        <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-30</terms:created>
        <terms:creator>Konstantinos Kotis</terms:creator>
        <terms:creator>Sotirios Angelis</terms:creator>
        <terms:description xml:lang="en">This module extends the trajecto ontology with comprehensive temporal context and dwell time analytics capabilities, integrating temporal patterns with spatial behavior analysis.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:modified>
        <terms:publisher>i-Lab, Department of Cultural Technology and Communication, University of the Aegean</terms:publisher>
        <terms:title xml:lang="en">Trajecto Temporal-Dwell Module</terms:title>
        <vann:preferredNamespacePrefix>tdwell</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://w3id.org/trajecto/temporal-dwell#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">trajecto-temporal-dwell</rdfs:label>
        <owl:priorVersion rdf:resource="http://w3id.org/trajecto/temporal-dwell/1.0"/>
        <owl:versionInfo>1.1.0</owl:versionInfo>
    </owl:Ontology>
    


