        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellClassification"/>
        <rdfs:comment xml:lang="en">Very short dwell events (typically less than 5 minutes).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Brief Dwell</rdfs:label>
    </owl:Class>
    


