        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Decreasing Trend</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#DurationAnomaly -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#DurationAnomaly">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/temporal-dwell#TemporalAnomaly"/>
        <rdfs:comment xml:lang="en">Dwell events with unusually long or short durations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Duration Anomaly</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#DwellAnalytics -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#DwellAnalytics">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract"/>
        <rdfs:comment xml:lang="en">Comprehensive analytics and metrics derived from dwell events.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Dwell Analytics</rdfs:label>
        <skos:definition xml:lang="en">A collection of analytical measures, statistics, and insights derived from dwell behavior patterns.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#DwellClassification -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#DwellClassification">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract"/>
        <rdfs:comment xml:lang="en">Classification of dwell events based on duration and behavioral characteristics.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Dwell Classification</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#DwellDuration -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#DwellDuration">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#TimeInterval"/>
        <rdfs:comment xml:lang="en">Duration of time spent dwelling at a location.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Dwell Duration</rdfs:label>
        <skos:definition xml:lang="en">A measured time interval representing the duration of a dwell event.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#DwellEvent -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#DwellEvent">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto#Interaction"/>
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/poi#POIInteraction"/>
        <rdfs:comment xml:lang="en">An event representing time spent dwelling at a specific location or point of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Dwell Event</rdfs:label>
        <skos:definition xml:lang="en">A measurable period of time during which a moving entity remains stationary or moves slowly within a defined area, typically associated with engagement at a point of interest.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/temporal-dwell#DwellTrend -->


    <owl:Class rdf:about="http://w3id.org/trajecto/temporal-dwell#DwellTrend">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/temporal-dwell#DwellAnalytics"/>
        <rdfs:comment xml:lang="en">Trend analysis of dwell behavior over time.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/temporal-dwell"/>
        <rdfs:label xml:lang="en">Dwell Trend</rdfs:label>
    </owl:Class>
    


