        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Event classification: Concert, Exhibition, Conference, Festival, Sports, Theater, ReligiousService, Other.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/scheduled"/>
        <rdfs:label xml:lang="en">event category</rdfs:label>
    </owl:DatatypeProperty>
    


