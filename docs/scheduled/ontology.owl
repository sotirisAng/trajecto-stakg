        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Provenance tag: fixture, ticketmaster, eventbrite, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/scheduled"/>
        <rdfs:label xml:lang="en">external source</rdfs:label>
