    <owl:Ontology rdf:about="http://w3id.org/trajecto/scheduled">
        <owl:versionIRI rdf:resource="http://w3id.org/trajecto/scheduled/1.1.0"/>
        <owl:imports rdf:resource="http://w3id.org/trajecto/poi"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-22</terms:created>
        <terms:creator>Konstantinos Kotis</terms:creator>
        <terms:creator>Sotirios Angelis</terms:creator>
        <terms:description xml:lang="en">Externally scheduled events (concerts, conferences, exhibitions, matches, services) hosted at a POI for a finite time window. Event-gated POI categories are recommended only when such an event overlaps the trajectory.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:modified>
        <terms:publisher>i-Lab, Department of Cultural Technology and Communication, University of the Aegean</terms:publisher>
        <terms:title xml:lang="en">Trajecto Scheduled Events Module</terms:title>
        <vann:preferredNamespacePrefix>scheduled</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://w3id.org/trajecto/scheduled#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">trajecto-scheduled-events</rdfs:label>
        <owl:priorVersion rdf:resource="http://w3id.org/trajecto/scheduled/1.0"/>
        <owl:versionInfo>1.1.0</owl:versionInfo>
    </owl:Ontology>
    


