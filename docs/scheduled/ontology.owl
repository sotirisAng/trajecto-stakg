    <!-- http://w3id.org/trajecto/scheduled#endTime -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/scheduled#endTime">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/scheduled#ScheduledEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Event end (inclusive). Equal to startTime for instantaneous events.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/scheduled"/>
        <rdfs:label xml:lang="en">end time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/scheduled#eventCategory -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/scheduled#eventCategory">
