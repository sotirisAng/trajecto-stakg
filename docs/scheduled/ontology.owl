    <!-- http://w3id.org/trajecto/scheduled#ScheduledEvent -->


    <owl:Class rdf:about="http://w3id.org/trajecto/scheduled#ScheduledEvent">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event"/>
        <rdfs:comment xml:lang="en">A calendared event (concert, conference, exhibition, sports match, festival, religious service) hosted at a POI for a finite time window. Distinct from trajecto/events#TrajectoryEvent which models behavioral trajectory events.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/scheduled"/>
        <rdfs:label xml:lang="en">Scheduled Event</rdfs:label>
    </owl:Class>
    


