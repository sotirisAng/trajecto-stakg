        <rdfs:range rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:comment xml:lang="en">POI where the scheduled event takes place.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/scheduled"/>
        <rdfs:label xml:lang="en">hosted at</rdfs:label>
    </owl:ObjectProperty>
    


