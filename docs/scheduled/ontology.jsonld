    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-04-22"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Konstantinos Kotis"
  }, {
    "@value" : "Sotirios Angelis"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Externally scheduled events (concerts, conferences, exhibitions, matches, services) hosted at a POI for a finite time window. Event-gated POI categories are recommended only when such an event overlaps the trajectory."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-10-01"
