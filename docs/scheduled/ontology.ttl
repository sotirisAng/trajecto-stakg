#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://w3id.org/trajecto/scheduled#hostedAt
:hostedAt rdf:type owl:ObjectProperty ;
          rdfs:domain :ScheduledEvent ;
          rdfs:range <http://w3id.org/trajecto#PointOfInterest> ;
          rdfs:comment "POI where the scheduled event takes place."@en ;
          rdfs:isDefinedBy <http://w3id.org/trajecto/scheduled> ;
          rdfs:label "hosted at"@en .


#################################################################
#    Data properties
#################################################################

###  http://w3id.org/trajecto/scheduled#endTime
:endTime rdf:type owl:DatatypeProperty ;
         rdfs:domain :ScheduledEvent ;
         rdfs:range xsd:dateTime ;
         rdfs:comment "Event end (inclusive). Equal to startTime for instantaneous events."@en ;
         rdfs:isDefinedBy <http://w3id.org/trajecto/scheduled> ;
         rdfs:label "end time"@en .


###  http://w3id.org/trajecto/scheduled#eventCategory
:eventCategory rdf:type owl:DatatypeProperty ;
               rdfs:domain :ScheduledEvent ;
               rdfs:range xsd:string ;
               rdfs:comment "Event classification: Concert, Exhibition, Conference, Festival, Sports, Theater, ReligiousService, Other."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/scheduled> ;
               rdfs:label "event category"@en .


###  http://w3id.org/trajecto/scheduled#externalId
:externalId rdf:type owl:DatatypeProperty ;
            rdfs:domain :ScheduledEvent ;
            rdfs:range xsd:string ;
            rdfs:comment "Identifier assigned by the source system; used for idempotent ingestion."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/scheduled> ;
            rdfs:label "external id"@en .


###  http://w3id.org/trajecto/scheduled#externalSource
:externalSource rdf:type owl:DatatypeProperty ;
                rdfs:domain :ScheduledEvent ;
                rdfs:range xsd:string ;
                rdfs:comment "Provenance tag: fixture, ticketmaster, eventbrite, etc."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/scheduled> ;
                rdfs:label "external source"@en .


###  http://w3id.org/trajecto/scheduled#startTime
:startTime rdf:type owl:DatatypeProperty ;
           rdfs:domain :ScheduledEvent ;
           rdfs:range xsd:dateTime ;
           rdfs:comment "Event start (inclusive)."@en ;
           rdfs:isDefinedBy <http://w3id.org/trajecto/scheduled> ;
           rdfs:label "start time"@en .


#################################################################
#    Classes
#################################################################

###  http://w3id.org/trajecto#PointOfInterest
<http://w3id.org/trajecto#PointOfInterest> rdf:type owl:Class .


###  http://w3id.org/trajecto/scheduled#ScheduledEvent
:ScheduledEvent rdf:type owl:Class ;
                rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event> ;
                rdfs:comment "A calendared event (concert, conference, exhibition, sports match, festival, religious service) hosted at a POI for a finite time window. Distinct from trajecto/events#TrajectoryEvent which models behavioral trajectory events."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/scheduled> ;
                rdfs:label "Scheduled Event"@en .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event> rdf:type owl:Class .


