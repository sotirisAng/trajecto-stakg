@base <http://w3id.org/trajecto/scheduled#> .

<http://w3id.org/trajecto/scheduled> rdf:type owl:Ontology ;
                                      owl:versionIRI <http://w3id.org/trajecto/scheduled/1.1.0> ;
                                      owl:imports <http://w3id.org/trajecto/poi> ;
                                      <http://purl.org/dc/terms/created> "2026-04-22"^^xsd:date ;
                                      <http://purl.org/dc/terms/creator> "Konstantinos Kotis" ,
                                                                         "Sotirios Angelis" ;
                                      <http://purl.org/dc/terms/description> "Externally scheduled events (concerts, conferences, exhibitions, matches, services) hosted at a POI for a finite time window. Event-gated POI categories are recommended only when such an event overlaps the trajectory."@en ;
                                      <http://purl.org/dc/terms/issued> "2026-10-01"^^xsd:date ;
                                      <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/> ;
                                      <http://purl.org/dc/terms/modified> "2026-10-01"^^xsd:date ;
                                      <http://purl.org/dc/terms/publisher> "i-Lab, Department of Cultural Technology and Communication, University of the Aegean" ;
                                      <http://purl.org/dc/terms/title> "Trajecto Scheduled Events Module"@en ;
                                      <http://purl.org/vocab/vann/preferredNamespacePrefix> "scheduled" ;
                                      <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/trajecto/scheduled#" ;
                                      rdfs:label "trajecto-scheduled-events"@en ;
                                      owl:priorVersion <http://w3id.org/trajecto/scheduled/1.0> ;
                                      owl:versionInfo "1.1.0" .

