@prefix : <http://w3id.org/trajecto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://w3id.org/trajecto#> .

<http://w3id.org/trajecto> rdf:type owl:Ontology ;
                            owl:versionIRI <http://w3id.org/trajecto/1.1.0> ;
                            owl:imports <http://w3id.org/trajecto/context> ,
                                        <http://w3id.org/trajecto/events> ,
                                        <http://w3id.org/trajecto/patterns> ,
                                        <http://w3id.org/trajecto/poi> ,
                                        <http://w3id.org/trajecto/profiles> ,
                                        <http://w3id.org/trajecto/purpose> ,
                                        <http://w3id.org/trajecto/scheduled> ,
                                        <http://w3id.org/trajecto/spaces> ,
                                        <http://w3id.org/trajecto/spatial> ,
                                        <http://w3id.org/trajecto/temporal-dwell> ,
                                        <http://w3id.org/trajecto/user> ,
                                        <http://w3id.org/trajecto/purpose/skos> ,
                                        <http://www.datacron-project.eu/datAcron#> ;
                            <http://purl.org/dc/terms/bibliographicCitation> "Angelis, S. (2026). Semantic Trajectory Analytics and Recommender Systems: Engineering Semantic Trajectories as Knowledge Graphs. Doctoral dissertation, University of the Aegean." ;
                            <http://purl.org/dc/terms/created> "2025-05-09"^^xsd:date ;
                            <http://purl.org/dc/terms/creator> "Konstantinos Kotis" ,
                                                               "Sotirios Angelis" ;
                            <http://purl.org/dc/terms/description> "Trajecto is a modular ontology for semantic trajectories: GPS-derived movement of people, the points of interest they interact with, the patterns, purposes and contexts of that movement, and the user profiles learned from it. The core module defines the moving person, entities of interest and interactions, and reuses the datAcron trajectory model (Trajectory, TrajectoryPart, RawPosition, MovingObject) and DUL. It imports the other eleven modules and the purpose concept scheme, and is the entry point to the whole ontology."@en ;
                            <http://purl.org/dc/terms/issued> "2026-10-01"^^xsd:date ;
                            <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/> ;
                            <http://purl.org/dc/terms/modified> "2026-10-01"^^xsd:date ;
                            <http://purl.org/dc/terms/publisher> "i-Lab, Department of Cultural Technology and Communication, University of the Aegean" ;
                            <http://purl.org/dc/terms/title> "Trajecto Ontology"@en ;
                            <http://purl.org/vocab/vann/preferredNamespacePrefix> "trajecto" ;
                            <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/trajecto#" ;
                            rdfs:label "trajecto"@en ;
                            owl:priorVersion <http://w3id.org/trajecto/0.9> ;
                            owl:versionInfo "1.1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/bibliographicCitation
<http://purl.org/dc/terms/bibliographicCitation> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://w3id.org/trajecto#clusters
:clusters rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasPart> ;
          rdfs:domain <http://www.datacron-project.eu/datAcron#TrajectoryCluster> ;
          rdfs:range <http://www.datacron-project.eu/datAcron#Trajectory> ;
          rdfs:comment "Relates a trajectory cluster to a trajectory it groups."@en ;
          rdfs:isDefinedBy <http://w3id.org/trajecto> ;
          rdfs:label "clusters"@en .


###  http://w3id.org/trajecto#encloses
:encloses rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf <http://www.datacron-project.eu/datAcron#hasPart> ;
          rdf:type owl:InverseFunctionalProperty ;
          rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
          rdfs:range <http://www.datacron-project.eu/datAcron#Segment> ;
          rdfs:comment "Relates a trajectory to a segment that is part of it."@en ;
          rdfs:isDefinedBy <http://w3id.org/trajecto> ;
          rdfs:label "encloses"@en .


###  http://w3id.org/trajecto#formsTrajectory
:formsTrajectory rdf:type owl:ObjectProperty ;
                 owl:inverseOf :isTrajectoryFormedBy ;
                 rdfs:domain <http://www.datacron-project.eu/datAcron#MovingObject> ;
                 rdfs:range <http://www.datacron-project.eu/datAcron#Trajectory> ;
                 rdfs:comment "Specifies the moving object which forms a trajectory"@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                 rdfs:label "forms trajectory"@en .


###  http://w3id.org/trajecto#happensDuringEventOfInterest
:happensDuringEventOfInterest rdf:type owl:ObjectProperty ;
                              owl:equivalentProperty :happensdDuringEventOfInterest ;
                              rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                              rdfs:domain <http://www.datacron-project.eu/datAcron#TrajectoryPart> ;
                              rdfs:range :EventOfInterest ;
                              rdfs:comment "Relates a trajectory part to an event of interest that takes place while it is recorded."@en ;
                              rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                              rdfs:label "happens during event of interest"@en .


###  http://w3id.org/trajecto#happensdDuringEventOfInterest
:happensdDuringEventOfInterest rdf:type owl:ObjectProperty ;
                               rdfs:comment "Deprecated since 1.1.0: renamed to happensDuringEventOfInterest."@en ;
                               rdfs:label "happensdDuringEventOfInterest (deprecated)"@en ;
                               owl:deprecated "true"^^xsd:boolean .


###  http://w3id.org/trajecto#hasCentralityRole
:hasCentralityRole rdf:type owl:ObjectProperty ;
                   rdfs:domain :PointOfInterest ;
                   rdfs:range :CentralityRole ;
                   rdfs:comment "Relates a POI to its structural role."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                   rdfs:label "has centrality role"@en .


###  http://w3id.org/trajecto#hasEngagementLevel
:hasEngagementLevel rdf:type owl:ObjectProperty ;
                    rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                    rdfs:range :EngagementLevel ;
                    rdfs:comment "Relates a trajectory to its engagement level. The engagement classes of the profiles module are defined over it."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                    rdfs:label "has engagement level"@en .


###  http://w3id.org/trajecto#hasEvent
:hasEvent rdf:type owl:ObjectProperty ;
          rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
          rdfs:range <http://w3id.org/trajecto/events#TrajectoryEvent> ;
          rdfs:comment "Links a trajectory to a behavioral event detected within its position sequence."@en ;
          rdfs:isDefinedBy <http://w3id.org/trajecto> ;
          rdfs:label "has event"@en .


###  http://w3id.org/trajecto#hasInteraction
:hasInteraction rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                rdfs:domain <http://www.datacron-project.eu/datAcron#RawPosition> ;
                rdfs:range <http://w3id.org/trajecto/poi#POIInteraction> ;
                rdfs:comment "Relates a raw position to a POI interaction that takes place at it."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                rdfs:label "has interaction"@en .


###  http://w3id.org/trajecto#hasInterest
:hasInterest rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
             rdfs:domain :EntityOfInterest ;
             rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
             rdfs:comment "Correlates an entity of interest with the type of interest that it presents."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto> ;
             rdfs:label "has interest"@en .


###  http://w3id.org/trajecto#hasJaccardCategorySimilarity
:hasJaccardCategorySimilarity rdf:type owl:ObjectProperty ;
                              rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                              rdfs:range :TrajectorySimilarity ;
                              rdfs:comment "Jaccard similarity of the POI categories two trajectories interact with."@en ;
                              rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                              rdfs:label "has category similarity"@en .


###  http://w3id.org/trajecto#hasModeOfTransportation
:hasModeOfTransportation rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                         rdfs:domain <http://www.datacron-project.eu/datAcron#TrajectoryPart> ;
                         rdfs:range :ModeOfTransportation ;
                         rdfs:comment "Relates a trajectory part to the mode of transportation used for it."@en ;
                         rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                         rdfs:label "has mode of transportation"@en .


###  http://w3id.org/trajecto#hasNavigationMatch
:hasNavigationMatch rdf:type owl:ObjectProperty ;
                    rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                    rdfs:range :TrajectorySimilarity ;
                    rdfs:comment "Two trajectories share a navigation pattern."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                    rdfs:label "has navigation match"@en .


###  http://w3id.org/trajecto#hasNavigationStyle
:hasNavigationStyle rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                    rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                    rdfs:range :NavigationStyle ;
                    rdfs:comment "Deprecated: use patterns:exhibitsPattern."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                    rdfs:label "has navigation style"@en ;
                    owl:deprecated "true"^^xsd:boolean .


###  http://w3id.org/trajecto#hasNextPosition
:hasNextPosition rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                 owl:inverseOf :hasPreviousPosition ;
                 rdf:type owl:TransitiveProperty ;
                 rdfs:domain <http://www.datacron-project.eu/datAcron#RawPosition> ;
                 rdfs:range <http://www.datacron-project.eu/datAcron#RawPosition> ;
                 rdfs:comment "Relates a raw position to a later position of the same trajectory. Asserted between consecutive positions; as the property is transitive, a reasoner extends it to every later position."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                 rdfs:label "has next position"@en .


###  http://w3id.org/trajecto#hasOccurredEvent
:hasOccurredEvent rdf:type owl:ObjectProperty ;
                  owl:inverseOf <http://www.datacron-project.eu/datAcron#occurs> ;
                  rdfs:domain <http://www.datacron-project.eu/datAcron#TrajectoryPart> ;
                  rdfs:range <http://www.datacron-project.eu/datAcron#Event> ;
                  rdfs:comment "Relates a trajectory part to an event that occurred during it."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                  rdfs:label "has occurred event"@en .


###  http://w3id.org/trajecto#hasPointOfInterest
:hasPointOfInterest rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                    rdfs:domain <http://www.datacron-project.eu/datAcron#TrajectoryPart> ;
                    rdfs:range :PointOfInterest ;
                    rdfs:comment "Relates a trajectory part to a point of interest associated with it."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                    rdfs:label "has point of interest"@en .


###  http://w3id.org/trajecto#hasPreviousPosition
:hasPreviousPosition rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                     rdf:type owl:TransitiveProperty ;
                     rdfs:domain <http://www.datacron-project.eu/datAcron#RawPosition> ;
                     rdfs:range <http://www.datacron-project.eu/datAcron#RawPosition> ;
                     rdfs:comment "Inverse of hasNextPosition: relates a raw position to an earlier position of the same trajectory."@en ;
                     rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                     rdfs:label "has previous position"@en .


###  http://w3id.org/trajecto#hasPurpose
:hasPurpose rdf:type owl:ObjectProperty ;
            rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
            rdfs:range :PurposeOfMovement ;
            rdfs:comment "Relates a trajectory to its purpose, a concept of the purpose concept scheme."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto> ;
            rdfs:label "has purpose"@en .


###  http://w3id.org/trajecto#hasPurposeMatch
:hasPurposeMatch rdf:type owl:ObjectProperty ;
                 rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                 rdfs:range :TrajectorySimilarity ;
                 rdfs:comment "Two trajectories share a purpose."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                 rdfs:label "has purpose match"@en .


###  http://w3id.org/trajecto#hasRegionOfInterest
:hasRegionOfInterest rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                     rdfs:domain <http://www.datacron-project.eu/datAcron#TrajectoryPart> ;
                     rdfs:range :RegionOfInterest ;
                     rdfs:comment "Relates a trajectory part to a region of interest it passes through."@en ;
                     rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                     rdfs:label "has region of interest"@en .


###  http://w3id.org/trajecto#hasStop
:hasStop rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf <http://www.datacron-project.eu/datAcron#comprises> ;
         rdfs:domain <http://www.datacron-project.eu/datAcron#TrajectoryPart> ;
         rdfs:range :Stop ;
         rdfs:comment "Relates a trajectory part to a stop it comprises."@en ;
         rdfs:isDefinedBy <http://w3id.org/trajecto> ;
         rdfs:label "has stop"@en .


###  http://w3id.org/trajecto#hasTemporalOverlap
:hasTemporalOverlap rdf:type owl:ObjectProperty ;
                    rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                    rdfs:range :TrajectorySimilarity ;
                    rdfs:comment "Jaccard similarity of the temporal contexts of two trajectories."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                    rdfs:label "has temporal overlap"@en .


###  http://w3id.org/trajecto#hasTrajectory
:hasTrajectory rdf:type owl:ObjectProperty ;
               owl:inverseOf :trajectoryRefersTo ;
               rdf:type owl:InverseFunctionalProperty ;
               rdfs:domain <http://www.datacron-project.eu/datAcron#MovingObject> ;
               rdfs:range <http://www.datacron-project.eu/datAcron#Trajectory> ;
               rdfs:comment "Deprecated duplicate of formsTrajectory: relates a moving object to a trajectory it forms."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto> ;
               rdfs:label "has trajectory"@en ;
               owl:deprecated "true"^^xsd:boolean .


###  http://w3id.org/trajecto#includesInteraction
:includesInteraction rdf:type owl:ObjectProperty ;
                     rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                     rdfs:range <http://w3id.org/trajecto/poi#POIInteraction> ;
                     rdfs:comment "Relates a trajectory to the POI interactions that occur at its positions. A shortcut for the chain from a trajectory to its positions to their interactions, so that classes over interactions can be defined on trajectories."@en ;
                     rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                     rdfs:label "includes interaction"@en .


###  http://w3id.org/trajecto#isTrajectoryFormedBy
:isTrajectoryFormedBy rdf:type owl:ObjectProperty ;
                      rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                      rdfs:range <http://www.datacron-project.eu/datAcron#MovingObject> ;
                      rdfs:comment "Inverse of formsTrajectory: relates a trajectory to the moving object that forms it."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                      rdfs:label "is trajectory formed by"@en .


###  http://w3id.org/trajecto#isWeatherConditionOf
:isWeatherConditionOf rdf:type owl:ObjectProperty ;
                      owl:inverseOf <http://www.datacron-project.eu/datAcron#hasWeatherCondition> ;
                      rdfs:comment "Inverse of datAcron:hasWeatherCondition."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                      rdfs:label "is weather condition of"@en .


###  http://w3id.org/trajecto#participatesIn
:participatesIn rdf:type owl:ObjectProperty ;
                rdfs:domain <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Agent> ;
                rdfs:range :Interaction ;
                rdfs:comment "Relates an agent to an interaction it takes part in."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                rdfs:label "participates in"@en .


###  http://w3id.org/trajecto#trajectoryRefersTo
:trajectoryRefersTo rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                    rdfs:range <http://www.datacron-project.eu/datAcron#MovingObject> ;
                    rdfs:comment "Deprecated duplicate of isTrajectoryFormedBy: relates a trajectory to its moving object."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                    rdfs:label "trajectory refers to"@en ;
                    owl:deprecated "true"^^xsd:boolean .


###  http://w3id.org/trajecto#withTrajectory
:withTrajectory rdf:type owl:ObjectProperty ;
                rdfs:domain :TrajectorySimilarity ;
                rdfs:range <http://www.datacron-project.eu/datAcron#Trajectory> ;
                rdfs:comment "The other trajectory of a trajectory similarity."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                rdfs:label "with trajectory"@en .


###  http://www.datacron-project.eu/datAcron#comprises
<http://www.datacron-project.eu/datAcron#comprises> rdf:type owl:ObjectProperty .


###  http://www.datacron-project.eu/datAcron#hasPart
<http://www.datacron-project.eu/datAcron#hasPart> rdf:type owl:ObjectProperty .


###  http://www.datacron-project.eu/datAcron#hasWeatherCondition
<http://www.datacron-project.eu/datAcron#hasWeatherCondition> rdf:type owl:ObjectProperty .


###  http://www.datacron-project.eu/datAcron#occurs
<http://www.datacron-project.eu/datAcron#occurs> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasPart
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasPart> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://w3id.org/trajecto#betweennessCentrality
:betweennessCentrality rdf:type owl:DatatypeProperty ;
                       rdfs:domain :PointOfInterest ;
                       rdfs:range xsd:float ;
                       rdfs:comment "Betweenness centrality of a POI in the POI flow graph."@en ;
                       rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                       rdfs:label "betweenness centrality"@en .


###  http://w3id.org/trajecto#communityId
:communityId rdf:type owl:DatatypeProperty ;
             rdfs:domain :PointOfInterest ;
             rdfs:range xsd:integer ;
             rdfs:comment "Identifier of the co-visitation community a POI belongs to."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto> ;
             rdfs:label "community ID"@en .


###  http://w3id.org/trajecto#externalDescription
:externalDescription rdf:type owl:DatatypeProperty ;
                     rdfs:domain :PointOfInterest ;
                     rdfs:comment "Description of the Wikidata entity a POI is linked to."@en ;
                     rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                     rdfs:label "external description"@en .


###  http://w3id.org/trajecto#externalLabel
:externalLabel rdf:type owl:DatatypeProperty ;
               rdfs:domain :PointOfInterest ;
               rdfs:comment "Label of the Wikidata entity a POI is linked to."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto> ;
               rdfs:label "external label"@en .


###  http://w3id.org/trajecto#floor
:floor rdf:type owl:DatatypeProperty ;
       rdfs:domain <http://www.datacron-project.eu/datAcron#Point> ;
       rdfs:range xsd:integer ;
       rdfs:comment "Floor number of a position, for indoor positioning."@en ;
       rdfs:isDefinedBy <http://w3id.org/trajecto> ;
       rdfs:label "floor"@en .


###  http://w3id.org/trajecto#hasAddress
:hasAddress rdf:type owl:DatatypeProperty ;
            rdfs:domain :RegionOfInterest ;
            rdfs:range xsd:string ;
            rdfs:comment "Postal address of a region of interest."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto> ;
            rdfs:label "has address"@en .


###  http://w3id.org/trajecto#hasEasting
:hasEasting rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://www.datacron-project.eu/datAcron#Point> ;
            rdfs:range xsd:float ;
            rdfs:comment "Easting (x) of a position in a projected or indoor coordinate reference system, in meters. Used instead of latitude where positions are planar, for example in indoor tracking."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto> ;
            rdfs:label "has easting"@en .


###  http://w3id.org/trajecto#hasImmersiveInteractionCount
:hasImmersiveInteractionCount rdf:type owl:DatatypeProperty ;
                              rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                              rdfs:range xsd:integer ;
                              rdfs:comment "Number of immersive interactions of a trajectory."@en ;
                              rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                              rdfs:label "has immersive interaction count"@en .


###  http://w3id.org/trajecto#hasMeaningfulInteractionCount
:hasMeaningfulInteractionCount rdf:type owl:DatatypeProperty ;
                               rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                               rdfs:range xsd:integer ;
                               rdfs:comment "Number of meaningful interactions of a trajectory."@en ;
                               rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                               rdfs:label "has meaningful interaction count"@en .


###  http://w3id.org/trajecto#hasNorthing
:hasNorthing rdf:type owl:DatatypeProperty ;
             rdfs:domain <http://www.datacron-project.eu/datAcron#Point> ;
             rdfs:range xsd:float ;
             rdfs:comment "Northing (y) of a position in a projected or indoor coordinate reference system, in meters. Used instead of longitude where positions are planar."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto> ;
             rdfs:label "has northing"@en .


###  http://w3id.org/trajecto#hasOSMType
:hasOSMType rdf:type owl:DatatypeProperty ;
            rdfs:domain :EntityOfInterest ;
            rdfs:range xsd:string ;
            rdfs:comment "The OpenStreetMap tag (key=value) that identifies the type of an entity of interest."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto> ;
            rdfs:label "has OSM type"@en .


###  http://w3id.org/trajecto#hasPOICount
:hasPOICount rdf:type owl:DatatypeProperty ;
             rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
             rdfs:range xsd:integer ;
             rdfs:comment "Number of distinct POIs a trajectory interacts with."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto> ;
             rdfs:label "has POI count"@en .


###  http://w3id.org/trajecto#hasPlaceID
:hasPlaceID rdf:type owl:DatatypeProperty ;
            rdfs:domain :RegionOfInterest ;
            rdfs:range xsd:string ;
            rdfs:comment "External identifier of a region of interest, such as an OpenStreetMap or geocoder place ID."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto> ;
            rdfs:label "has place ID"@en .


###  http://w3id.org/trajecto#hasPositionIndex
:hasPositionIndex rdf:type owl:DatatypeProperty ;
                  rdfs:domain <http://www.datacron-project.eu/datAcron#RawPosition> ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "Zero-based order of a raw position within its trajectory."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                  rdfs:label "has position index"@en .


###  http://w3id.org/trajecto#hasTotalDwellTime
:hasTotalDwellTime rdf:type owl:DatatypeProperty ;
                   rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                   rdfs:comment "Sum of the dwell times of the interactions of a trajectory, in seconds."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                   rdfs:label "has total dwell time"@en .


###  http://w3id.org/trajecto#hasUniqueCategoryCount
:hasUniqueCategoryCount rdf:type owl:DatatypeProperty ;
                        rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                        rdfs:range xsd:integer ;
                        rdfs:comment "Number of distinct POI categories a trajectory interacts with."@en ;
                        rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                        rdfs:label "has unique category count"@en .


###  http://w3id.org/trajecto#hasVelocity
:hasVelocity rdf:type owl:DatatypeProperty ;
             rdfs:domain <http://www.datacron-project.eu/datAcron#Geometry> ;
             rdfs:range xsd:double ;
             rdfs:comment "Velocity value attached to a geometry, as recorded by the source."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto> ;
             rdfs:label "has velocity"@en .


###  http://w3id.org/trajecto#pageRank
:pageRank rdf:type owl:DatatypeProperty ;
          rdfs:domain :PointOfInterest ;
          rdfs:range xsd:float ;
          rdfs:comment "PageRank of a POI in the POI flow graph."@en ;
          rdfs:isDefinedBy <http://w3id.org/trajecto> ;
          rdfs:label "PageRank"@en .


###  http://w3id.org/trajecto#similarityScore
:similarityScore rdf:type owl:DatatypeProperty ;
                 rdfs:domain :TrajectorySimilarity ;
                 rdfs:comment "Score of a trajectory similarity, from 0 to 1."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                 rdfs:label "similarity score"@en .


###  http://w3id.org/trajecto#timestamp
:timestamp rdf:type owl:DatatypeProperty ;
           rdfs:domain <http://www.datacron-project.eu/datAcron#RawPosition> ;
           rdfs:range xsd:string ;
           rdfs:comment "Recording time of a raw position, as an ISO 8601 local date-time string."@en ;
           rdfs:isDefinedBy <http://w3id.org/trajecto> ;
           rdfs:label "timestamp"@en .


#################################################################
#    Classes
#################################################################

###  http://w3id.org/trajecto#CasualNavigation
:CasualNavigation rdf:type owl:Class ;
                  rdfs:subClassOf :NavigationStyle ;
                  rdfs:comment "Deprecated: use patterns:CasualMovement."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                  rdfs:label "Casual Navigation"@en ;
                  owl:deprecated "true"^^xsd:boolean .


###  http://w3id.org/trajecto#CentralityRole
:CentralityRole rdf:type owl:Class ;
                rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract> ;
                rdfs:comment "Structural role of a POI in the graphs of co-visitation and flow between POIs, derived from its degree, betweenness and PageRank relative to the other POIs."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                rdfs:label "Centrality Role"@en .


###  http://w3id.org/trajecto#CulturalEvent
:CulturalEvent rdf:type owl:Class ;
               rdfs:subClassOf :EventOfInterest ;
               rdfs:comment "An event of interest of a cultural nature, such as a festival or an exhibition opening."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto> ;
               rdfs:label "Cultural Event"@en .


###  http://w3id.org/trajecto#EngagementLevel
:EngagementLevel rdf:type owl:Class ;
                 rdfs:comment "Engagement of a trajectory as a whole, derived from the share of its meaningful and immersive interactions. Values: HighEngagement, MediumEngagement, LowEngagement. The temporal-dwell module models engagement of single dwell events separately."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                 rdfs:label "Engagement Level"@en .


###  http://w3id.org/trajecto#EntityOfInterest
:EntityOfInterest rdf:type owl:Class ;
                  rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity> ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasInterest ;
                                    owl:someValuesFrom <http://www.w3.org/2004/02/skos/core#Concept>
                                  ] ;
                  rdfs:comment "The entity of interest of any kind (object, event, living organism), that the recording activity aims to record."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                  rdfs:label "Entity of Interest"@en .


###  http://w3id.org/trajecto#EventOfInterest
:EventOfInterest rdf:type owl:Class ;
                 rdfs:subClassOf :EntityOfInterest ,
                                 <http://www.datacron-project.eu/datAcron#Event> ;
                 rdfs:comment "The specific event that the recording activity aims to record. This event may be a natural phenomenon, the movement of an individual etc."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                 rdfs:label "Event of Interest"@en .


###  http://w3id.org/trajecto#ExploratoryNavigation
:ExploratoryNavigation rdf:type owl:Class ;
                       rdfs:subClassOf :NavigationStyle ;
                       rdfs:comment "Deprecated: use patterns:ExploratoryMovement."@en ;
                       rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                       rdfs:label "Exploratory Navigation"@en ;
                       owl:deprecated "true"^^xsd:boolean .


###  http://w3id.org/trajecto#ImmersiveNavigation
:ImmersiveNavigation rdf:type owl:Class ;
                     rdfs:subClassOf :NavigationStyle ;
                     rdfs:comment "Deprecated: use patterns:ImmersiveMovement."@en ;
                     rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                     rdfs:label "Immersive Navigation"@en ;
                     owl:deprecated "true"^^xsd:boolean .


###  http://w3id.org/trajecto#Interaction
:Interaction rdf:type owl:Class ;
             rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract> ;
             rdfs:comment "Something a moving entity does with, or near, an entity of interest during a trajectory. Specialized as POI interactions in the POI module."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto> ;
             rdfs:label "Interaction"@en .


###  http://w3id.org/trajecto#ModeOfTransportation
:ModeOfTransportation rdf:type owl:Class ;
                      rdfs:comment "The means by which a trajectory part is travelled, such as walking, cycling or bus."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                      rdfs:label "Mode of Transportation"@en .


###  http://w3id.org/trajecto#NavigationStyle
:NavigationStyle rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract> ;
                 rdfs:comment "Deprecated: navigation styles are modeled as movement patterns in the patterns module (patterns:TargetedSegment, patterns:CasualMovement, patterns:ExploratoryMovement, patterns:ImmersiveMovement) and asserted with patterns:exhibitsPattern."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                 rdfs:label "Navigation Style"@en ;
                 owl:deprecated "true"^^xsd:boolean .


###  http://w3id.org/trajecto#ObjectOfInterest
:ObjectOfInterest rdf:type owl:Class ;
                  rdfs:subClassOf :EntityOfInterest ,
                                  <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object> ;
                  rdfs:comment "The specific physical object that the recording activity aims to record. The object of interest may be a tree, a monument, a person etc."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                  rdfs:label "Object of Interest"@en .


###  http://w3id.org/trajecto#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf <http://www.datacron-project.eu/datAcron#MovingObject> ;
        rdfs:comment "A person whose movement is recorded as one or more trajectories."@en ;
        rdfs:isDefinedBy <http://w3id.org/trajecto> ;
        rdfs:label "Person"@en .


###  http://w3id.org/trajecto#PointOfInterest
:PointOfInterest rdf:type owl:Class ;
                 rdfs:subClassOf :EntityOfInterest ,
                                 <http://www.datacron-project.eu/datAcron#Point> ;
                 rdfs:comment "The specific spatial point that the recording activity aims to record. The point of interest may be literally one geometric point or an central point of a wider entity of interest."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                 rdfs:label "Point of Interest"@en .


###  http://w3id.org/trajecto#PurposeOfMovement
:PurposeOfMovement rdf:type owl:Class ;
                   rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract> ;
                   rdfs:comment "The reason a trajectory is undertaken. The purpose module specializes it; trajectories point to purpose concepts through hasPurpose."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                   rdfs:label "Purpose of Movement"@en .


###  http://w3id.org/trajecto#RegionOfInterest
:RegionOfInterest rdf:type owl:Class ;
                  owl:equivalentClass :Region_of_Interest ;
                  rdfs:subClassOf :EntityOfInterest ,
                                  <http://www.datacron-project.eu/datAcron#Region> ;
                  rdfs:comment "The region that a recording activity aims to record, such as a forest, an archaeological site or a town."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                  rdfs:label "Region of Interest"@en .


###  http://w3id.org/trajecto#Region_of_Interest
:Region_of_Interest rdf:type owl:Class ;
                    rdfs:comment "Deprecated since 1.1.0: renamed to RegionOfInterest."@en ;
                    rdfs:label "Region_of_Interest (deprecated)"@en ;
                    owl:deprecated "true"^^xsd:boolean .


###  http://w3id.org/trajecto#SocialInteraction
:SocialInteraction rdf:type owl:Class ;
                   rdfs:subClassOf :Interaction ;
                   rdfs:comment "An interaction between moving persons within an area of interest."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                   rdfs:label "Social Interaction"@en .


###  http://w3id.org/trajecto#Stop
:Stop rdf:type owl:Class ;
      owl:equivalentClass :stop ;
      rdfs:subClassOf <http://www.datacron-project.eu/datAcron#Point> ,
                      <http://www.datacron-project.eu/datAcron#TrajectoryPart> ;
      rdfs:comment "A trajectory part during which the moving object stays within a small area for a minimum time."@en ;
      rdfs:isDefinedBy <http://w3id.org/trajecto> ;
      rdfs:label "Stop"@en .


###  http://w3id.org/trajecto#StopPosition
:StopPosition rdf:type owl:Class ;
              rdfs:subClassOf <http://www.datacron-project.eu/datAcron#RawPosition> ;
              rdfs:comment "A raw position that belongs to a stop."@en ;
              rdfs:isDefinedBy <http://w3id.org/trajecto> ;
              rdfs:label "Stop Position"@en .


###  http://w3id.org/trajecto#TargetedNavigation
:TargetedNavigation rdf:type owl:Class ;
                    rdfs:subClassOf :NavigationStyle ;
                    rdfs:comment "Deprecated: use patterns:TargetedSegment."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                    rdfs:label "Targeted Navigation"@en ;
                    owl:deprecated "true"^^xsd:boolean .


###  http://w3id.org/trajecto#TrajectorySimilarity
:TrajectorySimilarity rdf:type owl:Class ;
                      rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract> ;
                      rdfs:comment "A scored similarity between two trajectories along one facet, such as shared POI categories, navigation pattern, temporal context or purpose."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto> ;
                      rdfs:label "Trajectory Similarity"@en .


