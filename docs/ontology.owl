    <!-- http://w3id.org/trajecto#DestinationPOI -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto#DestinationPOI">
        <rdf:type rdf:resource="http://w3id.org/trajecto#CentralityRole"/>
        <rdfs:comment xml:lang="en">A high-PageRank POI with clearly more incoming than outgoing flow.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto"/>
        <rdfs:label xml:lang="en">Destination POI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto#GatewayPOI -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto#GatewayPOI">
        <rdf:type rdf:resource="http://w3id.org/trajecto#CentralityRole"/>
        <rdfs:comment xml:lang="en">A POI in the top quintile of betweenness: it bridges otherwise separate parts of the flow graph.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto"/>
        <rdfs:label xml:lang="en">Gateway POI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto#HighEngagement -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto#HighEngagement">
        <rdf:type rdf:resource="http://w3id.org/trajecto#EngagementLevel"/>
        <rdfs:comment xml:lang="en">Engagement level of a trajectory with a high share of meaningful and immersive interactions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto"/>
        <rdfs:label xml:lang="en">High Engagement</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto#HubPOI -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto#HubPOI">
        <rdf:type rdf:resource="http://w3id.org/trajecto#CentralityRole"/>
        <rdfs:comment xml:lang="en">A POI in the top quintile of both co-visitation degree and PageRank.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto"/>
        <rdfs:label xml:lang="en">Hub POI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto#LowEngagement -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto#LowEngagement">
        <rdf:type rdf:resource="http://w3id.org/trajecto#EngagementLevel"/>
        <rdfs:comment xml:lang="en">Engagement level of a trajectory with few or no meaningful interactions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto"/>
        <rdfs:label xml:lang="en">Low Engagement</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto#MediumEngagement -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto#MediumEngagement">
        <rdf:type rdf:resource="http://w3id.org/trajecto#EngagementLevel"/>
        <rdfs:comment xml:lang="en">Engagement level of a trajectory with a moderate share of meaningful interactions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto"/>
        <rdfs:label xml:lang="en">Medium Engagement</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto#OriginPOI -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto#OriginPOI">
        <rdf:type rdf:resource="http://w3id.org/trajecto#CentralityRole"/>
        <rdfs:comment xml:lang="en">A POI with clearly more outgoing than incoming flow.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto"/>
        <rdfs:label xml:lang="en">Origin POI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto#PeripheralPOI -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto#PeripheralPOI">
        <rdf:type rdf:resource="http://w3id.org/trajecto#CentralityRole"/>
        <rdfs:comment xml:lang="en">A POI with none of the other structural roles.</rdfs:comment>
