        <owl:equivalentClass rdf:resource="http://w3id.org/trajecto#stop"/>
        <rdfs:subClassOf rdf:resource="http://www.datacron-project.eu/datAcron#Point"/>
        <rdfs:subClassOf rdf:resource="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
        <rdfs:comment xml:lang="en">A trajectory part during which the moving object stays within a small area for a minimum time.</rdfs:comment>
