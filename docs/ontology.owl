        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto#Interaction"/>
        <rdfs:comment xml:lang="en">An interaction between moving persons within an area of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto"/>
        <rdfs:label xml:lang="en">Social Interaction</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto#Stop -->


