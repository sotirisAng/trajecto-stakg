#################################################################
#    Individuals
#################################################################

###  http://w3id.org/trajecto/purpose/skos#AccommodationPurpose
:AccommodationPurpose rdf:type owl:NamedIndividual ,
                               <http://www.w3.org/2004/02/skos/core#Concept> ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Movement purpose related to staying at temporary lodging."@en ;
                      <http://www.w3.org/2004/02/skos/core#example> "Hotel stays, hostel accommodation, vacation rentals"@en ;
                      <http://www.w3.org/2004/02/skos/core#inScheme> :TrajectoryPurposeScheme ;
                      <http://www.w3.org/2004/02/skos/core#narrower> :HostelStay ,
                                                                     :HotelStay ,
                                                                     :TemporaryLodging ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Accommodation Purpose"@en ;
                      <http://www.w3.org/2004/02/skos/core#related> <https://schema.org/LodgingReservation> ;
                      <http://www.w3.org/2004/02/skos/core#topConceptOf> :TrajectoryPurposeScheme .


###  http://w3id.org/trajecto/purpose/skos#AirportTransit
:AirportTransit rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
                <http://www.w3.org/2004/02/skos/core#broader> :Transit ;
                <http://www.w3.org/2004/02/skos/core#definition> "Purpose related to using airport facilities for travel."@en ;
                <http://www.w3.org/2004/02/skos/core#inScheme> :TrajectoryPurposeScheme ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Airport Transit"@en .


###  http://w3id.org/trajecto/purpose/skos#ArtisticExperience
:ArtisticExperience rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos/core#Concept> ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
                    <http://www.w3.org/2004/02/skos/core#broader> :CulturalPurpose ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Purpose related to experiencing artistic works or performances."@en ;
                    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://w3id.org/trajecto/purpose#ArtisticExperience> ;
                    <http://www.w3.org/2004/02/skos/core#inScheme> :TrajectoryPurposeScheme ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Artistic Experience"@en .


###  http://w3id.org/trajecto/purpose/skos#Banking
:Banking rdf:type owl:NamedIndividual ,
                  <http://www.w3.org/2004/02/skos/core#Concept> ;
         rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
         <http://www.w3.org/2004/02/skos/core#broader> :ServiceAccess ;
         <http://www.w3.org/2004/02/skos/core#definition> "Purpose related to banking and financial transactions."@en ;
         <http://www.w3.org/2004/02/skos/core#inScheme> :TrajectoryPurposeScheme ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Banking"@en .


###  http://w3id.org/trajecto/purpose/skos#BeachVisit
