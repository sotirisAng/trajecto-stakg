                  <http://www.w3.org/2004/02/skos/core#broader> :CommercialPurpose ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Purpose related to dining at restaurants or food establishments."@en ;
                  <http://www.w3.org/2004/02/skos/core#exactMatch> <http://w3id.org/trajecto/purpose#DiningExperience> ;
                  <http://www.w3.org/2004/02/skos/core#inScheme> :TrajectoryPurposeScheme ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Dining Experience"@en ;
                  <http://www.w3.org/2004/02/skos/core#related> <https://schema.org/EatAction> .


