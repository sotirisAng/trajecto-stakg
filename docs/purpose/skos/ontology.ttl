                                                                   :FormalLearning ,
                                                                   :LibraryVisit ,
                                                                   :Research ,
                                                                   :WorkshopAttendance ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Educational Purpose"@en ;
                    <http://www.w3.org/2004/02/skos/core#topConceptOf> :TrajectoryPurposeScheme .


