###  http://w3id.org/trajecto/purpose/skos#CafeVisit
:CafeVisit rdf:type owl:NamedIndividual ,
                    <http://www.w3.org/2004/02/skos/core#Concept> ;
           rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
           <http://www.w3.org/2004/02/skos/core#broader> :DiningExperience ;
           <http://www.w3.org/2004/02/skos/core#definition> "Purpose related to visiting a cafe for refreshments or socializing."@en ;
           <http://www.w3.org/2004/02/skos/core#inScheme> :TrajectoryPurposeScheme ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Cafe Visit"@en .


###  http://w3id.org/trajecto/purpose/skos#CommercialPurpose
:CommercialPurpose rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos/core#Concept> ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Movement purpose related to commercial activities such as shopping or services."@en ;
                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://w3id.org/trajecto/purpose#CommercialPurpose> ;
                   <http://www.w3.org/2004/02/skos/core#example> "Shopping, dining out, visiting a bank"@en ;
                   <http://www.w3.org/2004/02/skos/core#inScheme> :TrajectoryPurposeScheme ;
                   <http://www.w3.org/2004/02/skos/core#narrower> :DiningExperience ,
                                                                  :ServiceAccess ,
                                                                  :Shopping ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Commercial Purpose"@en ;
                   <http://www.w3.org/2004/02/skos/core#topConceptOf> :TrajectoryPurposeScheme .


###  http://w3id.org/trajecto/purpose/skos#Commuting
:Commuting rdf:type owl:NamedIndividual ,
                    <http://www.w3.org/2004/02/skos/core#Concept> ;
           rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
           <http://www.w3.org/2004/02/skos/core#broader> :TransportationPurpose ;
           <http://www.w3.org/2004/02/skos/core#definition> "Purpose related to regular travel between home and work/education."@en ;
           <http://www.w3.org/2004/02/skos/core#exactMatch> <http://w3id.org/trajecto/purpose#Commuting> ;
           <http://www.w3.org/2004/02/skos/core#inScheme> :TrajectoryPurposeScheme ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Commuting"@en .


###  http://w3id.org/trajecto/purpose/skos#CulturalEventAttendance
:CulturalEventAttendance rdf:type owl:NamedIndividual ,
                                  <http://www.w3.org/2004/02/skos/core#Concept> ;
                         rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
                         <http://www.w3.org/2004/02/skos/core#broader> :CulturalPurpose ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Purpose related to attending cultural events, festivals, or performances."@en ;
                         <http://www.w3.org/2004/02/skos/core#exactMatch> <http://w3id.org/trajecto/purpose#CulturalEventAttendance> ;
                         <http://www.w3.org/2004/02/skos/core#inScheme> :TrajectoryPurposeScheme ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Cultural Event Attendance"@en .


###  http://w3id.org/trajecto/purpose/skos#CulturalPurpose
:CulturalPurpose rdf:type owl:NamedIndividual ,
                          <http://www.w3.org/2004/02/skos/core#Concept> ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Movement purpose related to cultural activities and experiences."@en ;
                 <http://www.w3.org/2004/02/skos/core#exactMatch> <http://w3id.org/trajecto/purpose#CulturalPurpose> ;
                 <http://www.w3.org/2004/02/skos/core#example> "Museum visits, attending performances, exploring heritage sites"@en ;
                 <http://www.w3.org/2004/02/skos/core#inScheme> :TrajectoryPurposeScheme ;
                 <http://www.w3.org/2004/02/skos/core#narrower> :ArtisticExperience ,
                                                                :CulturalEventAttendance ,
                                                                :EducationalTour ,
                                                                :GalleryVisit ,
                                                                :HeritageExploration ,
                                                                :HistoricalSiteVisit ,
                                                                :MuseumVisit ,
                                                                :TheaterVisit ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Cultural Purpose"@en ;
                 <http://www.w3.org/2004/02/skos/core#topConceptOf> :TrajectoryPurposeScheme .


###  http://w3id.org/trajecto/purpose/skos#DiningExperience
:DiningExperience rdf:type owl:NamedIndividual ,
                           <http://www.w3.org/2004/02/skos/core#Concept> ;
