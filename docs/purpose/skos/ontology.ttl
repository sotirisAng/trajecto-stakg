@base <http://w3id.org/trajecto/purpose/skos#> .

<http://w3id.org/trajecto/purpose/skos> rdf:type owl:Ontology ;
                                         owl:versionIRI <http://w3id.org/trajecto/purpose/skos/1.1.0> ;
                                         <http://purl.org/dc/terms/created> "2025-05-09"^^xsd:date ;
                                         <http://purl.org/dc/terms/creator> "Konstantinos Kotis" ,
                                                                            "Sotirios Angelis" ;
                                         <http://purl.org/dc/terms/description> "SKOS concept scheme of movement purposes. POI classes point to these concepts with skos:related, and the purpose classification stage assigns them to trajectories through trajecto:hasPurpose."@en ;
                                         <http://purl.org/dc/terms/issued> "2026-10-01"^^xsd:date ;
                                         <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/> ;
                                         <http://purl.org/dc/terms/modified> "2026-10-01"^^xsd:date ;
                                         <http://purl.org/dc/terms/publisher> "i-Lab, Department of Cultural Technology and Communication, University of the Aegean" ;
                                         <http://purl.org/dc/terms/title> "Trajecto Purpose Concept Scheme"@en ;
                                         <http://purl.org/vocab/vann/preferredNamespacePrefix> "purposeskos" ;
                                         <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/trajecto/purpose/skos#" ;
                                         rdfs:label "trajecto-purpose-skos"@en ;
                                         owl:versionInfo "1.1.0" .

