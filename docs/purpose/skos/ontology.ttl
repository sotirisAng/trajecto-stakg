                    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Movement purpose related to learning and educational activities."@en ;
                    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://w3id.org/trajecto/purpose#EducationalPurpose> ;
                    <http://www.w3.org/2004/02/skos/core#example> "School attendance, workshops, field studies, research activities"@en ;
                    <http://www.w3.org/2004/02/skos/core#inScheme> :TrajectoryPurposeScheme ;
                    <http://www.w3.org/2004/02/skos/core#narrower> :EducationalTour ,
