        <skos:prefLabel xml:lang="en">Train Station Transit</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-01</terms:created>
        <terms:description xml:lang="en">A SKOS concept scheme representing purposes of movement in trajectory data. Covers commercial, cultural, educational, recreational, residential, transportation, and work-related movement purposes.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
        <terms:title xml:lang="en">Trajecto Purpose of Movement Concept Scheme</terms:title>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <rdfs:label xml:lang="en">trajectory purpose scheme</rdfs:label>
        <skos:definition xml:lang="en">Concept scheme of the purposes a trajectory can be assigned.</skos:definition>
        <skos:hasTopConcept rdf:resource="http://w3id.org/trajecto/purpose/skos#AccommodationPurpose"/>
        <skos:hasTopConcept rdf:resource="http://w3id.org/trajecto/purpose/skos#CommercialPurpose"/>
        <skos:hasTopConcept rdf:resource="http://w3id.org/trajecto/purpose/skos#CulturalPurpose"/>
        <skos:hasTopConcept rdf:resource="http://w3id.org/trajecto/purpose/skos#EducationalPurpose"/>
        <skos:hasTopConcept rdf:resource="http://w3id.org/trajecto/purpose/skos#HealthcarePurpose"/>
        <skos:hasTopConcept rdf:resource="http://w3id.org/trajecto/purpose/skos#RecreationalPurpose"/>
        <skos:hasTopConcept rdf:resource="http://w3id.org/trajecto/purpose/skos#ReligiousPurpose"/>
        <skos:hasTopConcept rdf:resource="http://w3id.org/trajecto/purpose/skos#ResidentialPurpose"/>
        <skos:hasTopConcept rdf:resource="http://w3id.org/trajecto/purpose/skos#TransportationPurpose"/>
        <skos:hasTopConcept rdf:resource="http://w3id.org/trajecto/purpose/skos#WorkPurpose"/>
        <skos:prefLabel xml:lang="en">Trajectory purpose scheme</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#TransferBetweenModes -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#TransferBetweenModes">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#TransportationPurpose"/>
        <skos:definition xml:lang="en">Purpose related to transferring between different modes of transportation.</skos:definition>
        <skos:exactMatch rdf:resource="http://w3id.org/trajecto/purpose#TransferBetweenModes"/>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Transfer Between Modes</skos:prefLabel>
    </owl:NamedIndividual>
    


