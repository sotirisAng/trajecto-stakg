        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#EntertainmentAttendance"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#ExerciseActivity"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#LeisureActivity"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#SocialGathering"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#Tourism"/>
        <skos:prefLabel xml:lang="en">Recreational Purpose</skos:prefLabel>
        <skos:topConceptOf rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
