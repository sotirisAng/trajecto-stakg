        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Professional Event</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#RecreationalPurpose -->


