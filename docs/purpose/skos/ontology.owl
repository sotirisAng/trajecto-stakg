    <!-- http://w3id.org/trajecto/purpose/skos#AccommodationPurpose -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#AccommodationPurpose">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:definition xml:lang="en">Movement purpose related to staying at temporary lodging.</skos:definition>
        <skos:example xml:lang="en">Hotel stays, hostel accommodation, vacation rentals</skos:example>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#HostelStay"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#HotelStay"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#TemporaryLodging"/>
        <skos:prefLabel xml:lang="en">Accommodation Purpose</skos:prefLabel>
        <skos:related rdf:resource="https://schema.org/LodgingReservation"/>
        <skos:topConceptOf rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#AirportTransit -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#AirportTransit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#Transit"/>
        <skos:definition xml:lang="en">Purpose related to using airport facilities for travel.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Airport Transit</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#ArtisticExperience -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#ArtisticExperience">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#CulturalPurpose"/>
        <skos:definition xml:lang="en">Purpose related to experiencing artistic works or performances.</skos:definition>
        <skos:exactMatch rdf:resource="http://w3id.org/trajecto/purpose#ArtisticExperience"/>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Artistic Experience</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#Banking -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#Banking">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#ServiceAccess"/>
        <skos:definition xml:lang="en">Purpose related to banking and financial transactions.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Banking</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#BeachVisit -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#BeachVisit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#LeisureActivity"/>
        <skos:definition xml:lang="en">Purpose related to visiting beaches for leisure.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Beach Visit</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#BusStationTransit -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#BusStationTransit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#Transit"/>
        <skos:definition xml:lang="en">Purpose related to using bus station facilities for travel.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Bus Station Transit</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#BusinessMeeting -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#BusinessMeeting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#WorkPurpose"/>
        <skos:definition xml:lang="en">Purpose related to professional business meetings.</skos:definition>
        <skos:exactMatch rdf:resource="http://w3id.org/trajecto/purpose#BusinessMeeting"/>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Business Meeting</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#CafeVisit -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#CafeVisit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#DiningExperience"/>
        <skos:definition xml:lang="en">Purpose related to visiting a cafe for refreshments or socializing.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Cafe Visit</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#CommercialPurpose -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#CommercialPurpose">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:definition xml:lang="en">Movement purpose related to commercial activities such as shopping or services.</skos:definition>
        <skos:exactMatch rdf:resource="http://w3id.org/trajecto/purpose#CommercialPurpose"/>
        <skos:example xml:lang="en">Shopping, dining out, visiting a bank</skos:example>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#DiningExperience"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#ServiceAccess"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#Shopping"/>
        <skos:prefLabel xml:lang="en">Commercial Purpose</skos:prefLabel>
        <skos:topConceptOf rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#Commuting -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#Commuting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#TransportationPurpose"/>
        <skos:definition xml:lang="en">Purpose related to regular travel between home and work/education.</skos:definition>
        <skos:exactMatch rdf:resource="http://w3id.org/trajecto/purpose#Commuting"/>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Commuting</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#CulturalEventAttendance -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#CulturalEventAttendance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#CulturalPurpose"/>
        <skos:definition xml:lang="en">Purpose related to attending cultural events, festivals, or performances.</skos:definition>
        <skos:exactMatch rdf:resource="http://w3id.org/trajecto/purpose#CulturalEventAttendance"/>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Cultural Event Attendance</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#CulturalPurpose -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#CulturalPurpose">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:definition xml:lang="en">Movement purpose related to cultural activities and experiences.</skos:definition>
        <skos:exactMatch rdf:resource="http://w3id.org/trajecto/purpose#CulturalPurpose"/>
        <skos:example xml:lang="en">Museum visits, attending performances, exploring heritage sites</skos:example>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#ArtisticExperience"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#CulturalEventAttendance"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#EducationalTour"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#GalleryVisit"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#HeritageExploration"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#HistoricalSiteVisit"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#MuseumVisit"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#TheaterVisit"/>
        <skos:prefLabel xml:lang="en">Cultural Purpose</skos:prefLabel>
        <skos:topConceptOf rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#DiningExperience -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#DiningExperience">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#CommercialPurpose"/>
        <skos:definition xml:lang="en">Purpose related to dining at restaurants or food establishments.</skos:definition>
        <skos:exactMatch rdf:resource="http://w3id.org/trajecto/purpose#DiningExperience"/>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Dining Experience</skos:prefLabel>
        <skos:related rdf:resource="https://schema.org/EatAction"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#DomesticActivity -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#DomesticActivity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#ResidentialPurpose"/>
        <skos:definition xml:lang="en">Purpose related to household or domestic activities.</skos:definition>
        <skos:exactMatch rdf:resource="http://w3id.org/trajecto/purpose#DomesticActivity"/>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Domestic Activity</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#EducationalPurpose -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#EducationalPurpose">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:definition xml:lang="en">Movement purpose related to learning and educational activities.</skos:definition>
        <skos:exactMatch rdf:resource="http://w3id.org/trajecto/purpose#EducationalPurpose"/>
        <skos:example xml:lang="en">School attendance, workshops, field studies, research activities</skos:example>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#EducationalTour"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#FieldStudy"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#FormalLearning"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#LibraryVisit"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#Research"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#WorkshopAttendance"/>
        <skos:prefLabel xml:lang="en">Educational Purpose</skos:prefLabel>
        <skos:topConceptOf rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#EducationalTour -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#EducationalTour">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#CulturalPurpose"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#EducationalPurpose"/>
        <skos:definition xml:lang="en">Purpose that combines cultural experience with educational objectives.</skos:definition>
        <skos:exactMatch rdf:resource="http://w3id.org/trajecto/purpose#EducationalTour"/>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Educational Tour</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#EmergencyCare -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#EmergencyCare">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#HealthcarePurpose"/>
        <skos:definition xml:lang="en">Purpose related to seeking urgent or emergency medical attention.</skos:definition>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Emergency Care</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#EntertainmentAttendance -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#EntertainmentAttendance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
