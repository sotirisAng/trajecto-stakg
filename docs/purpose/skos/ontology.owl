        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#TransportationPurpose"/>
        <skos:definition xml:lang="en">Purpose primarily focused on moving from one location to another.</skos:definition>
        <skos:exactMatch rdf:resource="http://w3id.org/trajecto/purpose#Transit"/>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:prefLabel xml:lang="en">Transit</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#TransportationPurpose -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#TransportationPurpose">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:definition xml:lang="en">Movement purpose primarily related to transport and transit between locations.</skos:definition>
        <skos:exactMatch rdf:resource="http://w3id.org/trajecto/purpose#TransportationPurpose"/>
        <skos:example xml:lang="en">Commuting, transit transfers, wandering</skos:example>
        <skos:inScheme rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#Commuting"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#InformationSeeking"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#Parking"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#TransferBetweenModes"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#Transit"/>
        <skos:narrower rdf:resource="http://w3id.org/trajecto/purpose/skos#Wandering"/>
        <skos:prefLabel xml:lang="en">Transportation Purpose</skos:prefLabel>
        <skos:topConceptOf rdf:resource="http://w3id.org/trajecto/purpose/skos#TrajectoryPurposeScheme"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/trajecto/purpose/skos#UniversityAttendance -->


    <owl:NamedIndividual rdf:about="http://w3id.org/trajecto/purpose/skos#UniversityAttendance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <skos:broader rdf:resource="http://w3id.org/trajecto/purpose/skos#FormalLearning"/>
        <skos:definition xml:lang="en">Purpose related to attending university or higher education.</skos:definition>
