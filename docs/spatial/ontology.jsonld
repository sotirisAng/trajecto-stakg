    "@id" : "http://w3id.org/trajecto/spatial"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "zone radius"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ]
}, {
  "@id" : "http://www.datacron-project.eu/datAcron#Trajectory",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
  "@id" : "http://www.datacron-project.eu/datAcron#TrajectoryCluster",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
