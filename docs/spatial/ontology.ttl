                 rdfs:subClassOf :SpatialFeature ;
                 rdfs:comment "Area with low concentration of trajectory activity."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                 rdfs:label "Spatial Coldspot"@en .


