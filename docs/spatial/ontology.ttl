###  http://w3id.org/trajecto/spatial#PolygonalZone
:PolygonalZone rdf:type owl:Class ;
               rdfs:subClassOf :ProximityZone ;
               rdfs:comment "A polygonal proximity zone defined by boundary coordinates."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
