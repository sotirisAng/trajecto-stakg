###  http://w3id.org/trajecto/spatial#ProximityInteraction
:ProximityInteraction rdf:type owl:Class ;
                      rdfs:subClassOf :SpatialInteraction ;
                      rdfs:comment "Interaction based on being within proximity threshold."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                      rdfs:label "Proximity Interaction"@en .


###  http://w3id.org/trajecto/spatial#ProximityLevel
