@prefix : <http://w3id.org/trajecto/spatial#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://w3id.org/trajecto/spatial#> .

<http://w3id.org/trajecto/spatial> rdf:type owl:Ontology ;
                                    owl:versionIRI <http://w3id.org/trajecto/spatial/1.1.0> ;
                                    <http://purl.org/dc/terms/created> "2025-05-30"^^xsd:date ;
                                    <http://purl.org/dc/terms/creator> "Konstantinos Kotis" ,
                                                                       "Sotirios Angelis" ;
                                    <http://purl.org/dc/terms/description> "This module extends the trajecto ontology with comprehensive spatial analysis capabilities for trajectory proximity detection and spatial relationship modeling."@en ;
                                    <http://purl.org/dc/terms/issued> "2026-10-01"^^xsd:date ;
                                    <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/> ;
                                    <http://purl.org/dc/terms/modified> "2026-10-01"^^xsd:date ;
                                    <http://purl.org/dc/terms/publisher> "i-Lab, Department of Cultural Technology and Communication, University of the Aegean" ;
                                    <http://purl.org/dc/terms/title> "Trajecto Spatial Analysis Module"@en ;
                                    <http://purl.org/vocab/vann/preferredNamespacePrefix> "spatial" ;
                                    <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/trajecto/spatial#" ;
                                    rdfs:label "trajecto-spatial"@en ;
                                    owl:priorVersion <http://w3id.org/trajecto/spatial/1.0> ;
                                    owl:versionInfo "1.1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/date
<http://purl.org/dc/elements/1.1/date> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/01/geo/wgs84_pos#alt
<http://www.w3.org/2003/01/geo/wgs84_pos#alt> rdf:type owl:AnnotationProperty ;
                                              rdfs:comment """The WGS84 altitude of a SpatialThing (decimal meters 
above the local reference ellipsoid)."""@en ;
                                              rdfs:label "altitude"@en ;
                                              rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .


###  http://www.w3.org/2003/01/geo/wgs84_pos#lat
<http://www.w3.org/2003/01/geo/wgs84_pos#lat> rdf:type owl:AnnotationProperty ;
                                              rdfs:comment "The WGS84 latitude of a SpatialThing (decimal degrees)."@en ;
                                              rdfs:label "latitude"@en ;
                                              rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .


###  http://www.w3.org/2003/01/geo/wgs84_pos#location
<http://www.w3.org/2003/01/geo/wgs84_pos#location> rdf:type owl:AnnotationProperty ;
                                                   rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .


###  http://www.w3.org/2003/01/geo/wgs84_pos#long
<http://www.w3.org/2003/01/geo/wgs84_pos#long> rdf:type owl:AnnotationProperty ;
                                               rdfs:comment "The WGS84 longitude of a SpatialThing (decimal degrees)."@en ;
                                               rdfs:label "longitude"@en ;
                                               rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/based_near
<http://xmlns.com/foaf/0.1/based_near> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://w3id.org/trajecto/spatial#clustersWith
:clustersWith rdf:type owl:ObjectProperty ,
                       owl:SymmetricProperty ,
                       owl:TransitiveProperty ;
              rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
              rdfs:range <http://www.datacron-project.eu/datAcron#Trajectory> ;
              rdfs:comment "Indicates that two trajectories cluster together spatially."@en ;
              rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
              rdfs:label "clusters with"@en .


###  http://w3id.org/trajecto/spatial#containsTrajectoryPart
:containsTrajectoryPart rdf:type owl:ObjectProperty ;
                        rdfs:domain :ProximityZone ;
                        rdfs:range <http://www.datacron-project.eu/datAcron#TrajectoryPart> ;
                        rdfs:comment "Indicates that a proximity zone contains a trajectory part."@en ;
                        rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                        rdfs:label "contains trajectory part"@en .


###  http://w3id.org/trajecto/spatial#hasDistanceMeasurement
:hasDistanceMeasurement rdf:type owl:ObjectProperty ;
                        rdfs:domain :ProximityResult ;
                        rdfs:range :DistanceMeasurement ;
                        rdfs:comment "Associates a proximity result with its distance measurement details."@en ;
                        rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                        rdfs:label "has distance measurement"@en .


###  http://w3id.org/trajecto/spatial#hasInfluenceZone
:hasInfluenceZone rdf:type owl:ObjectProperty ;
                  rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
                  rdfs:range :InfluenceZone ;
                  rdfs:comment "Associates a point of interest with its influence zone."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                  rdfs:label "has influence zone"@en .


###  http://w3id.org/trajecto/spatial#hasProximityAnalysis
:hasProximityAnalysis rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                      rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                      rdfs:range :ProximityAnalysis ;
                      rdfs:comment "Associates a trajectory with its spatial proximity analysis."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                      rdfs:label "has proximity analysis"@en .


###  http://w3id.org/trajecto/spatial#hasProximityResult
:hasProximityResult rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                    rdfs:domain <http://www.datacron-project.eu/datAcron#TrajectoryPart> ;
                    rdfs:range :ProximityResult ;
                    rdfs:comment "Associates a trajectory part with its proximity analysis results."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                    rdfs:label "has proximity result"@en .


###  http://w3id.org/trajecto/spatial#hasProximityZone
:hasProximityZone rdf:type owl:ObjectProperty ;
                  rdfs:domain <http://w3id.org/trajecto#PointOfInterest> ;
                  rdfs:range :ProximityZone ;
                  rdfs:comment "Associates a point of interest with its proximity zone definition."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                  rdfs:label "has proximity zone"@en .


###  http://w3id.org/trajecto/spatial#hasSpatialCluster
:hasSpatialCluster rdf:type owl:ObjectProperty ;
                   rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                   rdfs:range :SpatialCluster ;
                   rdfs:comment "Associates a trajectory with a spatial cluster based on proximity patterns."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                   rdfs:label "has spatial cluster"@en .


###  http://w3id.org/trajecto/spatial#hasSpatialContext
:hasSpatialContext rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                   rdfs:domain <http://www.datacron-project.eu/datAcron#TrajectoryPart> ;
                   rdfs:range :SpatialContext ;
                   rdfs:comment "Associates a trajectory part with its spatial context."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                   rdfs:label "has spatial context"@en .


###  http://w3id.org/trajecto/spatial#hasSpatialRelationship
:hasSpatialRelationship rdf:type owl:ObjectProperty ;
                        rdfs:domain <http://www.datacron-project.eu/datAcron#TrajectoryPart> ;
                        rdfs:range :SpatialRelationship ;
                        rdfs:comment "Associates a trajectory part with its spatial relationships."@en ;
                        rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                        rdfs:label "has spatial relationship"@en .


###  http://w3id.org/trajecto/spatial#proximityTo
:proximityTo rdf:type owl:ObjectProperty ;
             rdfs:domain :ProximityResult ;
             rdfs:range <http://w3id.org/trajecto#PointOfInterest> ;
             rdfs:comment "Specifies the point of interest that the proximity result refers to."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
             rdfs:label "proximity to"@en .


###  http://w3id.org/trajecto/spatial#relatedTo
:relatedTo rdf:type owl:ObjectProperty ;
           rdfs:domain :SpatialRelationship ;
           rdfs:range <http://w3id.org/trajecto#EntityOfInterest> ;
           rdfs:comment "Specifies the entity that the spatial relationship involves."@en ;
           rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
           rdfs:label "related to"@en .


###  http://w3id.org/trajecto/spatial#spatiallyInteractsWith
:spatiallyInteractsWith rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                        rdfs:domain <http://www.datacron-project.eu/datAcron#TrajectoryPart> ;
                        rdfs:range <http://w3id.org/trajecto#EntityOfInterest> ;
                        rdfs:comment "Indicates spatial interaction between trajectory part and entity."@en ;
                        rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                        rdfs:label "spatially interacts with"@en .


###  http://w3id.org/trajecto/spatial#usesDistanceMetric
:usesDistanceMetric rdf:type owl:ObjectProperty ;
                    rdfs:domain :DistanceMeasurement ;
                    rdfs:range :DistanceMetric ;
                    rdfs:comment "Specifies the distance metric used in a measurement."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                    rdfs:label "uses distance metric"@en .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> rdf:type owl:ObjectProperty .


###  http://www.w3.org/2003/01/geo/wgs84_pos#location
<http://www.w3.org/2003/01/geo/wgs84_pos#location> rdf:type owl:ObjectProperty ;
                                                   rdfs:subPropertyOf <http://xmlns.com/foaf/0.1/based_near> .


#################################################################
#    Data properties
#################################################################

###  http://w3id.org/trajecto/spatial#analysisAccuracy
:analysisAccuracy rdf:type owl:DatatypeProperty ;
                  rdfs:domain :ProximityAnalysis ;
                  rdfs:range xsd:float ;
                  rdfs:comment "Accuracy measure of the proximity analysis (0.0-1.0)."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                  rdfs:label "analysis accuracy"@en .


###  http://w3id.org/trajecto/spatial#analysisTimestamp
:analysisTimestamp rdf:type owl:DatatypeProperty ;
                   rdfs:domain :ProximityAnalysis ;
                   rdfs:range xsd:dateTime ;
                   rdfs:comment "Timestamp when the proximity analysis was performed."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                   rdfs:label "analysis timestamp"@en .


###  http://w3id.org/trajecto/spatial#clusterDensity
:clusterDensity rdf:type owl:DatatypeProperty ;
                rdfs:domain :SpatialCluster ;
                rdfs:range xsd:float ;
                rdfs:comment "Density measure of the spatial cluster."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                rdfs:label "cluster density"@en .


###  http://w3id.org/trajecto/spatial#clusterSize
:clusterSize rdf:type owl:DatatypeProperty ;
             rdfs:domain :SpatialCluster ;
             rdfs:range xsd:positiveInteger ;
             rdfs:comment "Number of trajectories in the spatial cluster."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
             rdfs:label "cluster size"@en .


###  http://w3id.org/trajecto/spatial#hasDistance
:hasDistance rdf:type owl:DatatypeProperty ;
             rdfs:domain :ProximityResult ;
             rdfs:range xsd:double ;
             rdfs:comment "Distance value in meters between trajectory part and point of interest."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
             rdfs:label "has distance"@en .


###  http://w3id.org/trajecto/spatial#hasEuclideanDistance
:hasEuclideanDistance rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :hasDistance ;
                      rdfs:domain :DistanceMeasurement ;
                      rdfs:range xsd:double ;
                      rdfs:comment "Euclidean distance in meters."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                      rdfs:label "has euclidean distance"@en .


###  http://w3id.org/trajecto/spatial#hasHaversineDistance
:hasHaversineDistance rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :hasDistance ;
                      rdfs:domain :DistanceMeasurement ;
                      rdfs:range xsd:double ;
                      rdfs:comment "Haversine distance in meters, accounting for Earth's curvature."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                      rdfs:label "has haversine distance"@en .


###  http://w3id.org/trajecto/spatial#hasManhattanDistance
:hasManhattanDistance rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :hasDistance ;
                      rdfs:domain :DistanceMeasurement ;
                      rdfs:range xsd:double ;
                      rdfs:comment "Manhattan distance in meters."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                      rdfs:label "has manhattan distance"@en .


###  http://w3id.org/trajecto/spatial#influenceRadius
:influenceRadius rdf:type owl:DatatypeProperty ;
                 rdfs:domain :InfluenceZone ;
                 rdfs:range xsd:double ;
                 rdfs:comment "Radius of the influence zone in meters."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                 rdfs:label "influence radius"@en .


###  http://w3id.org/trajecto/spatial#proximityRank
:proximityRank rdf:type owl:DatatypeProperty ;
               rdfs:domain :ProximityResult ;
               rdfs:range xsd:positiveInteger ;
               rdfs:comment "Rank of proximity (1 = closest) for a trajectory part among all nearby POIs."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
               rdfs:label "proximity rank"@en .


###  http://w3id.org/trajecto/spatial#proximityScore
:proximityScore rdf:type owl:DatatypeProperty ;
                rdfs:domain :ProximityResult ;
                rdfs:range xsd:float ;
                rdfs:comment "Normalized proximity score (0.0-1.0) where 1.0 is highest proximity."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                rdfs:label "proximity score"@en .


###  http://w3id.org/trajecto/spatial#spatialCohesion
:spatialCohesion rdf:type owl:DatatypeProperty ;
                 rdfs:domain :SpatialCluster ;
                 rdfs:range xsd:float ;
                 rdfs:comment "Measure of spatial cohesion within the cluster (0.0-1.0)."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                 rdfs:label "spatial cohesion"@en .


###  http://w3id.org/trajecto/spatial#withinProximity
:withinProximity rdf:type owl:DatatypeProperty ;
                 rdfs:domain :ProximityResult ;
                 rdfs:range xsd:boolean ;
                 rdfs:comment "Boolean indicating if the trajectory part is within proximity threshold."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                 rdfs:label "within proximity"@en .


###  http://w3id.org/trajecto/spatial#zoneRadius
:zoneRadius rdf:type owl:DatatypeProperty ;
            rdfs:domain :ProximityZone ;
            rdfs:range xsd:double ;
            rdfs:comment "Radius of the proximity zone in meters."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
            rdfs:label "zone radius"@en .


#################################################################
#    Classes
#################################################################

###  http://w3id.org/trajecto#EntityOfInterest
<http://w3id.org/trajecto#EntityOfInterest> rdf:type owl:Class .


###  http://w3id.org/trajecto#Interaction
<http://w3id.org/trajecto#Interaction> rdf:type owl:Class .


###  http://w3id.org/trajecto#PointOfInterest
<http://w3id.org/trajecto#PointOfInterest> rdf:type owl:Class .


###  http://w3id.org/trajecto#RegionOfInterest
<http://w3id.org/trajecto#RegionOfInterest> rdf:type owl:Class .


###  http://w3id.org/trajecto/spatial#AttractionInteraction
:AttractionInteraction rdf:type owl:Class ;
                       rdfs:subClassOf :InfluenceInteraction ;
                       rdfs:comment "Interaction where POI attracts trajectory movement."@en ;
                       rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                       rdfs:label "Attraction Interaction"@en .


###  http://w3id.org/trajecto/spatial#AvoidanceInteraction
:AvoidanceInteraction rdf:type owl:Class ;
                      rdfs:subClassOf :InfluenceInteraction ;
                      rdfs:comment "Interaction where POI causes trajectory avoidance."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                      rdfs:label "Avoidance Interaction"@en .


###  http://w3id.org/trajecto/spatial#BufferAnalysis
:BufferAnalysis rdf:type owl:Class ;
                rdfs:subClassOf :SpatialAnalysisAlgorithm ;
                rdfs:comment "Buffer-based proximity analysis algorithm."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                rdfs:label "Buffer Analysis"@en .


###  http://w3id.org/trajecto/spatial#CircularZone
:CircularZone rdf:type owl:Class ;
              rdfs:subClassOf :ProximityZone ;
              rdfs:comment "A circular proximity zone defined by a center point and radius."@en ;
              rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
              rdfs:label "Circular Zone"@en .


###  http://w3id.org/trajecto/spatial#CloseProximity
:CloseProximity rdf:type owl:Class ;
                rdfs:subClassOf :ProximityLevel ;
                rdfs:comment "Close proximity (typically 10-50 meters)."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                rdfs:label "Close Proximity"@en .


###  http://w3id.org/trajecto/spatial#DBSCANClustering
:DBSCANClustering rdf:type owl:Class ;
                  rdfs:subClassOf :SpatialAnalysisAlgorithm ;
                  rdfs:comment "DBSCAN clustering algorithm for spatial analysis."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                  rdfs:label "DBSCAN Clustering"@en .


###  http://w3id.org/trajecto/spatial#DenseCluster
:DenseCluster rdf:type owl:Class ;
              rdfs:subClassOf :SpatialCluster ;
              rdfs:comment "A spatial cluster with high density of trajectory points."@en ;
              rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
              rdfs:label "Dense Cluster"@en .


###  http://w3id.org/trajecto/spatial#DistanceMeasurement
:DistanceMeasurement rdf:type owl:Class ;
                     rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract> ;
                     rdfs:comment "A measurement of distance between spatial entities."@en ;
                     rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                     rdfs:label "Distance Measurement"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A structured measurement containing distance values calculated using different metrics."@en .


###  http://w3id.org/trajecto/spatial#DistanceMetric
:DistanceMetric rdf:type owl:Class ;
                rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract> ;
                rdfs:comment "A method for calculating distance between spatial points."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                rdfs:label "Distance Metric"@en .


###  http://w3id.org/trajecto/spatial#DistantProximity
:DistantProximity rdf:type owl:Class ;
                  rdfs:subClassOf :ProximityLevel ;
                  rdfs:comment "Distant proximity (beyond 200 meters)."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                  rdfs:label "Distant Proximity"@en .


###  http://w3id.org/trajecto/spatial#EuclideanMetric
:EuclideanMetric rdf:type owl:Class ;
                 rdfs:subClassOf :DistanceMetric ;
                 rdfs:comment "Euclidean distance metric for straight-line distance calculation."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                 rdfs:label "Euclidean Metric"@en .


###  http://w3id.org/trajecto/spatial#HaversineMetric
:HaversineMetric rdf:type owl:Class ;
                 rdfs:subClassOf :DistanceMetric ;
                 rdfs:comment "Haversine distance metric accounting for Earth's curvature."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                 rdfs:label "Haversine Metric"@en .


###  http://w3id.org/trajecto/spatial#HighQuality
:HighQuality rdf:type owl:Class ;
             rdfs:subClassOf :SpatialQuality ;
             rdfs:comment "High quality spatial analysis with reliable results."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
             rdfs:label "High Quality"@en .


###  http://w3id.org/trajecto/spatial#ImmediateProximity
:ImmediateProximity rdf:type owl:Class ;
                    rdfs:subClassOf :ProximityLevel ;
                    rdfs:comment "Immediate proximity (typically 0-10 meters)."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                    rdfs:label "Immediate Proximity"@en .


###  http://w3id.org/trajecto/spatial#IndoorSpatialContext
:IndoorSpatialContext rdf:type owl:Class ;
                      rdfs:subClassOf :SpatialContext ;
                      rdfs:comment "Spatial context for indoor trajectory analysis."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                      rdfs:label "Indoor Spatial Context"@en .


###  http://w3id.org/trajecto/spatial#InfluenceInteraction
:InfluenceInteraction rdf:type owl:Class ;
                      rdfs:subClassOf :SpatialInteraction ;
                      rdfs:comment "Interaction where POI influences trajectory behavior."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                      rdfs:label "Influence Interaction"@en .


###  http://w3id.org/trajecto/spatial#InfluenceZone
:InfluenceZone rdf:type owl:Class ;
               rdfs:subClassOf :ProximityZone ;
               rdfs:comment "A zone where a point of interest has measurable influence on trajectory behavior."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
               rdfs:label "Influence Zone"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A spatial area where a POI demonstrates measurable attraction or influence on movement patterns."@en .


###  http://w3id.org/trajecto/spatial#KNearestNeighbor
:KNearestNeighbor rdf:type owl:Class ;
                  rdfs:subClassOf :SpatialAnalysisAlgorithm ;
                  rdfs:comment "K-nearest neighbor algorithm for proximity analysis."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                  rdfs:label "K Nearest Neighbor"@en .


###  http://w3id.org/trajecto/spatial#LowQuality
:LowQuality rdf:type owl:Class ;
            rdfs:subClassOf :SpatialQuality ;
            rdfs:comment "Low quality spatial analysis with unreliable results."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
            rdfs:label "Low Quality"@en .


###  http://w3id.org/trajecto/spatial#ManhattanMetric
:ManhattanMetric rdf:type owl:Class ;
                 rdfs:subClassOf :DistanceMetric ;
                 rdfs:comment "Manhattan distance metric for grid-based distance calculation."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                 rdfs:label "Manhattan Metric"@en .


###  http://w3id.org/trajecto/spatial#MediumQuality
:MediumQuality rdf:type owl:Class ;
               rdfs:subClassOf :SpatialQuality ;
               rdfs:comment "Medium quality spatial analysis with acceptable results."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
               rdfs:label "Medium Quality"@en .


###  http://w3id.org/trajecto/spatial#NearbyProximity
:NearbyProximity rdf:type owl:Class ;
                 rdfs:subClassOf :ProximityLevel ;
                 rdfs:comment "Nearby proximity (typically 50-100 meters)."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                 rdfs:label "Nearby Proximity"@en .


###  http://w3id.org/trajecto/spatial#NoiseCluster
:NoiseCluster rdf:type owl:Class ;
              rdfs:subClassOf :SpatialCluster ;
              rdfs:comment "Trajectories that do not fit into any meaningful spatial cluster."@en ;
              rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
              rdfs:label "Noise Cluster"@en .


###  http://w3id.org/trajecto/spatial#OutdoorSpatialContext
:OutdoorSpatialContext rdf:type owl:Class ;
                       rdfs:subClassOf :SpatialContext ;
                       rdfs:comment "Spatial context for outdoor trajectory analysis."@en ;
                       rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
