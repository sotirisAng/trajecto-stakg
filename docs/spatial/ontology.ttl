:SpatialCluster rdf:type owl:Class ;
                rdfs:subClassOf <http://www.datacron-project.eu/datAcron#TrajectoryCluster> ;
                rdfs:comment "A cluster of trajectories based on spatial proximity patterns."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                rdfs:label "Spatial Cluster"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A group of trajectories that exhibit similar spatial proximity patterns to points of interest."@en .


