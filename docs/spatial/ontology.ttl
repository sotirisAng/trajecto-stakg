                rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract> ;
                rdfs:comment "Classification level for spatial proximity."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                rdfs:label "Proximity Level"@en .


###  http://w3id.org/trajecto/spatial#ProximityPattern
:ProximityPattern rdf:type owl:Class ;
                  rdfs:subClassOf :SpatialFeature ;
                  rdfs:comment "Pattern of proximity relationships in trajectory data."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                  rdfs:label "Proximity Pattern"@en .


###  http://w3id.org/trajecto/spatial#ProximityResult
:ProximityResult rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract> ;
                 rdfs:comment "Result of proximity calculation between a trajectory part and a point of interest."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                 rdfs:label "Proximity Result"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A structured result containing distance measurements, proximity classifications, and related metadata for a trajectory-POI pair."@en .


###  http://w3id.org/trajecto/spatial#ProximityZone
:ProximityZone rdf:type owl:Class ;
               rdfs:subClassOf <http://w3id.org/trajecto#RegionOfInterest> ;
               rdfs:comment "A defined spatial zone around a point of interest for proximity detection."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
               rdfs:label "Proximity Zone"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A circular or polygonal area around a POI within which trajectory points are considered to be in proximity."@en .


###  http://w3id.org/trajecto/spatial#RuralSpatialContext
:RuralSpatialContext rdf:type owl:Class ;
                     rdfs:subClassOf :SpatialContext ;
                     rdfs:comment "Spatial context in rural environments with low POI density."@en ;
                     rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
                     rdfs:label "Rural Spatial Context"@en .


###  http://w3id.org/trajecto/spatial#SparseCluster
:SparseCluster rdf:type owl:Class ;
               rdfs:subClassOf :SpatialCluster ;
               rdfs:comment "A spatial cluster with low density of trajectory points."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/spatial> ;
               rdfs:label "Sparse Cluster"@en .


