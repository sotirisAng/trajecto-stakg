        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">Spatial Context</rdfs:label>
        <skos:definition xml:lang="en">Contextual information about the spatial environment and relationships relevant to trajectory analysis.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spatial#SpatialCorridor -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spatial#SpatialCorridor">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spatial#SpatialFeature"/>
        <rdfs:comment xml:lang="en">Linear feature showing common trajectory paths.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">Spatial Corridor</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spatial#SpatialFeature -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spatial#SpatialFeature">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract"/>
        <rdfs:comment xml:lang="en">Spatial feature extracted from trajectory analysis.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">Spatial Feature</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spatial#SpatialHotspot -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spatial#SpatialHotspot">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spatial#SpatialFeature"/>
        <rdfs:comment xml:lang="en">Area with high concentration of trajectory activity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">Spatial Hotspot</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spatial#SpatialInteraction -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spatial#SpatialInteraction">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto#Interaction"/>
        <rdfs:comment xml:lang="en">Interaction defined by spatial proximity relationships.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">Spatial Interaction</rdfs:label>
        <skos:definition xml:lang="en">An interaction between trajectory elements and entities based on spatial proximity criteria.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spatial#SpatialQuality -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spatial#SpatialQuality">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Quality"/>
        <rdfs:comment xml:lang="en">Quality assessment of spatial analysis results.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">Spatial Quality</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spatial#SpatialRelationship -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spatial#SpatialRelationship">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract"/>
        <rdfs:comment xml:lang="en">A spatial relationship between trajectory elements and entities of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">Spatial Relationship</rdfs:label>
        <skos:definition xml:lang="en">A formalized spatial relationship that describes how trajectory elements relate to entities in space.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spatial#UrbanSpatialContext -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spatial#UrbanSpatialContext">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spatial#SpatialContext"/>
        <rdfs:comment xml:lang="en">Spatial context in urban environments with high POI density.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">Urban Spatial Context</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spatial#VicinityProximity -->


