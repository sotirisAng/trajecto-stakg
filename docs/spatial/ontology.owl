<?xml version="1.0"?>
<rdf:RDF xmlns="http://w3id.org/trajecto/spatial#"
     xml:base="http://w3id.org/trajecto/spatial"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:wgs84_pos="http://www.w3.org/2003/01/geo/wgs84_pos#">
    <owl:Ontology rdf:about="http://w3id.org/trajecto/spatial">
        <owl:versionIRI rdf:resource="http://w3id.org/trajecto/spatial/1.1.0"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-30</terms:created>
        <terms:creator>Konstantinos Kotis</terms:creator>
        <terms:creator>Sotirios Angelis</terms:creator>
        <terms:description xml:lang="en">This module extends the trajecto ontology with comprehensive spatial analysis capabilities for trajectory proximity detection and spatial relationship modeling.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:modified>
        <terms:publisher>i-Lab, Department of Cultural Technology and Communication, University of the Aegean</terms:publisher>
        <terms:title xml:lang="en">Trajecto Spatial Analysis Module</terms:title>
        <vann:preferredNamespacePrefix>spatial</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://w3id.org/trajecto/spatial#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">trajecto-spatial</rdfs:label>
        <owl:priorVersion rdf:resource="http://w3id.org/trajecto/spatial/1.0"/>
        <owl:versionInfo>1.1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#alt -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#alt">
        <rdfs:comment xml:lang="en">The WGS84 altitude of a SpatialThing (decimal meters 
above the local reference ellipsoid).</rdfs:comment>
        <rdfs:label xml:lang="en">altitude</rdfs:label>
        <rdfs:domain rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#lat -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#lat">
        <rdfs:comment xml:lang="en">The WGS84 latitude of a SpatialThing (decimal degrees).</rdfs:comment>
        <rdfs:label xml:lang="en">latitude</rdfs:label>
        <rdfs:domain rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#location -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#location">
        <rdfs:range rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#long -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#long">
        <rdfs:comment xml:lang="en">The WGS84 longitude of a SpatialThing (decimal degrees).</rdfs:comment>
        <rdfs:label xml:lang="en">longitude</rdfs:label>
        <rdfs:domain rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://xmlns.com/foaf/0.1/based_near -->


    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/based_near"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto/spatial#clustersWith -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#clustersWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:comment xml:lang="en">Indicates that two trajectories cluster together spatially.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">clusters with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spatial#containsTrajectoryPart -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#containsTrajectoryPart">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#ProximityZone"/>
        <rdfs:range rdf:resource="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
        <rdfs:comment xml:lang="en">Indicates that a proximity zone contains a trajectory part.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">contains trajectory part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spatial#hasDistanceMeasurement -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#hasDistanceMeasurement">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#ProximityResult"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spatial#DistanceMeasurement"/>
        <rdfs:comment xml:lang="en">Associates a proximity result with its distance measurement details.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">has distance measurement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spatial#hasInfluenceZone -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#hasInfluenceZone">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spatial#InfluenceZone"/>
        <rdfs:comment xml:lang="en">Associates a point of interest with its influence zone.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">has influence zone</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spatial#hasProximityAnalysis -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#hasProximityAnalysis">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spatial#ProximityAnalysis"/>
        <rdfs:comment xml:lang="en">Associates a trajectory with its spatial proximity analysis.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">has proximity analysis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spatial#hasProximityResult -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#hasProximityResult">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spatial#ProximityResult"/>
        <rdfs:comment xml:lang="en">Associates a trajectory part with its proximity analysis results.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">has proximity result</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spatial#hasProximityZone -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#hasProximityZone">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spatial#ProximityZone"/>
        <rdfs:comment xml:lang="en">Associates a point of interest with its proximity zone definition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">has proximity zone</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spatial#hasSpatialCluster -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#hasSpatialCluster">
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spatial#SpatialCluster"/>
        <rdfs:comment xml:lang="en">Associates a trajectory with a spatial cluster based on proximity patterns.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">has spatial cluster</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spatial#hasSpatialContext -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#hasSpatialContext">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spatial#SpatialContext"/>
        <rdfs:comment xml:lang="en">Associates a trajectory part with its spatial context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">has spatial context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spatial#hasSpatialRelationship -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#hasSpatialRelationship">
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spatial#SpatialRelationship"/>
        <rdfs:comment xml:lang="en">Associates a trajectory part with its spatial relationships.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">has spatial relationship</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spatial#proximityTo -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#proximityTo">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#ProximityResult"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:comment xml:lang="en">Specifies the point of interest that the proximity result refers to.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">proximity to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spatial#relatedTo -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#relatedTo">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#SpatialRelationship"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto#EntityOfInterest"/>
        <rdfs:comment xml:lang="en">Specifies the entity that the spatial relationship involves.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">related to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spatial#spatiallyInteractsWith -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#spatiallyInteractsWith">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto#EntityOfInterest"/>
        <rdfs:comment xml:lang="en">Indicates spatial interaction between trajectory part and entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">spatially interacts with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spatial#usesDistanceMetric -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spatial#usesDistanceMetric">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#DistanceMeasurement"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spatial#DistanceMetric"/>
        <rdfs:comment xml:lang="en">Specifies the distance metric used in a measurement.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">uses distance metric</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith -->


    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith"/>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#location -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#location">
        <rdfs:subPropertyOf rdf:resource="http://xmlns.com/foaf/0.1/based_near"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto/spatial#analysisAccuracy -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#analysisAccuracy">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#ProximityAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Accuracy measure of the proximity analysis (0.0-1.0).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">analysis accuracy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spatial#analysisTimestamp -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#analysisTimestamp">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#ProximityAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Timestamp when the proximity analysis was performed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">analysis timestamp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spatial#clusterDensity -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#clusterDensity">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#SpatialCluster"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Density measure of the spatial cluster.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">cluster density</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spatial#clusterSize -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#clusterSize">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#SpatialCluster"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">Number of trajectories in the spatial cluster.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">cluster size</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spatial#hasDistance -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#hasDistance">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#ProximityResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Distance value in meters between trajectory part and point of interest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">has distance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spatial#hasEuclideanDistance -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#hasEuclideanDistance">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/spatial#hasDistance"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#DistanceMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Euclidean distance in meters.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">has euclidean distance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spatial#hasHaversineDistance -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#hasHaversineDistance">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/spatial#hasDistance"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#DistanceMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Haversine distance in meters, accounting for Earth&apos;s curvature.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">has haversine distance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spatial#hasManhattanDistance -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#hasManhattanDistance">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/trajecto/spatial#hasDistance"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#DistanceMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Manhattan distance in meters.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">has manhattan distance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spatial#influenceRadius -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#influenceRadius">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#InfluenceZone"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Radius of the influence zone in meters.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">influence radius</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spatial#proximityRank -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#proximityRank">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#ProximityResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">Rank of proximity (1 = closest) for a trajectory part among all nearby POIs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">proximity rank</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spatial#proximityScore -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#proximityScore">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#ProximityResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Normalized proximity score (0.0-1.0) where 1.0 is highest proximity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">proximity score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spatial#spatialCohesion -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#spatialCohesion">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#SpatialCluster"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Measure of spatial cohesion within the cluster (0.0-1.0).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">spatial cohesion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spatial#withinProximity -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#withinProximity">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spatial#ProximityResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean indicating if the trajectory part is within proximity threshold.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spatial"/>
        <rdfs:label xml:lang="en">within proximity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spatial#zoneRadius -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spatial#zoneRadius">
