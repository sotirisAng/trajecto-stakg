<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://w3id.org/trajecto/events#atPosition
:atPosition rdf:type owl:ObjectProperty ;
            rdfs:domain :TrajectoryEvent ;
            rdfs:range <http://www.datacron-project.eu/datAcron#RawPosition> ;
            rdfs:comment "The position at which the event occurs within the trajectory."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
            rdfs:label "at position"@en .


###  http://w3id.org/trajecto/events#discoveredCategory
:discoveredCategory rdf:type owl:ObjectProperty ;
                    rdfs:domain :CategoryDiscovery ;
                    rdfs:comment "The POI category encountered for the first time at this position."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
                    rdfs:label "discovered category"@en .


###  http://w3id.org/trajecto/events#fromCategory
:fromCategory rdf:type owl:ObjectProperty ;
              rdfs:domain :CategoryTransition ;
              rdfs:comment "The POI category at the preceding position in a category transition."@en ;
              rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
              rdfs:label "from category"@en .


###  http://w3id.org/trajecto/events#fromInteractionType
:fromInteractionType rdf:type owl:ObjectProperty ;
                     rdfs:domain :TrajectoryEvent ;
                     rdfs:comment "The interaction type at the preceding position in an engagement transition event."@en ;
                     rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
                     rdfs:label "from interaction type"@en .


###  http://w3id.org/trajecto/events#toCategory
:toCategory rdf:type owl:ObjectProperty ;
            rdfs:domain :CategoryTransition ;
            rdfs:comment "The POI category at the current position in a category transition."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
            rdfs:label "to category"@en .


###  http://w3id.org/trajecto/events#toInteractionType
:toInteractionType rdf:type owl:ObjectProperty ;
                   rdfs:domain :TrajectoryEvent ;
                   rdfs:comment "The interaction type at the current position in an engagement transition event."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
                   rdfs:label "to interaction type"@en .


#################################################################
#    Data properties
#################################################################

###  http://w3id.org/trajecto/events#eventSequenceIndex
:eventSequenceIndex rdf:type owl:DatatypeProperty ;
                    rdfs:domain :TrajectoryEvent ;
                    rdfs:range xsd:integer ;
                    rdfs:comment "The position index at which the event occurs, corresponding to hasPositionIndex of the associated RawPosition."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
                    rdfs:label "event sequence index"@en .


#################################################################
#    Classes
#################################################################

###  http://w3id.org/trajecto/events#CategoryDiscovery
:CategoryDiscovery rdf:type owl:Class ;
                   rdfs:subClassOf :TrajectoryEvent ;
                   rdfs:comment "First meaningful encounter with a POI category not previously visited in this trajectory. The discoveredCategory property identifies which category was new."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
                   rdfs:label "Category Discovery"@en .


###  http://w3id.org/trajecto/events#CategoryReturn
:CategoryReturn rdf:type owl:Class ;
                rdfs:subClassOf :TrajectoryEvent ;
                rdfs:comment "Return to a previously visited POI category after visiting a different category. Subtype of CategoryTransition where the toCategory was already encountered earlier in the trajectory."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
                rdfs:label "Category Return"@en .


###  http://w3id.org/trajecto/events#CategoryTransition
:CategoryTransition rdf:type owl:Class ;
                    rdfs:subClassOf :TrajectoryEvent ;
                    rdfs:comment "Transition between consecutive meaningful interactions at POIs of different categories. The fromCategory and toCategory properties identify the transition."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
                    rdfs:label "Category Transition"@en .


###  http://w3id.org/trajecto/events#DominantEncounter
:DominantEncounter rdf:type owl:Class ;
                   rdfs:subClassOf :TrajectoryEvent ;
                   rdfs:comment "The position where the trajectory's DominantInteraction (highest engagement, singleton per trajectory) occurs."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
                   rdfs:label "Dominant Encounter"@en .


###  http://w3id.org/trajecto/events#EngagementDrop
:EngagementDrop rdf:type owl:Class ;
                rdfs:subClassOf :TrajectoryEvent ;
                rdfs:comment "Transition from MeaningfulInteraction or ImmersiveInteraction to PassingInteraction at the next position. Indicates disengagement or transit."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
                rdfs:label "Engagement Drop"@en .


###  http://w3id.org/trajecto/events#EngagementEscalation
:EngagementEscalation rdf:type owl:Class ;
                      rdfs:subClassOf :TrajectoryEvent ;
                      rdfs:comment "Transition from PassingInteraction at one position to MeaningfulInteraction or ImmersiveInteraction at the next consecutive position. Indicates increasing engagement with the environment."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
                      rdfs:label "Engagement Escalation"@en .


###  http://w3id.org/trajecto/events#TrajectoryEvent
:TrajectoryEvent rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event> ;
                 rdfs:comment "A behavioral transition or notable occurrence within a trajectory. Detected via SPARQL rules over position sequences and interaction types."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/events> ;
                 rdfs:label "Trajectory Event"@en .


###  http://www.datacron-project.eu/datAcron#RawPosition
<http://www.datacron-project.eu/datAcron#RawPosition> rdf:type owl:Class .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event> rdf:type owl:Class .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :DominantEncounter
                :EngagementDrop
                :EngagementEscalation
              )
] .


