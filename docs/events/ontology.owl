    <owl:Ontology rdf:about="http://w3id.org/trajecto/events">
        <owl:versionIRI rdf:resource="http://w3id.org/trajecto/events/1.1.0"/>
        <owl:imports rdf:resource="http://w3id.org/trajecto/poi"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-29</terms:created>
        <terms:creator>Konstantinos Kotis</terms:creator>
        <terms:creator>Sotirios Angelis</terms:creator>
        <terms:description xml:lang="en">Trajectory events detected by SPARQL rules over the position sequence of a trajectory: engagement escalation and drop, category discovery, transition and return, and the dominant encounter.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:modified>
        <terms:publisher>i-Lab, Department of Cultural Technology and Communication, University of the Aegean</terms:publisher>
        <terms:title xml:lang="en">Trajecto Trajectory Events Module</terms:title>
        <vann:preferredNamespacePrefix>events</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://w3id.org/trajecto/events#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">trajecto-events</rdfs:label>
        <owl:priorVersion rdf:resource="http://w3id.org/trajecto/events/1.0"/>
        <owl:versionInfo>1.1.0</owl:versionInfo>
    </owl:Ontology>
    


