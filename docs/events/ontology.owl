     -->


    


    <!-- http://w3id.org/trajecto/events#eventSequenceIndex -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/events#eventSequenceIndex">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/events#TrajectoryEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The position index at which the event occurs, corresponding to hasPositionIndex of the associated RawPosition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">event sequence index</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto/events#CategoryDiscovery -->


    <owl:Class rdf:about="http://w3id.org/trajecto/events#CategoryDiscovery">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/events#TrajectoryEvent"/>
        <rdfs:comment xml:lang="en">First meaningful encounter with a POI category not previously visited in this trajectory. The discoveredCategory property identifies which category was new.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">Category Discovery</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/events#CategoryReturn -->


    <owl:Class rdf:about="http://w3id.org/trajecto/events#CategoryReturn">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/events#TrajectoryEvent"/>
        <rdfs:comment xml:lang="en">Return to a previously visited POI category after visiting a different category. Subtype of CategoryTransition where the toCategory was already encountered earlier in the trajectory.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">Category Return</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/events#CategoryTransition -->


    <owl:Class rdf:about="http://w3id.org/trajecto/events#CategoryTransition">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/events#TrajectoryEvent"/>
        <rdfs:comment xml:lang="en">Transition between consecutive meaningful interactions at POIs of different categories. The fromCategory and toCategory properties identify the transition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">Category Transition</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/events#DominantEncounter -->


    <owl:Class rdf:about="http://w3id.org/trajecto/events#DominantEncounter">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/events#TrajectoryEvent"/>
        <rdfs:comment xml:lang="en">The position where the trajectory&apos;s DominantInteraction (highest engagement, singleton per trajectory) occurs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">Dominant Encounter</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/events#EngagementDrop -->


    <owl:Class rdf:about="http://w3id.org/trajecto/events#EngagementDrop">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/events#TrajectoryEvent"/>
        <rdfs:comment xml:lang="en">Transition from MeaningfulInteraction or ImmersiveInteraction to PassingInteraction at the next position. Indicates disengagement or transit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">Engagement Drop</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/events#EngagementEscalation -->


    <owl:Class rdf:about="http://w3id.org/trajecto/events#EngagementEscalation">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/events#TrajectoryEvent"/>
        <rdfs:comment xml:lang="en">Transition from PassingInteraction at one position to MeaningfulInteraction or ImmersiveInteraction at the next consecutive position. Indicates increasing engagement with the environment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">Engagement Escalation</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/events#TrajectoryEvent -->


    <owl:Class rdf:about="http://w3id.org/trajecto/events#TrajectoryEvent">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event"/>
        <rdfs:comment xml:lang="en">A behavioral transition or notable occurrence within a trajectory. Detected via SPARQL rules over position sequences and interaction types.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">Trajectory Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.datacron-project.eu/datAcron#RawPosition -->


    <owl:Class rdf:about="http://www.datacron-project.eu/datAcron#RawPosition"/>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event -->


    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event"/>
    


