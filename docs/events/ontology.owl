    <!-- http://w3id.org/trajecto/events#atPosition -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/events#atPosition">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/events#TrajectoryEvent"/>
        <rdfs:range rdf:resource="http://www.datacron-project.eu/datAcron#RawPosition"/>
        <rdfs:comment xml:lang="en">The position at which the event occurs within the trajectory.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">at position</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/events#discoveredCategory -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/events#discoveredCategory">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/events#CategoryDiscovery"/>
        <rdfs:comment xml:lang="en">The POI category encountered for the first time at this position.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">discovered category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/events#fromCategory -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/events#fromCategory">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/events#CategoryTransition"/>
        <rdfs:comment xml:lang="en">The POI category at the preceding position in a category transition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">from category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/events#fromInteractionType -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/events#fromInteractionType">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/events#TrajectoryEvent"/>
        <rdfs:comment xml:lang="en">The interaction type at the preceding position in an engagement transition event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">from interaction type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/events#toCategory -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/events#toCategory">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/events#CategoryTransition"/>
        <rdfs:comment xml:lang="en">The POI category at the current position in a category transition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">to category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/events#toInteractionType -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/events#toInteractionType">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/events#TrajectoryEvent"/>
        <rdfs:comment xml:lang="en">The interaction type at the current position in an engagement transition event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/events"/>
        <rdfs:label xml:lang="en">to interaction type</rdfs:label>
    </owl:ObjectProperty>
    


