            <rdf:Description rdf:about="http://w3id.org/trajecto/events#EngagementDrop"/>
            <rdf:Description rdf:about="http://w3id.org/trajecto/events#EngagementEscalation"/>
        </owl:members>
    </rdf:Description>
</rdf:RDF>



