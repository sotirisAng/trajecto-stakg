###  http://w3id.org/trajecto/profiles#AccommodationVisitor
:AccommodationVisitor rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( <http://www.datacron-project.eu/datAcron#Trajectory>
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://w3id.org/trajecto#includesInteraction> ;
                                                                   owl:someValuesFrom [ owl:intersectionOf ( <http://w3id.org/trajecto/poi#MeaningfulInteraction>
                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                               owl:onProperty <http://w3id.org/trajecto/poi#interactsWith> ;
                                                                                                               owl:someValuesFrom <http://w3id.org/trajecto/poi#Accommodation>
                                                                                                             ]
                                                                                                           ) ;
                                                                                        rdf:type owl:Class
                                                                                      ]
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:comment "A trajectory with at least one meaningful interaction at a poi:Accommodation."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
                      rdfs:label "Accommodation Visitor"@en .


###  http://w3id.org/trajecto/profiles#AfternoonTrajectory
:AfternoonTrajectory rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( <http://www.datacron-project.eu/datAcron#Trajectory>
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://w3id.org/trajecto/context#hasTemporalContext> ;
                                                                  owl:hasValue <http://w3id.org/trajecto/context#Afternoon>
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:comment "A trajectory with temporal context context:Afternoon."@en ;
                     rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
                     rdfs:label "Afternoon Trajectory"@en .


###  http://w3id.org/trajecto/profiles#ArtworkVisitor
:ArtworkVisitor rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( <http://www.datacron-project.eu/datAcron#Trajectory>
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://w3id.org/trajecto#includesInteraction> ;
                                                             owl:someValuesFrom [ owl:intersectionOf ( <http://w3id.org/trajecto/poi#MeaningfulInteraction>
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty <http://w3id.org/trajecto/poi#interactsWith> ;
                                                                                                         owl:someValuesFrom <http://w3id.org/trajecto/poi#Artwork>
                                                                                                       ]
                                                                                                     ) ;
                                                                                  rdf:type owl:Class
                                                                                ]
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:comment "A trajectory with at least one meaningful interaction at a poi:Artwork."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
                rdfs:label "Artwork Visitor"@en .


###  http://w3id.org/trajecto/profiles#BarVisitor
:BarVisitor rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( <http://www.datacron-project.eu/datAcron#Trajectory>
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://w3id.org/trajecto#includesInteraction> ;
                                                         owl:someValuesFrom [ owl:intersectionOf ( <http://w3id.org/trajecto/poi#MeaningfulInteraction>
                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                     owl:onProperty <http://w3id.org/trajecto/poi#interactsWith> ;
                                                                                                     owl:someValuesFrom <http://w3id.org/trajecto/poi#Bar>
                                                                                                   ]
                                                                                                 ) ;
                                                                              rdf:type owl:Class
                                                                            ]
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:comment "A trajectory with at least one meaningful interaction at a poi:Bar."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
            rdfs:label "Bar Visitor"@en .


###  http://w3id.org/trajecto/profiles#BeachVisitor
:BeachVisitor rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( <http://www.datacron-project.eu/datAcron#Trajectory>
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://w3id.org/trajecto#includesInteraction> ;
                                                           owl:someValuesFrom [ owl:intersectionOf ( <http://w3id.org/trajecto/poi#MeaningfulInteraction>
                                                                                                     [ rdf:type owl:Restriction ;
                                                                                                       owl:onProperty <http://w3id.org/trajecto/poi#interactsWith> ;
                                                                                                       owl:someValuesFrom <http://w3id.org/trajecto/poi#Beach>
                                                                                                     ]
                                                                                                   ) ;
                                                                                rdf:type owl:Class
                                                                              ]
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:comment "A trajectory with at least one meaningful interaction at a poi:Beach."@en ;
              rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
              rdfs:label "Beach Visitor"@en .


###  http://w3id.org/trajecto/profiles#CafeVisitor
:CafeVisitor rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( <http://www.datacron-project.eu/datAcron#Trajectory>
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://w3id.org/trajecto#includesInteraction> ;
                                                          owl:someValuesFrom [ owl:intersectionOf ( <http://w3id.org/trajecto/poi#MeaningfulInteraction>
                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty <http://w3id.org/trajecto/poi#interactsWith> ;
                                                                                                      owl:someValuesFrom <http://w3id.org/trajecto/poi#Cafe>
                                                                                                    ]
                                                                                                  ) ;
                                                                               rdf:type owl:Class
                                                                             ]
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:comment "A trajectory with at least one meaningful interaction at a poi:Cafe."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
             rdfs:label "Cafe Visitor"@en .


###  http://w3id.org/trajecto/profiles#CasualToImmersiveArc
:CasualToImmersiveArc rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :HasEngagementEscalation
                                                                 :HasImmersiveInteraction
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://w3id.org/trajecto/patterns#exhibitsPattern> ;
                                                                   owl:hasValue <http://w3id.org/trajecto/patterns#CasualMovement>
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:comment "A casual trajectory (patterns:CasualMovement) with an engagement escalation event and at least one immersive interaction."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
                      rdfs:label "Casual to Immersive Arc"@en .


###  http://w3id.org/trajecto/profiles#CinemaVisitor
:CinemaVisitor rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( <http://www.datacron-project.eu/datAcron#Trajectory>
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://w3id.org/trajecto#includesInteraction> ;
                                                            owl:someValuesFrom [ owl:intersectionOf ( <http://w3id.org/trajecto/poi#MeaningfulInteraction>
                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                        owl:onProperty <http://w3id.org/trajecto/poi#interactsWith> ;
                                                                                                        owl:someValuesFrom <http://w3id.org/trajecto/poi#Cinema>
                                                                                                      ]
                                                                                                    ) ;
                                                                                 rdf:type owl:Class
                                                                               ]
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:comment "A trajectory with at least one meaningful interaction at a poi:Cinema."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
               rdfs:label "Cinema Visitor"@en .


###  http://w3id.org/trajecto/profiles#CommercialCasual
:CommercialCasual rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( <http://www.datacron-project.eu/datAcron#Trajectory>
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://w3id.org/trajecto#hasPurpose> ;
                                                               owl:hasValue <http://w3id.org/trajecto/purpose/skos#CommercialPurpose>
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://w3id.org/trajecto/patterns#exhibitsPattern> ;
                                                               owl:hasValue <http://w3id.org/trajecto/patterns#CasualMovement>
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:comment "A trajectory with purpose purposeskos:CommercialPurpose that exhibits the patterns:CasualMovement navigation pattern."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
                  rdfs:label "Commercial Casual"@en .


###  http://w3id.org/trajecto/profiles#CommercialExplorer
:CommercialExplorer rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( <http://www.datacron-project.eu/datAcron#Trajectory>
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://w3id.org/trajecto#hasPurpose> ;
                                                                 owl:hasValue <http://w3id.org/trajecto/purpose/skos#CommercialPurpose>
                                                               ]
                                                               [ rdf:type owl:Restriction ;
