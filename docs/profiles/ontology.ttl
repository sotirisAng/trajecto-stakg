@prefix : <http://w3id.org/trajecto/profiles#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://w3id.org/trajecto/profiles#> .

<http://w3id.org/trajecto/profiles> rdf:type owl:Ontology ;
                                     owl:versionIRI <http://w3id.org/trajecto/profiles/1.1.0> ;
                                     owl:imports <http://w3id.org/trajecto/context> ,
                                                 <http://w3id.org/trajecto/events> ,
                                                 <http://w3id.org/trajecto/patterns> ,
                                                 <http://w3id.org/trajecto/poi> ,
                                                 <http://w3id.org/trajecto/user> ,
                                                 <http://w3id.org/trajecto/purpose/skos> ;
                                     <http://purl.org/dc/terms/created> "2026-03-29"^^xsd:date ;
                                     <http://purl.org/dc/terms/creator> "Konstantinos Kotis" ,
                                                                        "Sotirios Angelis" ;
                                     <http://purl.org/dc/terms/description> "Trajectory profile classes defined by necessary and sufficient conditions over purpose, navigation pattern, engagement level, interaction types, temporal context and trajectory events. An OWL reasoner assigns them to trajectories."@en ;
                                     <http://purl.org/dc/terms/issued> "2026-10-01"^^xsd:date ;
                                     <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/> ;
                                     <http://purl.org/dc/terms/modified> "2026-10-01"^^xsd:date ;
                                     <http://purl.org/dc/terms/publisher> "i-Lab, Department of Cultural Technology and Communication, University of the Aegean" ;
                                     <http://purl.org/dc/terms/title> "Trajecto Trajectory Profiles Module"@en ;
                                     <http://purl.org/vocab/vann/preferredNamespacePrefix> "profiles" ;
                                     <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/trajecto/profiles#" ;
                                     rdfs:label "trajecto-profiles"@en ;
                                     owl:priorVersion <http://w3id.org/trajecto/profiles/1.0> ;
                                     owl:versionInfo "1.1.0" .

