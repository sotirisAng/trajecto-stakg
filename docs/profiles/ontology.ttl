                     rdfs:label "Weekday Dining Casual"@en .


###  http://w3id.org/trajecto/profiles#WeekdayTrajectory
:WeekdayTrajectory rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( <http://www.datacron-project.eu/datAcron#Trajectory>
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://w3id.org/trajecto/context#hasTemporalContext> ;
                                                                owl:hasValue <http://w3id.org/trajecto/context#Weekday>
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:comment "A trajectory with temporal context context:Weekday."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
                   rdfs:label "Weekday Trajectory"@en .


###  http://w3id.org/trajecto/profiles#WeekendImmersiveDiner
:WeekendImmersiveDiner rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( :HighEngagementTrajectory
                                                                  :ImmersiveDiningVisitor
                                                                  :WeekendTrajectory
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:comment "A trajectory that is a profiles:WeekendTrajectory and a profiles:ImmersiveDiningVisitor and a profiles:HighEngagementTrajectory."@en ;
                       rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
                       rdfs:label "Weekend Immersive Diner"@en .


###  http://w3id.org/trajecto/profiles#WeekendRecreationExplorer
:WeekendRecreationExplorer rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( :RecreationExplorer
                                                                      :WeekendTrajectory
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:comment "A trajectory that is a profiles:WeekendTrajectory and a profiles:RecreationExplorer."@en ;
                           rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
                           rdfs:label "Weekend Recreation Explorer"@en .


###  http://w3id.org/trajecto/profiles#WeekendTrajectory
:WeekendTrajectory rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( <http://www.datacron-project.eu/datAcron#Trajectory>
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://w3id.org/trajecto/context#hasTemporalContext> ;
                                                                owl:hasValue <http://w3id.org/trajecto/context#Weekend>
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:comment "A trajectory with temporal context context:Weekend."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
                   rdfs:label "Weekend Trajectory"@en .


###  http://w3id.org/trajecto/profiles#WinterTrajectory
:WinterTrajectory rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( <http://www.datacron-project.eu/datAcron#Trajectory>
                                                             [ rdf:type owl:Restriction ;
