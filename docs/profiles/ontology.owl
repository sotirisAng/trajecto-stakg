    <!-- http://w3id.org/trajecto/profiles#AccommodationVisitor -->


    <owl:Class rdf:about="http://w3id.org/trajecto/profiles#AccommodationVisitor">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.datacron-project.eu/datAcron#Trajectory"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://w3id.org/trajecto#includesInteraction"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://w3id.org/trajecto/poi#MeaningfulInteraction"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://w3id.org/trajecto/poi#interactsWith"/>
                                        <owl:someValuesFrom rdf:resource="http://w3id.org/trajecto/poi#Accommodation"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">A trajectory with at least one meaningful interaction at a poi:Accommodation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/profiles"/>
        <rdfs:label xml:lang="en">Accommodation Visitor</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/profiles#AfternoonTrajectory -->


    <owl:Class rdf:about="http://w3id.org/trajecto/profiles#AfternoonTrajectory">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.datacron-project.eu/datAcron#Trajectory"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://w3id.org/trajecto/context#hasTemporalContext"/>
                        <owl:hasValue rdf:resource="http://w3id.org/trajecto/context#Afternoon"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">A trajectory with temporal context context:Afternoon.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/profiles"/>
        <rdfs:label xml:lang="en">Afternoon Trajectory</rdfs:label>
    </owl:Class>
    


