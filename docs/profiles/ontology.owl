     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://w3id.org/trajecto/profiles">
        <owl:versionIRI rdf:resource="http://w3id.org/trajecto/profiles/1.1.0"/>
        <owl:imports rdf:resource="http://w3id.org/trajecto/context"/>
        <owl:imports rdf:resource="http://w3id.org/trajecto/events"/>
        <owl:imports rdf:resource="http://w3id.org/trajecto/patterns"/>
        <owl:imports rdf:resource="http://w3id.org/trajecto/poi"/>
        <owl:imports rdf:resource="http://w3id.org/trajecto/user"/>
        <owl:imports rdf:resource="http://w3id.org/trajecto/purpose/skos"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-29</terms:created>
        <terms:creator>Konstantinos Kotis</terms:creator>
        <terms:creator>Sotirios Angelis</terms:creator>
        <terms:description xml:lang="en">Trajectory profile classes defined by necessary and sufficient conditions over purpose, navigation pattern, engagement level, interaction types, temporal context and trajectory events. An OWL reasoner assigns them to trajectories.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:modified>
        <terms:publisher>i-Lab, Department of Cultural Technology and Communication, University of the Aegean</terms:publisher>
        <terms:title xml:lang="en">Trajecto Trajectory Profiles Module</terms:title>
        <vann:preferredNamespacePrefix>profiles</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://w3id.org/trajecto/profiles#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">trajecto-profiles</rdfs:label>
        <owl:priorVersion rdf:resource="http://w3id.org/trajecto/profiles/1.0"/>
        <owl:versionInfo>1.1.0</owl:versionInfo>
    </owl:Ontology>
    


