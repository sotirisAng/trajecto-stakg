    "@language" : "en",
    "@value" : "Dense Spatial Pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/trajecto/patterns#SpatioTemporalPattern"
  } ]
