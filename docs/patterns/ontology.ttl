@prefix : <http://w3id.org/trajecto/patterns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://w3id.org/trajecto/patterns#> .

<http://w3id.org/trajecto/patterns> rdf:type owl:Ontology ;
                                     owl:versionIRI <http://w3id.org/trajecto/patterns/1.1.0> ;
                                     <http://purl.org/dc/terms/created> "2025-05-09"^^xsd:date ;
                                     <http://purl.org/dc/terms/creator> "Konstantinos Kotis" ,
                                                                        "Sotirios Angelis" ;
                                     <http://purl.org/dc/terms/description> "This module extends the trajecto ontology with concepts for analyzing movement patterns and behavior independent of purpose."@en ;
                                     <http://purl.org/dc/terms/issued> "2026-10-01"^^xsd:date ;
                                     <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/> ;
                                     <http://purl.org/dc/terms/modified> "2026-10-01"^^xsd:date ;
                                     <http://purl.org/dc/terms/publisher> "i-Lab, Department of Cultural Technology and Communication, University of the Aegean" ;
                                     <http://purl.org/dc/terms/title> "Trajecto Movement Patterns Module"@en ;
                                     <http://purl.org/vocab/vann/preferredNamespacePrefix> "patterns" ;
                                     <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/trajecto/patterns#" ;
                                     rdfs:label "trajecto-patterns"@en ;
                                     owl:priorVersion <http://w3id.org/trajecto/patterns/1.0> ;
                                     owl:versionInfo "1.1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://w3id.org/trajecto/patterns#exhibitsPattern
:exhibitsPattern rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                 rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                 rdfs:range :MovementPattern ;
                 rdfs:comment "Associates a trajectory with movement patterns it exhibits."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                 rdfs:label "exhibits pattern"@en .


###  http://w3id.org/trajecto/patterns#hasAlternativePath
:hasAlternativePath rdf:type owl:ObjectProperty ;
                    rdfs:domain :DecisionPoint ;
                    rdfs:range :Path ;
                    rdfs:comment "Links a decision point to alternative paths not taken."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                    rdfs:label "has alternative path"@en .


###  http://w3id.org/trajecto/patterns#hasChosenPath
:hasChosenPath rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasAlternativePath ;
               rdfs:domain :DecisionPoint ;
               rdfs:range :Path ;
               rdfs:comment "Links a decision point to the path actually taken."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
               rdfs:label "has chosen path"@en .


###  http://w3id.org/trajecto/patterns#hasDecisionOutcome
:hasDecisionOutcome rdf:type owl:ObjectProperty ;
                    rdfs:domain :DecisionPoint ;
                    rdfs:range :DecisionOutcome ;
                    rdfs:comment "Links a decision point to its outcome."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                    rdfs:label "has decision outcome"@en .


###  http://w3id.org/trajecto/patterns#hasDecisionPoint
:hasDecisionPoint rdf:type owl:ObjectProperty ;
                  rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                  rdfs:range :DecisionPoint ;
                  rdfs:comment "Links a trajectory to decision points within it."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                  rdfs:label "has decision point"@en .


###  http://w3id.org/trajecto/patterns#hasDirectionality
:hasDirectionality rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :exhibitsPattern ;
                   rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                   rdfs:range :DirectionalPattern ;
                   rdfs:comment "Associates a trajectory with its directional pattern."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                   rdfs:label "has directionality"@en .


###  http://w3id.org/trajecto/patterns#hasFocusPattern
:hasFocusPattern rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :exhibitsPattern ;
                 rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                 rdfs:range :FocusPattern ;
                 rdfs:comment "Associates a trajectory with its focus pattern."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                 rdfs:label "has focus pattern"@en .


###  http://w3id.org/trajecto/patterns#hasSegmentType
:hasSegmentType rdf:type owl:ObjectProperty ;
                rdfs:domain <http://www.datacron-project.eu/datAcron#Segment> ;
                rdfs:range :TrajectorySegmentType ;
                rdfs:comment "Classifies a trajectory segment by its behavioral type."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                rdfs:label "has segment type"@en .


###  http://w3id.org/trajecto/patterns#hasVelocityPattern
:hasVelocityPattern rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :exhibitsPattern ;
                    rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                    rdfs:range :VelocityPattern ;
                    rdfs:comment "Associates a trajectory with its velocity pattern."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                    rdfs:label "has velocity pattern"@en .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://w3id.org/trajecto/patterns#hasDecisionTime
:hasDecisionTime rdf:type owl:DatatypeProperty ;
                 rdfs:domain :DecisionPoint ;
                 rdfs:range xsd:duration ;
                 rdfs:comment "Duration of time spent making a decision at a decision point."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                 rdfs:label "has decision time"@en .


###  http://w3id.org/trajecto/patterns#hasDirectionalChanges
:hasDirectionalChanges rdf:type owl:DatatypeProperty ;
                       rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                       rdfs:range xsd:positiveInteger ;
                       rdfs:comment "Number of significant direction changes in a trajectory."@en ;
                       rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                       rdfs:label "has directional changes"@en .


###  http://w3id.org/trajecto/patterns#hasDirectionalStraightness
:hasDirectionalStraightness rdf:type owl:DatatypeProperty ;
                            rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                            rdfs:range xsd:float ;
                            rdfs:comment "A numerical value (0.0-1.0) indicating how straight a trajectory is."@en ;
                            rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                            rdfs:label "has directional straightness"@en .


###  http://w3id.org/trajecto/patterns#hasVelocityVariance
:hasVelocityVariance rdf:type owl:DatatypeProperty ;
                     rdfs:domain <http://www.datacron-project.eu/datAcron#Trajectory> ;
                     rdfs:range xsd:float ;
                     rdfs:comment "A numerical value indicating the variance in velocity during a trajectory."@en ;
                     rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                     rdfs:label "has velocity variance"@en .


#################################################################
#    Classes
#################################################################

###  http://w3id.org/trajecto#Stop
<http://w3id.org/trajecto#Stop> rdf:type owl:Class .


###  http://w3id.org/trajecto/patterns#AcceleratingDecelerating
:AcceleratingDecelerating rdf:type owl:Class ;
                          rdfs:subClassOf :VelocityPattern ;
                          rdfs:comment "Regular patterns of acceleration and deceleration."@en ;
                          rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                          rdfs:label "Accelerating Decelerating"@en .


###  http://w3id.org/trajecto/patterns#AvoidanceSegment
:AvoidanceSegment rdf:type owl:Class ;
                  rdfs:subClassOf :TrajectorySegmentType ;
                  rdfs:comment "Segment characterized by movement to avoid an area or obstacle."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                  rdfs:label "Avoidance Segment"@en .


###  http://w3id.org/trajecto/patterns#Backtrack
:Backtrack rdf:type owl:Class ;
           rdfs:subClassOf :DecisionOutcome ;
           rdfs:comment "Decision to return along the previous path."@en ;
           rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
           rdfs:label "Backtrack"@en .


###  http://w3id.org/trajecto/patterns#BacktrackingMovement
:BacktrackingMovement rdf:type owl:Class ;
                      rdfs:subClassOf :FocusPattern ;
                      rdfs:comment "Movement that involves returning along previously traveled paths."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                      rdfs:label "Backtracking Movement"@en .


###  http://w3id.org/trajecto/patterns#BehavioralPattern
:BehavioralPattern rdf:type owl:Class ;
                   rdfs:subClassOf :MovementPattern ;
                   rdfs:comment "Pattern in the behavioral characteristics of movement."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                   rdfs:label "Behavioral Pattern"@en .


###  http://w3id.org/trajecto/patterns#BriefDwell
:BriefDwell rdf:type owl:Class ;
            rdfs:subClassOf :DwellPattern ;
            rdfs:comment "Short stays at many points of interest."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
            rdfs:label "Brief Dwell"@en .


###  http://w3id.org/trajecto/patterns#CasualMovement
:CasualMovement rdf:type owl:Class ;
                rdfs:subClassOf :FocusPattern ;
                rdfs:comment "Relaxed, low-speed movement without focused engagement."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                rdfs:label "Casual Movement"@en .


###  http://w3id.org/trajecto/patterns#ChangeDirection
:ChangeDirection rdf:type owl:Class ;
                 rdfs:subClassOf :DecisionOutcome ;
                 rdfs:comment "Decision to change direction."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                 rdfs:label "Change Direction"@en .


###  http://w3id.org/trajecto/patterns#ChoicePoint
:ChoicePoint rdf:type owl:Class ;
             rdfs:subClassOf :DecisionPoint ;
             rdfs:comment "A decision point with multiple clear options available."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
             rdfs:label "Choice Point"@en .


###  http://w3id.org/trajecto/patterns#CircularReturn
:CircularReturn rdf:type owl:Class ;
                rdfs:subClassOf :DirectionalPattern ;
                rdfs:comment "Circular movement pattern returning to the starting point."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                rdfs:label "Circular Return"@en .


###  http://w3id.org/trajecto/patterns#ClusteredVisit
:ClusteredVisit rdf:type owl:Class ;
                rdfs:subClassOf :VisitPattern ;
                rdfs:comment "Visiting clusters of points of interest together."@en ;
                rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                rdfs:label "Clustered Visit"@en .


###  http://w3id.org/trajecto/patterns#CoherentGroupMovement
:CoherentGroupMovement rdf:type owl:Class ;
                       rdfs:subClassOf :GroupMovementPattern ;
                       rdfs:comment "Group moving together with high cohesion."@en ;
                       rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                       rdfs:label "Coherent Group Movement"@en .


###  http://w3id.org/trajecto/patterns#Consistent
:Consistent rdf:type owl:Class ;
            rdfs:subClassOf :VelocityPattern ;
            rdfs:comment "Consistent, steady velocity throughout movement."@en ;
            rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
            rdfs:label "Consistent"@en .


###  http://w3id.org/trajecto/patterns#ContinueForward
:ContinueForward rdf:type owl:Class ;
                 rdfs:subClassOf :DecisionOutcome ;
                 rdfs:comment "Decision to continue in the current direction."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                 rdfs:label "Continue Forward"@en .


###  http://w3id.org/trajecto/patterns#CyclicalPattern
:CyclicalPattern rdf:type owl:Class ;
                 rdfs:subClassOf :SpatioTemporalPattern ;
                 rdfs:comment "Pattern with regular repetition over time."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                 rdfs:label "Cyclical Pattern"@en .


###  http://w3id.org/trajecto/patterns#DecisionOutcome
:DecisionOutcome rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract> ;
                 rdfs:comment "The outcome of a decision at a decision point."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                 rdfs:label "Decision Outcome"@en .


###  http://w3id.org/trajecto/patterns#DecisionPoint
:DecisionPoint rdf:type owl:Class ;
               rdfs:subClassOf <http://w3id.org/trajecto#Stop> ;
               rdfs:comment "A point in a trajectory where a decision is made about movement."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
               rdfs:label "Decision Point"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A specific location in a trajectory where a movement decision is made, often characterized by a change in direction, speed, or behavior."@en .


###  http://w3id.org/trajecto/patterns#DenseSpatialPattern
:DenseSpatialPattern rdf:type owl:Class ;
                     rdfs:subClassOf :SpatioTemporalPattern ;
                     rdfs:comment "Pattern where movement is concentrated in a small area."@en ;
                     rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                     rdfs:label "Dense Spatial Pattern"@en .


###  http://w3id.org/trajecto/patterns#DenseTimePattern
:DenseTimePattern rdf:type owl:Class ;
                  rdfs:subClassOf :SpatioTemporalPattern ;
                  rdfs:comment "Pattern where much activity occurs in a short time span."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                  rdfs:label "Dense Time Pattern"@en .


###  http://w3id.org/trajecto/patterns#DirectionalPattern
:DirectionalPattern rdf:type owl:Class ;
                    rdfs:subClassOf :MovementPattern ;
                    rdfs:comment "Pattern in the directionality of movement."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                    rdfs:label "Directional Pattern"@en .


###  http://w3id.org/trajecto/patterns#DispersedSpatialPattern
:DispersedSpatialPattern rdf:type owl:Class ;
                         rdfs:subClassOf :SpatioTemporalPattern ;
                         rdfs:comment "Pattern where movement is dispersed over a large area."@en ;
                         rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                         rdfs:label "Dispersed Spatial Pattern"@en .


###  http://w3id.org/trajecto/patterns#DwellPattern
:DwellPattern rdf:type owl:Class ;
              rdfs:subClassOf :BehavioralPattern ;
              rdfs:comment "Pattern in how long a visitor stays at points of interest."@en ;
              rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
              rdfs:label "Dwell Pattern"@en .


###  http://w3id.org/trajecto/patterns#ExplorationSegment
:ExplorationSegment rdf:type owl:Class ;
                    rdfs:subClassOf :TrajectorySegmentType ;
                    rdfs:comment "Segment characterized by exploratory behavior."@en ;
                    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                    rdfs:label "Exploration Segment"@en .


###  http://w3id.org/trajecto/patterns#ExploratoryMovement
:ExploratoryMovement rdf:type owl:Class ;
                     rdfs:subClassOf :FocusPattern ;
                     rdfs:comment "Movement focused on exploration without specific destinations."@en ;
                     rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                     rdfs:label "Exploratory Movement"@en .


###  http://w3id.org/trajecto/patterns#ExternalInterruptionPoint
:ExternalInterruptionPoint rdf:type owl:Class ;
                           rdfs:subClassOf :DecisionPoint ;
                           rdfs:comment "A decision point caused by external interruption (call, message, encounter)."@en ;
                           rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                           rdfs:label "External Interruption Point"@en .


###  http://w3id.org/trajecto/patterns#FastPaced
:FastPaced rdf:type owl:Class ;
           rdfs:subClassOf :PacePattern ;
           rdfs:comment "Consistently fast movement throughout a trajectory."@en ;
           rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
           rdfs:label "Fast Paced"@en .


###  http://w3id.org/trajecto/patterns#Fluctuating
:Fluctuating rdf:type owl:Class ;
             rdfs:subClassOf :VelocityPattern ;
             rdfs:comment "Fluctuating velocity with irregular changes."@en ;
             rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
             rdfs:label "Fluctuating"@en .


###  http://w3id.org/trajecto/patterns#FocusPattern
:FocusPattern rdf:type owl:Class ;
              rdfs:subClassOf :MovementPattern ;
              rdfs:comment "Pattern in the focus or intention of movement."@en ;
              rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
              rdfs:label "Focus Pattern"@en .


###  http://w3id.org/trajecto/patterns#FocusedDwell
:FocusedDwell rdf:type owl:Class ;
              rdfs:subClassOf :DwellPattern ;
              rdfs:comment "Long stays at a few key points of interest."@en ;
              rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
              rdfs:label "Focused Dwell"@en .


###  http://w3id.org/trajecto/patterns#GroupMovementPattern
:GroupMovementPattern rdf:type owl:Class ;
                      rdfs:subClassOf :MovementPattern ;
                      rdfs:comment "Pattern in the movement of groups of individuals."@en ;
                      rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                      rdfs:label "Group Movement Pattern"@en .


###  http://w3id.org/trajecto/patterns#HesitationSegment
:HesitationSegment rdf:type owl:Class ;
                   rdfs:subClassOf :TrajectorySegmentType ;
                   rdfs:comment "Segment characterized by hesitation or indecision."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                   rdfs:label "Hesitation Segment"@en .


###  http://w3id.org/trajecto/patterns#ImmersiveMovement
:ImmersiveMovement rdf:type owl:Class ;
                   rdfs:subClassOf :FocusPattern ;
                   rdfs:comment "Movement dominated by prolonged, immersive engagement with points of interest."@en ;
                   rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                   rdfs:label "Immersive Movement"@en .


###  http://w3id.org/trajecto/patterns#IndependentGroupMovement
:IndependentGroupMovement rdf:type owl:Class ;
                          rdfs:subClassOf :GroupMovementPattern ;
                          rdfs:comment "Group members moving independently within a larger area."@en ;
                          rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                          rdfs:label "Independent Group Movement"@en .


###  http://w3id.org/trajecto/patterns#InformationSeekingPoint
:InformationSeekingPoint rdf:type owl:Class ;
                         rdfs:subClassOf :DecisionPoint ;
                         rdfs:comment "A decision point where information is sought to inform movement."@en ;
                         rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                         rdfs:label "Information Seeking Point"@en .


###  http://w3id.org/trajecto/patterns#IrregularPace
:IrregularPace rdf:type owl:Class ;
               rdfs:subClassOf :PacePattern ;
               rdfs:comment "Unpredictable changes in pace throughout a trajectory."@en ;
               rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
               rdfs:label "Irregular Pace"@en .


###  http://w3id.org/trajecto/patterns#Junction
:Junction rdf:type owl:Class ;
          rdfs:subClassOf :ChoicePoint ;
          rdfs:comment "A physical junction where multiple paths meet."@en ;
          rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
          rdfs:label "Junction"@en .


###  http://w3id.org/trajecto/patterns#LeaderFollowerMovement
:LeaderFollowerMovement rdf:type owl:Class ;
                        rdfs:subClassOf :GroupMovementPattern ;
                        rdfs:comment "Group following a leader who determines the movement path."@en ;
                        rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                        rdfs:label "Leader Follower Movement"@en .


###  http://w3id.org/trajecto/patterns#Linear
:Linear rdf:type owl:Class ;
        rdfs:subClassOf :DirectionalPattern ;
        rdfs:comment "Linear, direct movement pattern."@en ;
        rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
        rdfs:label "Linear"@en .


###  http://w3id.org/trajecto/patterns#LingeringSegment
:LingeringSegment rdf:type owl:Class ;
                  rdfs:subClassOf :TrajectorySegmentType ;
                  rdfs:comment "Segment characterized by prolonged stay in one area."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                  rdfs:label "Lingering Segment"@en .


###  http://w3id.org/trajecto/patterns#MapCheckingPoint
:MapCheckingPoint rdf:type owl:Class ;
                  rdfs:subClassOf :InformationSeekingPoint ;
                  rdfs:comment "A point where a map or navigation aid is consulted."@en ;
                  rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
                  rdfs:label "Map Checking Point"@en .


###  http://w3id.org/trajecto/patterns#MovementPattern
:MovementPattern rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract> ;
                 rdfs:comment "A recognizable pattern in movement behavior."@en ;
                 rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
