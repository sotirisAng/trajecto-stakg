    <!-- http://w3id.org/trajecto/spaces#VisitContext -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#VisitContext">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Situation"/>
