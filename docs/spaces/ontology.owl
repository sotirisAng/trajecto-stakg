    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#HistoricalSite -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#HistoricalSite">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#CulturalSpace"/>
