<?xml version="1.0"?>
<rdf:RDF xmlns="http://w3id.org/trajecto/spaces#"
     xml:base="http://w3id.org/trajecto/spaces"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://w3id.org/trajecto/spaces">
        <owl:versionIRI rdf:resource="http://w3id.org/trajecto/spaces/1.1.0"/>
        <owl:imports rdf:resource="http://w3id.org/trajecto/purpose"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-09</terms:created>
        <terms:creator>Konstantinos Kotis</terms:creator>
        <terms:creator>Sotirios Angelis</terms:creator>
        <terms:description xml:lang="en">This module extends the trajecto ontology with cultural spaces and commercial spaces concepts for semantic trajectories.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</terms:modified>
        <terms:publisher>i-Lab, Department of Cultural Technology and Communication, University of the Aegean</terms:publisher>
        <terms:title xml:lang="en">Trajecto Spaces Module</terms:title>
        <vann:preferredNamespacePrefix>spaces</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://w3id.org/trajecto/spaces#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">trajecto-spaces</rdfs:label>
        <owl:priorVersion rdf:resource="http://w3id.org/trajecto/spaces/1.0"/>
        <owl:versionInfo>1.1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#example -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#example"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#duration -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto/spaces#containsEntity -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spaces#containsEntity">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasPart"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#Space"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto#EntityOfInterest"/>
        <rdfs:comment xml:lang="en">Relates a space to entities it contains.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">contains entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spaces#exhibits -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spaces#exhibits">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#CulturalSpace"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spaces#CulturalArtifact"/>
        <rdfs:comment xml:lang="en">Relates a cultural space to artifacts it exhibits.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">exhibits</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasCommercialIntent -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spaces#hasCommercialIntent">
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spaces#CommercialIntent"/>
        <rdfs:comment xml:lang="en">Links a trajectory part to commercial intent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has commercial intent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasCulturalSignificance -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spaces#hasCulturalSignificance">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/trajecto/spaces#CulturalArtifact"/>
                    <rdf:Description rdf:about="http://w3id.org/trajecto/spaces#CulturalSpace"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spaces#CulturalSignificance"/>
        <rdfs:comment xml:lang="en">Links a cultural entity to its significance information.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has cultural significance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasEntrance -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spaces#hasEntrance">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#Space"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spaces#AccessPoint"/>
        <rdfs:comment xml:lang="en">Relates a space to its entrance points.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has entrance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasExhibitMetadata -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spaces#hasExhibitMetadata">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#CulturalArtifact"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spaces#ExhibitMetadata"/>
        <rdfs:comment xml:lang="en">Links a cultural artifact to its metadata information.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has exhibit metadata</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasExit -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spaces#hasExit">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#Space"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spaces#AccessPoint"/>
        <rdfs:comment xml:lang="en">Relates a space to its exit points.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has exit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasTransactionEvent -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spaces#hasTransactionEvent">
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#TrajectoryPart"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spaces#TransactionEvent"/>
        <rdfs:comment xml:lang="en">Links a trajectory part to a transaction event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has transaction event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasVisitContext -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spaces#hasVisitContext">
        <rdfs:domain rdf:resource="http://www.datacron-project.eu/datAcron#Trajectory"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spaces#VisitContext"/>
        <rdfs:comment xml:lang="en">Links a trajectory to the context of the visit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has visit context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasZone -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spaces#hasZone">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasPart"/>
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#Space"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spaces#Zone"/>
        <rdfs:comment xml:lang="en">Relates a space to its constituent zones or areas.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has zone</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spaces#isLocationOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spaces#isLocationOf">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#Space"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto#EventOfInterest"/>
        <rdfs:comment xml:lang="en">Relates a space to events that take place there.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">is location of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spaces#providesService -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spaces#providesService">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#ServiceSpace"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spaces#Service"/>
        <rdfs:comment xml:lang="en">Relates a service space to services it provides.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">provides service</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/trajecto/spaces#sells -->


    <owl:ObjectProperty rdf:about="http://w3id.org/trajecto/spaces#sells">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#RetailSpace"/>
        <rdfs:range rdf:resource="http://w3id.org/trajecto/spaces#Product"/>
        <rdfs:comment xml:lang="en">Relates a retail space to products it sells.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">sells</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasPart -->


    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasPart"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto/spaces#hasAccessibility -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spaces#hasAccessibility">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#Space"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Accessibility features of a space.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has accessibility</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasArtist -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spaces#hasArtist">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#CulturalArtifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Artist or creator of a cultural artifact.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has artist</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasCapacity -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spaces#hasCapacity">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#Space"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">Maximum capacity of a space in terms of people.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has capacity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasCreationDate -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spaces#hasCreationDate">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#CulturalArtifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date when a cultural artifact was created.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has creation date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasExhibitID -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spaces#hasExhibitID">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#CulturalArtifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Identifier for a cultural artifact in an exhibition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has exhibit ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasOpeningHours -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spaces#hasOpeningHours">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#CommercialSpace"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Opening hours of a commercial space.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has opening hours</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasPrice -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spaces#hasPrice">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/trajecto/spaces#Product"/>
                    <rdf:Description rdf:about="http://w3id.org/trajecto/spaces#Service"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Price of a product or service.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasProductCategory -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spaces#hasProductCategory">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Category of a product.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has product category</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasTransactionAmount -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spaces#hasTransactionAmount">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#TransactionEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Amount of money involved in a transaction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has transaction amount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/trajecto/spaces#hasVisitDuration -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/trajecto/spaces#hasVisitDuration">
        <rdfs:domain rdf:resource="http://w3id.org/trajecto/spaces#VisitContext"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment xml:lang="en">Duration of a visit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">has visit duration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/trajecto#EntityOfInterest -->


    <owl:Class rdf:about="http://w3id.org/trajecto#EntityOfInterest"/>
    


    <!-- http://w3id.org/trajecto#EventOfInterest -->


    <owl:Class rdf:about="http://w3id.org/trajecto#EventOfInterest"/>
    


    <!-- http://w3id.org/trajecto#Interaction -->


    <owl:Class rdf:about="http://w3id.org/trajecto#Interaction"/>
    


    <!-- http://w3id.org/trajecto#ObjectOfInterest -->


    <owl:Class rdf:about="http://w3id.org/trajecto#ObjectOfInterest"/>
    


    <!-- http://w3id.org/trajecto#PointOfInterest -->


    <owl:Class rdf:about="http://w3id.org/trajecto#PointOfInterest"/>
    


    <!-- http://w3id.org/trajecto#RegionOfInterest -->


    <owl:Class rdf:about="http://w3id.org/trajecto#RegionOfInterest"/>
    


    <!-- http://w3id.org/trajecto/spaces#AccessPoint -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#AccessPoint">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto#PointOfInterest"/>
        <rdfs:comment xml:lang="en">A point where a space can be entered or exited.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Access Point</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#ArtifactEngagement -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#ArtifactEngagement">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#CulturalInteraction"/>
        <rdfs:comment xml:lang="en">Direct engagement with a cultural artifact.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Artifact Engagement</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#Artwork -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#Artwork">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#CulturalArtifact"/>
        <rdfs:comment xml:lang="en">A creative work of art.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Artwork</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#Browsing -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#Browsing">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#CommercialInteraction"/>
        <rdfs:comment xml:lang="en">Looking at products without necessarily intending to purchase.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Browsing</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#BrowsingIntent -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#BrowsingIntent">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#CommercialIntent"/>
        <rdfs:comment xml:lang="en">Intent to browse without specific purchase plans.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Browsing Intent</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#Checkout -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#Checkout">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#Zone"/>
        <rdfs:comment xml:lang="en">Area where purchases are processed and paid for.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Checkout</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#CommercialIntent -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#CommercialIntent">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract"/>
        <rdfs:comment xml:lang="en">The intended purpose behind a commercial visit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Commercial Intent</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#CommercialInteraction -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#CommercialInteraction">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto#Interaction"/>
        <rdfs:comment xml:lang="en">Interaction in a commercial context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Commercial Interaction</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#CommercialSpace -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#CommercialSpace">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#Space"/>
        <rdfs:comment xml:lang="en">A space dedicated to commercial activities such as retail, services, or dining.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Commercial Space</rdfs:label>
        <skos:definition xml:lang="en">A designated space where commercial transactions and activities take place.</skos:definition>
        <skos:example xml:lang="en">Shops, malls, restaurants, banks</skos:example>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#CulturalArtifact -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#CulturalArtifact">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto#ObjectOfInterest"/>
        <rdfs:comment xml:lang="en">A physical object of cultural significance or value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Cultural Artifact</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#CulturalInteraction -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#CulturalInteraction">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto#Interaction"/>
        <rdfs:comment xml:lang="en">Interaction with cultural artifacts or in cultural contexts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Cultural Interaction</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#CulturalLandmark -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#CulturalLandmark">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#CulturalSpace"/>
        <rdfs:comment xml:lang="en">A recognizable cultural feature of a landscape or cityscape.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Cultural Landmark</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#CulturalSignificance -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#CulturalSignificance">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Abstract"/>
        <rdfs:comment xml:lang="en">Information about the cultural importance or value of an entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Cultural Significance</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#CulturalSpace -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#CulturalSpace">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#Space"/>
        <rdfs:comment xml:lang="en">A space dedicated to cultural activities, exhibitions, or performances.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Cultural Space</rdfs:label>
        <skos:definition xml:lang="en">A designated space where cultural artifacts are exhibited or cultural events take place.</skos:definition>
        <skos:example xml:lang="en">Museums, galleries, theaters, historical sites</skos:example>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#Department -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#Department">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#Zone"/>
        <rdfs:comment xml:lang="en">A section of a retail space dedicated to a specific category of products.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Department</rdfs:label>
    </owl:Class>
    


