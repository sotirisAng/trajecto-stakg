        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Self Directed Visit</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#Service -->


