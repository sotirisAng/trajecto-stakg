        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Retail Space</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#RetailStore -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#RetailStore">
