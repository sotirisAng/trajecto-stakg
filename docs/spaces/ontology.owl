        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Thematic Visit</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#TransactionEvent -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#TransactionEvent">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto#EventOfInterest"/>
        <rdfs:comment xml:lang="en">An event involving a commercial transaction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Transaction Event</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#Viewing -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#Viewing">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#ArtifactEngagement"/>
        <rdfs:comment xml:lang="en">Looking at or observing a cultural artifact.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Viewing</rdfs:label>
