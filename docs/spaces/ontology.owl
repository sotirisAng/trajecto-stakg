        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Digital Installation</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#DiningEstablishment -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#DiningEstablishment">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#DiningSpace"/>
