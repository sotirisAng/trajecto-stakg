        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Service Intent</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#ServiceProvider -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#ServiceProvider">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#ServiceSpace"/>
        <rdfs:comment xml:lang="en">An establishment providing specific services (banking, healthcare, etc.).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Service Provider</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#ServiceSpace -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#ServiceSpace">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#CommercialSpace"/>
        <rdfs:comment xml:lang="en">A commercial space dedicated to providing services.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Service Space</rdfs:label>
    </owl:Class>
    


