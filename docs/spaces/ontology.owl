        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Dining Establishment</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#DiningSpace -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#DiningSpace">
