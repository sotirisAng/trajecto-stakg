        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Shopping Mall</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#SocialLearning -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#SocialLearning">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto/spaces#CulturalInteraction"/>
        <rdfs:comment xml:lang="en">Learning through social interaction in a cultural context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Social Learning</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#Space -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#Space">
        <rdfs:subClassOf rdf:resource="http://w3id.org/trajecto#RegionOfInterest"/>
