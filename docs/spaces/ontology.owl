        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Space</rdfs:label>
        <skos:definition xml:lang="en">A physical or conceptual area where human movement and activities take place, characterized by boundaries and internal organization.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#ThematicVisit -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#ThematicVisit">
