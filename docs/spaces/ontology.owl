        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Purchase Intent</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#Reading -->


