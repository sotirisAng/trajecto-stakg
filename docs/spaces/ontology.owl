        <rdfs:isDefinedBy rdf:resource="http://w3id.org/trajecto/spaces"/>
        <rdfs:label xml:lang="en">Service Consumption</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/trajecto/spaces#ServiceIntent -->


    <owl:Class rdf:about="http://w3id.org/trajecto/spaces#ServiceIntent">
