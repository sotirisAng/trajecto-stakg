:rules_000 a void:Dataset;
    void:exampleResource :map_trajectory_000.
:map_trajectory_000 rml:logicalSource :source_000.
:source_000 a rml:LogicalSource;
    rml:source "../bird/files/csv/bird_trajectories.csv";
    rml:referenceFormulation ql:CSV.
:map_trajectory_000 a rr:TriplesMap;
    rdfs:label "trajectory".
:s_000 a rr:SubjectMap.
:map_trajectory_000 rr:subjectMap :s_000.
:s_000 rr:template "http://w3id.org/trajecto#trajectory_{traj_id}".
:pom_000 a rr:PredicateObjectMap.
:map_trajectory_000 rr:predicateObjectMap :pom_000.
:pm_000 a rr:PredicateMap.
:pom_000 rr:predicateMap :pm_000.
:pm_000 rr:constant rdf:type.
:pom_000 rr:objectMap :om_000.
:om_000 a rr:ObjectMap;
    rr:constant datacron:Trajectory;
    rr:termType rr:IRI.
:pom_001 a rr:PredicateObjectMap.
:map_trajectory_000 rr:predicateObjectMap :pom_001.
:pm_001 a rr:PredicateMap.
:pom_001 rr:predicateMap :pm_001.
:pm_001 rr:constant rdfs:label.
:pom_001 rr:objectMap :om_001.
:om_001 a rr:ObjectMap;
    rr:template "Trajectory {traj_id}";
    rr:termType rr:Literal.
