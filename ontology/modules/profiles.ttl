                        owl:hasValue patterns:ImmersiveMovement ;
                        owl:onProperty patterns:exhibitsPattern ] ) ] .

profiles:DiningTargeted a owl:Class ;
    rdfs:label "Dining Targeted"@en ;
    rdfs:comment "A trajectory with purpose purposeskos:DiningExperience that exhibits the patterns:TargetedSegment navigation pattern."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:hasValue purposeskos:DiningExperience ;
                        owl:onProperty trajecto:hasPurpose ] [ a owl:Restriction ;
                        owl:hasValue patterns:TargetedSegment ;
                        owl:onProperty patterns:exhibitsPattern ] ) ] .

profiles:DiscoveryDrivenArc a owl:Class ;
    rdfs:label "Discovery Driven Arc"@en ;
    rdfs:comment "An exploratory trajectory (patterns:ExploratoryMovement) with at least two category discovery events."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass events:CategoryDiscovery ;
                        owl:onProperty trajecto:hasEvent ] [ a owl:Restriction ;
                        owl:hasValue patterns:ExploratoryMovement ;
                        owl:onProperty patterns:exhibitsPattern ] ) ] .

profiles:EducationalVisitor a owl:Class ;
    rdfs:label "Educational Visitor"@en ;
    rdfs:comment "A trajectory with at least one meaningful interaction at a poi:Educational."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:onProperty trajecto:includesInteraction ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( poi:MeaningfulInteraction [ a owl:Restriction ;
                                            owl:onProperty poi:interactsWith ;
                                            owl:someValuesFrom poi:Educational ] ) ] ] ) ] .

profiles:EngagementFocusedArc a owl:Class ;
    rdfs:label "Engagement Focused Arc"@en ;
    rdfs:comment "A trajectory that is a profiles:HighEngagementTrajectory and a profiles:HasDominantEncounter."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( profiles:HighEngagementTrajectory profiles:HasDominantEncounter ) ] .

profiles:EntertainmentFocusedTrajectory a owl:Class ;
    rdfs:label "Entertainment Focused Trajectory"@en ;
    rdfs:comment "A trajectory with at least three meaningful interactions at entertainment POIs (NightlifeFacility, Bar, Nightclub, PerformanceVenue, Cinema, Theater, Entertainment)."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                        owl:onClass [ a owl:Class ;
                                owl:intersectionOf ( poi:MeaningfulInteraction [ a owl:Restriction ;
                                            owl:onProperty poi:interactsWith ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:unionOf ( poi:NightlifeFacility poi:Bar poi:Nightclub poi:PerformanceVenue poi:Cinema poi:Theater poi:Entertainment ) ] ] ) ] ;
                        owl:onProperty trajecto:includesInteraction ] ) ] .

profiles:EntertainmentVisitor a owl:Class ;
    rdfs:label "Entertainment Visitor"@en ;
    rdfs:comment "A trajectory with at least one meaningful interaction at a poi:Entertainment."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:onProperty trajecto:includesInteraction ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( poi:MeaningfulInteraction [ a owl:Restriction ;
                                            owl:onProperty poi:interactsWith ;
                                            owl:someValuesFrom poi:Entertainment ] ) ] ] ) ] .

profiles:EveningRecreationTargeted a owl:Class ;
    rdfs:label "Evening Recreation Targeted"@en ;
    rdfs:comment "A trajectory that is a profiles:EveningTrajectory and a profiles:RecreationTargeted."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( profiles:EveningTrajectory profiles:RecreationTargeted ) ] .

profiles:EveningTrajectory a owl:Class ;
    rdfs:label "Evening Trajectory"@en ;
    rdfs:comment "A trajectory with temporal context context:Evening."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:hasValue context:Evening ;
                        owl:onProperty context:hasTemporalContext ] ) ] .

profiles:ExhibitVisitor a owl:Class ;
    rdfs:label "Exhibit Visitor"@en ;
    rdfs:comment "A trajectory with at least one meaningful interaction at a poi:Exhibit."@en ;
