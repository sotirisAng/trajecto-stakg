                        owl:hasValue purposeskos:CommercialPurpose ;
                        owl:onProperty trajecto:hasPurpose ] [ a owl:Restriction ;
                        owl:hasValue patterns:ExploratoryMovement ;
                        owl:onProperty patterns:exhibitsPattern ] ) ] .

profiles:CommercialImmersive a owl:Class ;
    rdfs:label "Commercial Immersive"@en ;
    rdfs:comment "A trajectory with purpose purposeskos:CommercialPurpose that exhibits the patterns:ImmersiveMovement navigation pattern."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
