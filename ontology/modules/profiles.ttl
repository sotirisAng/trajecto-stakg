profiles:FoodCourtVisitor a owl:Class ;
    rdfs:label "Food Court Visitor"@en ;
    rdfs:comment "A trajectory with at least one meaningful interaction at a poi:FoodCourt."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
