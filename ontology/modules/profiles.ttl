    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:onProperty trajecto:includesInteraction ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( poi:MeaningfulInteraction [ a owl:Restriction ;
                                            owl:onProperty poi:interactsWith ;
                                            owl:someValuesFrom poi:Commercial ] ) ] ] ) ] .

profiles:CulturalCasual a owl:Class ;
    rdfs:label "Cultural Casual"@en ;
    rdfs:comment "A trajectory with purpose purposeskos:CulturalPurpose that exhibits the patterns:CasualMovement navigation pattern."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:hasValue purposeskos:CulturalPurpose ;
                        owl:onProperty trajecto:hasPurpose ] [ a owl:Restriction ;
                        owl:hasValue patterns:CasualMovement ;
                        owl:onProperty patterns:exhibitsPattern ] ) ] .

profiles:CulturalExplorer a owl:Class ;
    rdfs:label "Cultural Explorer"@en ;
    rdfs:comment "A trajectory with purpose purposeskos:CulturalPurpose that exhibits the patterns:ExploratoryMovement navigation pattern."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:hasValue purposeskos:CulturalPurpose ;
                        owl:onProperty trajecto:hasPurpose ] [ a owl:Restriction ;
                        owl:hasValue patterns:ExploratoryMovement ;
                        owl:onProperty patterns:exhibitsPattern ] ) ] .

profiles:CulturalFocusedTrajectory a owl:Class ;
    rdfs:label "Cultural Focused Trajectory"@en ;
    rdfs:comment "A trajectory with at least three meaningful interactions at cultural POIs (Artwork, Exhibit, Gallery, Museum, Cultural)."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                        owl:onClass [ a owl:Class ;
                                owl:intersectionOf ( poi:MeaningfulInteraction [ a owl:Restriction ;
                                            owl:onProperty poi:interactsWith ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:unionOf ( poi:Artwork poi:Exhibit poi:Gallery poi:Museum poi:Cultural ) ] ] ) ] ;
                        owl:onProperty trajecto:includesInteraction ] ) ] .

profiles:CulturalImmersive a owl:Class ;
    rdfs:label "Cultural Immersive"@en ;
    rdfs:comment "A trajectory with purpose purposeskos:CulturalPurpose that exhibits the patterns:ImmersiveMovement navigation pattern."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:hasValue purposeskos:CulturalPurpose ;
                        owl:onProperty trajecto:hasPurpose ] [ a owl:Restriction ;
                        owl:hasValue patterns:ImmersiveMovement ;
                        owl:onProperty patterns:exhibitsPattern ] ) ] .

profiles:CulturalTargeted a owl:Class ;
    rdfs:label "Cultural Targeted"@en ;
    rdfs:comment "A trajectory with purpose purposeskos:CulturalPurpose that exhibits the patterns:TargetedSegment navigation pattern."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:hasValue purposeskos:CulturalPurpose ;
                        owl:onProperty trajecto:hasPurpose ] [ a owl:Restriction ;
                        owl:hasValue patterns:TargetedSegment ;
                        owl:onProperty patterns:exhibitsPattern ] ) ] .

profiles:CulturalVisitor a owl:Class ;
    rdfs:label "Cultural Visitor"@en ;
    rdfs:comment "A trajectory with at least one meaningful interaction at a poi:Cultural."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
