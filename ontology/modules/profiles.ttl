                        owl:onProperty trajecto:includesInteraction ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( poi:MeaningfulInteraction [ a owl:Restriction ;
                                            owl:onProperty poi:interactsWith ;
                                            owl:someValuesFrom poi:CommercialStreet ] ) ] ] ) ] .

profiles:CommercialTargeted a owl:Class ;
    rdfs:label "Commercial Targeted"@en ;
    rdfs:comment "A trajectory with purpose purposeskos:CommercialPurpose that exhibits the patterns:TargetedSegment navigation pattern."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
