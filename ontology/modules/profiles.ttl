@prefix trajecto: <http://w3id.org/trajecto#> .
@prefix poi: <http://w3id.org/trajecto/poi#> .
@prefix purposeskos: <http://w3id.org/trajecto/purpose/skos#> .
@prefix context: <http://w3id.org/trajecto/context#> .
@prefix patterns: <http://w3id.org/trajecto/patterns#> .
@prefix events: <http://w3id.org/trajecto/events#> .
@prefix profiles: <http://w3id.org/trajecto/profiles#> .
@prefix user: <http://w3id.org/trajecto/user#> .
@prefix datacron: <http://www.datacron-project.eu/datAcron#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/trajecto/profiles> a owl:Ontology ;
    rdfs:label "trajecto-profiles"@en ;
    dcterms:created "2026-03-29"^^xsd:date ;
    dcterms:creator "Konstantinos Kotis",
        "Sotirios Angelis" ;
    dcterms:description "Trajectory profile classes defined by necessary and sufficient conditions over purpose, navigation pattern, engagement level, interaction types, temporal context and trajectory events. An OWL reasoner assigns them to trajectories."@en ;
    dcterms:issued "2026-10-01"^^xsd:date ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-10-01"^^xsd:date ;
    dcterms:publisher "i-Lab, Department of Cultural Technology and Communication, University of the Aegean" ;
    dcterms:title "Trajecto Trajectory Profiles Module"@en ;
    vann:preferredNamespacePrefix "profiles" ;
    vann:preferredNamespaceUri "http://w3id.org/trajecto/profiles#" ;
    owl:imports <http://w3id.org/trajecto/context>,
        <http://w3id.org/trajecto/events>,
        <http://w3id.org/trajecto/patterns>,
        <http://w3id.org/trajecto/poi>,
        <http://w3id.org/trajecto/purpose/skos>,
        <http://w3id.org/trajecto/user> ;
    owl:priorVersion <http://w3id.org/trajecto/profiles/1.0> ;
    owl:versionIRI <http://w3id.org/trajecto/profiles/1.1.0> ;
    owl:versionInfo "1.1.0" .

#################################################################
#    Classes
#################################################################

profiles:AccommodationVisitor a owl:Class ;
    rdfs:label "Accommodation Visitor"@en ;
    rdfs:comment "A trajectory with at least one meaningful interaction at a poi:Accommodation."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:onProperty trajecto:includesInteraction ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( poi:MeaningfulInteraction [ a owl:Restriction ;
                                            owl:onProperty poi:interactsWith ;
                                            owl:someValuesFrom poi:Accommodation ] ) ] ] ) ] .

profiles:AfternoonTrajectory a owl:Class ;
    rdfs:label "Afternoon Trajectory"@en ;
    rdfs:comment "A trajectory with temporal context context:Afternoon."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:hasValue context:Afternoon ;
                        owl:onProperty context:hasTemporalContext ] ) ] .

profiles:ArtworkVisitor a owl:Class ;
    rdfs:label "Artwork Visitor"@en ;
    rdfs:comment "A trajectory with at least one meaningful interaction at a poi:Artwork."@en ;
