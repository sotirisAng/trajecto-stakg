                        owl:onProperty trajecto:includesInteraction ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( poi:MeaningfulInteraction [ a owl:Restriction ;
                                            owl:onProperty poi:interactsWith ;
                                            owl:someValuesFrom poi:Cafe ] ) ] ] ) ] .

profiles:CasualToImmersiveArc a owl:Class ;
    rdfs:label "Casual to Immersive Arc"@en ;
    rdfs:comment "A casual trajectory (patterns:CasualMovement) with an engagement escalation event and at least one immersive interaction."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( profiles:HasEngagementEscalation [ a owl:Restriction ;
                        owl:hasValue patterns:CasualMovement ;
                        owl:onProperty patterns:exhibitsPattern ] profiles:HasImmersiveInteraction ) ] .

profiles:CinemaVisitor a owl:Class ;
    rdfs:label "Cinema Visitor"@en ;
    rdfs:comment "A trajectory with at least one meaningful interaction at a poi:Cinema."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:onProperty trajecto:includesInteraction ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( poi:MeaningfulInteraction [ a owl:Restriction ;
                                            owl:onProperty poi:interactsWith ;
                                            owl:someValuesFrom poi:Cinema ] ) ] ] ) ] .

profiles:CommercialCasual a owl:Class ;
    rdfs:label "Commercial Casual"@en ;
    rdfs:comment "A trajectory with purpose purposeskos:CommercialPurpose that exhibits the patterns:CasualMovement navigation pattern."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( datacron:Trajectory [ a owl:Restriction ;
                        owl:hasValue purposeskos:CommercialPurpose ;
                        owl:onProperty trajecto:hasPurpose ] [ a owl:Restriction ;
                        owl:hasValue patterns:CasualMovement ;
                        owl:onProperty patterns:exhibitsPattern ] ) ] .

profiles:CommercialExplorer a owl:Class ;
    rdfs:label "Commercial Explorer"@en ;
    rdfs:comment "A trajectory with purpose purposeskos:CommercialPurpose that exhibits the patterns:ExploratoryMovement navigation pattern."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
