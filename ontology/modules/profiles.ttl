                        owl:hasValue patterns:CasualMovement ;
                        owl:onProperty patterns:exhibitsPattern ] ) ] .

profiles:DiningExplorer a owl:Class ;
    rdfs:label "Dining Explorer"@en ;
    rdfs:comment "A trajectory with purpose purposeskos:DiningExperience that exhibits the patterns:ExploratoryMovement navigation pattern."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/profiles> ;
