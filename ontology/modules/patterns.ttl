@prefix trajecto: <http://w3id.org/trajecto#> .
@prefix patterns: <http://w3id.org/trajecto/patterns#> .
@prefix datacron: <http://www.datacron-project.eu/datAcron#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/trajecto/patterns> a owl:Ontology ;
    rdfs:label "trajecto-patterns"@en ;
    dcterms:created "2025-05-09"^^xsd:date ;
    dcterms:creator "Konstantinos Kotis",
        "Sotirios Angelis" ;
    dcterms:description "This module extends the trajecto ontology with concepts for analyzing movement patterns and behavior independent of purpose."@en ;
    dcterms:issued "2026-10-01"^^xsd:date ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-10-01"^^xsd:date ;
    dcterms:publisher "i-Lab, Department of Cultural Technology and Communication, University of the Aegean" ;
    dcterms:title "Trajecto Movement Patterns Module"@en ;
    vann:preferredNamespacePrefix "patterns" ;
    vann:preferredNamespaceUri "http://w3id.org/trajecto/patterns#" ;
    owl:priorVersion <http://w3id.org/trajecto/patterns/1.0> ;
    owl:versionIRI <http://w3id.org/trajecto/patterns/1.1.0> ;
    owl:versionInfo "1.1.0" .

#################################################################
#    Classes
#################################################################

patterns:AcceleratingDecelerating a owl:Class ;
    rdfs:label "Accelerating Decelerating"@en ;
    rdfs:comment "Regular patterns of acceleration and deceleration."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:VelocityPattern .

patterns:AvoidanceSegment a owl:Class ;
    rdfs:label "Avoidance Segment"@en ;
    rdfs:comment "Segment characterized by movement to avoid an area or obstacle."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:TrajectorySegmentType .

patterns:Backtrack a owl:Class ;
    rdfs:label "Backtrack"@en ;
    rdfs:comment "Decision to return along the previous path."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DecisionOutcome .

patterns:BacktrackingMovement a owl:Class ;
    rdfs:label "Backtracking Movement"@en ;
    rdfs:comment "Movement that involves returning along previously traveled paths."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:FocusPattern .

patterns:BehavioralPattern a owl:Class ;
    rdfs:label "Behavioral Pattern"@en ;
    rdfs:comment "Pattern in the behavioral characteristics of movement."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:MovementPattern .

patterns:BriefDwell a owl:Class ;
    rdfs:label "Brief Dwell"@en ;
    rdfs:comment "Short stays at many points of interest."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DwellPattern .

patterns:CasualMovement a owl:Class ;
    rdfs:label "Casual Movement"@en ;
    rdfs:comment "Relaxed, low-speed movement without focused engagement."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:FocusPattern .

patterns:ChangeDirection a owl:Class ;
    rdfs:label "Change Direction"@en ;
    rdfs:comment "Decision to change direction."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DecisionOutcome .

patterns:ChoicePoint a owl:Class ;
    rdfs:label "Choice Point"@en ;
    rdfs:comment "A decision point with multiple clear options available."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DecisionPoint .

patterns:CircularReturn a owl:Class ;
    rdfs:label "Circular Return"@en ;
    rdfs:comment "Circular movement pattern returning to the starting point."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DirectionalPattern .

patterns:ClusteredVisit a owl:Class ;
    rdfs:label "Clustered Visit"@en ;
    rdfs:comment "Visiting clusters of points of interest together."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:VisitPattern .

patterns:CoherentGroupMovement a owl:Class ;
    rdfs:label "Coherent Group Movement"@en ;
    rdfs:comment "Group moving together with high cohesion."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:GroupMovementPattern .

patterns:Consistent a owl:Class ;
    rdfs:label "Consistent"@en ;
    rdfs:comment "Consistent, steady velocity throughout movement."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:VelocityPattern .

patterns:ContinueForward a owl:Class ;
    rdfs:label "Continue Forward"@en ;
    rdfs:comment "Decision to continue in the current direction."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DecisionOutcome .

patterns:CyclicalPattern a owl:Class ;
    rdfs:label "Cyclical Pattern"@en ;
    rdfs:comment "Pattern with regular repetition over time."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:SpatioTemporalPattern .

patterns:DecisionOutcome a owl:Class ;
    rdfs:label "Decision Outcome"@en ;
    rdfs:comment "The outcome of a decision at a decision point."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf dul:Abstract .

patterns:DecisionPoint a owl:Class ;
    rdfs:label "Decision Point"@en ;
    rdfs:comment "A point in a trajectory where a decision is made about movement."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf trajecto:Stop ;
    skos:definition "A specific location in a trajectory where a movement decision is made, often characterized by a change in direction, speed, or behavior."@en .

patterns:DenseSpatialPattern a owl:Class ;
    rdfs:label "Dense Spatial Pattern"@en ;
    rdfs:comment "Pattern where movement is concentrated in a small area."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:SpatioTemporalPattern .

patterns:DenseTimePattern a owl:Class ;
    rdfs:label "Dense Time Pattern"@en ;
    rdfs:comment "Pattern where much activity occurs in a short time span."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:SpatioTemporalPattern .

patterns:DirectionalPattern a owl:Class ;
    rdfs:label "Directional Pattern"@en ;
    rdfs:comment "Pattern in the directionality of movement."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:MovementPattern .

patterns:DispersedSpatialPattern a owl:Class ;
    rdfs:label "Dispersed Spatial Pattern"@en ;
    rdfs:comment "Pattern where movement is dispersed over a large area."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:SpatioTemporalPattern .

patterns:DwellPattern a owl:Class ;
    rdfs:label "Dwell Pattern"@en ;
    rdfs:comment "Pattern in how long a visitor stays at points of interest."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:BehavioralPattern .

patterns:ExplorationSegment a owl:Class ;
    rdfs:label "Exploration Segment"@en ;
    rdfs:comment "Segment characterized by exploratory behavior."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:TrajectorySegmentType .

patterns:ExploratoryMovement a owl:Class ;
    rdfs:label "Exploratory Movement"@en ;
    rdfs:comment "Movement focused on exploration without specific destinations."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:FocusPattern .

patterns:ExternalInterruptionPoint a owl:Class ;
    rdfs:label "External Interruption Point"@en ;
    rdfs:comment "A decision point caused by external interruption (call, message, encounter)."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DecisionPoint .

patterns:FastPaced a owl:Class ;
    rdfs:label "Fast Paced"@en ;
    rdfs:comment "Consistently fast movement throughout a trajectory."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:PacePattern .

patterns:Fluctuating a owl:Class ;
    rdfs:label "Fluctuating"@en ;
    rdfs:comment "Fluctuating velocity with irregular changes."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:VelocityPattern .

patterns:FocusedDwell a owl:Class ;
    rdfs:label "Focused Dwell"@en ;
    rdfs:comment "Long stays at a few key points of interest."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DwellPattern .

patterns:FocusPattern a owl:Class ;
    rdfs:label "Focus Pattern"@en ;
    rdfs:comment "Pattern in the focus or intention of movement."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:MovementPattern .

patterns:GroupMovementPattern a owl:Class ;
    rdfs:label "Group Movement Pattern"@en ;
    rdfs:comment "Pattern in the movement of groups of individuals."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:MovementPattern .

patterns:HesitationSegment a owl:Class ;
    rdfs:label "Hesitation Segment"@en ;
    rdfs:comment "Segment characterized by hesitation or indecision."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:TrajectorySegmentType .

patterns:ImmersiveMovement a owl:Class ;
    rdfs:label "Immersive Movement"@en ;
    rdfs:comment "Movement dominated by prolonged, immersive engagement with points of interest."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:FocusPattern .

patterns:IndependentGroupMovement a owl:Class ;
    rdfs:label "Independent Group Movement"@en ;
    rdfs:comment "Group members moving independently within a larger area."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:GroupMovementPattern .

patterns:InformationSeekingPoint a owl:Class ;
    rdfs:label "Information Seeking Point"@en ;
    rdfs:comment "A decision point where information is sought to inform movement."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DecisionPoint .

patterns:IrregularPace a owl:Class ;
    rdfs:label "Irregular Pace"@en ;
    rdfs:comment "Unpredictable changes in pace throughout a trajectory."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:PacePattern .

patterns:Junction a owl:Class ;
    rdfs:label "Junction"@en ;
    rdfs:comment "A physical junction where multiple paths meet."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:ChoicePoint .

patterns:LeaderFollowerMovement a owl:Class ;
    rdfs:label "Leader Follower Movement"@en ;
    rdfs:comment "Group following a leader who determines the movement path."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:GroupMovementPattern .

patterns:Linear a owl:Class ;
    rdfs:label "Linear"@en ;
    rdfs:comment "Linear, direct movement pattern."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DirectionalPattern .

patterns:LingeringSegment a owl:Class ;
    rdfs:label "Lingering Segment"@en ;
    rdfs:comment "Segment characterized by prolonged stay in one area."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:TrajectorySegmentType .

patterns:MapCheckingPoint a owl:Class ;
    rdfs:label "Map Checking Point"@en ;
    rdfs:comment "A point where a map or navigation aid is consulted."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:InformationSeekingPoint .

patterns:MovementPattern a owl:Class ;
    rdfs:label "Movement Pattern"@en ;
    rdfs:comment "A recognizable pattern in movement behavior."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf dul:Abstract ;
    skos:definition "A distinct, identifiable pattern in how a person or group moves through space over time."@en .

patterns:MultiDestination a owl:Class ;
    rdfs:label "Multi Destination"@en ;
    rdfs:comment "Movement visiting multiple destinations."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:FocusPattern .

patterns:PacePattern a owl:Class ;
    rdfs:label "Pace Pattern"@en ;
    rdfs:comment "Pattern in the pace or rhythm of movement."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:BehavioralPattern .

patterns:Path a owl:Class ;
    rdfs:label "Path"@en ;
    rdfs:comment "A potential path that could be taken from a decision point."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf dul:Abstract .

patterns:PingPongVisit a owl:Class ;
    rdfs:label "Ping Pong Visit"@en ;
    rdfs:comment "Moving back and forth between a small number of points repeatedly."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:VisitPattern .

patterns:RandomWalk a owl:Class ;
    rdfs:label "Random Walk"@en ;
    rdfs:comment "Random, unpredictable movement pattern."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DirectionalPattern .

patterns:ReorientationPoint a owl:Class ;
    rdfs:label "Reorientation Point"@en ;
    rdfs:comment "A decision point where a change in direction or plan occurs."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DecisionPoint .

patterns:RhythmicPace a owl:Class ;
    rdfs:label "Rhythmic Pace"@en ;
    rdfs:comment "Regular alternation between faster and slower movement."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:PacePattern .

patterns:SequentialVisit a owl:Class ;
    rdfs:label "Sequential Visit"@en ;
    rdfs:comment "Visiting points of interest in a sequential order."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:VisitPattern .

patterns:SignageCheckPoint a owl:Class ;
    rdfs:label "Signage Check Point"@en ;
    rdfs:comment "A point where signage is read or consulted."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:InformationSeekingPoint .

patterns:SingleDestination a owl:Class ;
    rdfs:label "Single Destination"@en ;
    rdfs:comment "Movement focused on reaching a single destination."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:FocusPattern .

patterns:SlowPaced a owl:Class ;
    rdfs:label "Slow Paced"@en ;
    rdfs:comment "Consistently slow, leisurely movement throughout a trajectory."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:PacePattern .

patterns:SpatioTemporalPattern a owl:Class ;
    rdfs:label "Spatio Temporal Pattern"@en ;
    rdfs:comment "Pattern in the spatial and temporal aspects of movement."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:MovementPattern .

patterns:SplitAndMergeMovement a owl:Class ;
    rdfs:label "Split and Merge Movement"@en ;
    rdfs:comment "Group repeatedly splitting apart and reconvening."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:GroupMovementPattern .

patterns:SpreadTimePattern a owl:Class ;
    rdfs:label "Spread Time Pattern"@en ;
    rdfs:comment "Pattern where activity is spread out over a longer time span."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:SpatioTemporalPattern .

patterns:SteadyMovement a owl:Class ;
    rdfs:label "Steady Movement"@en ;
    rdfs:comment "Movement with a moderate number of interactions and moderate dwell, between targeted and exploratory (BIRD instantiation)."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:FocusPattern .

patterns:StopAndWait a owl:Class ;
    rdfs:label "Stop and Wait"@en ;
    rdfs:comment "Decision to stop movement temporarily."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DecisionOutcome .

patterns:TargetedSegment a owl:Class ;
    rdfs:label "Targeted Segment"@en ;
    rdfs:comment "Segment characterized by direct, purposeful movement toward a destination."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:TrajectorySegmentType .

patterns:TrajectorySegmentType a owl:Class ;
    rdfs:label "Trajectory Segment Type"@en ;
    rdfs:comment "Classification of trajectory segments by behavioral characteristics."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf dul:Abstract .

patterns:TransitionSegment a owl:Class ;
    rdfs:label "Transition Segment"@en ;
    rdfs:comment "Segment characterized by movement between different spaces or zones."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:TrajectorySegmentType .

patterns:VariableDwell a owl:Class ;
    rdfs:label "Variable Dwell"@en ;
    rdfs:comment "Highly variable dwell times across different points of interest."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DwellPattern .

patterns:VelocityPattern a owl:Class ;
    rdfs:label "Velocity Pattern"@en ;
    rdfs:comment "Pattern in the velocity of movement."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:MovementPattern .

patterns:VisitPattern a owl:Class ;
    rdfs:label "Visit Pattern"@en ;
    rdfs:comment "Pattern in how points of interest are visited."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:BehavioralPattern .

patterns:Zigzag a owl:Class ;
    rdfs:label "Zigzag"@en ;
    rdfs:comment "Zigzagging movement pattern with regular direction changes."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:subClassOf patterns:DirectionalPattern .


#################################################################
#    Object properties
#################################################################

patterns:exhibitsPattern a owl:ObjectProperty ;
    rdfs:label "exhibits pattern"@en ;
    rdfs:comment "Associates a trajectory with movement patterns it exhibits."@en ;
    rdfs:domain datacron:Trajectory ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:range patterns:MovementPattern ;
    rdfs:subPropertyOf dul:associatedWith .

patterns:hasAlternativePath a owl:ObjectProperty ;
    rdfs:label "has alternative path"@en ;
    rdfs:comment "Links a decision point to alternative paths not taken."@en ;
    rdfs:domain patterns:DecisionPoint ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:range patterns:Path .

patterns:hasChosenPath a owl:ObjectProperty ;
    rdfs:label "has chosen path"@en ;
    rdfs:comment "Links a decision point to the path actually taken."@en ;
    rdfs:domain patterns:DecisionPoint ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:range patterns:Path ;
    rdfs:subPropertyOf patterns:hasAlternativePath .

patterns:hasDecisionOutcome a owl:ObjectProperty ;
    rdfs:label "has decision outcome"@en ;
    rdfs:comment "Links a decision point to its outcome."@en ;
    rdfs:domain patterns:DecisionPoint ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:range patterns:DecisionOutcome .

patterns:hasDecisionPoint a owl:ObjectProperty ;
    rdfs:label "has decision point"@en ;
    rdfs:comment "Links a trajectory to decision points within it."@en ;
    rdfs:domain datacron:Trajectory ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:range patterns:DecisionPoint .

patterns:hasDirectionality a owl:ObjectProperty ;
    rdfs:label "has directionality"@en ;
    rdfs:comment "Associates a trajectory with its directional pattern."@en ;
    rdfs:domain datacron:Trajectory ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:range patterns:DirectionalPattern ;
    rdfs:subPropertyOf patterns:exhibitsPattern .

patterns:hasFocusPattern a owl:ObjectProperty ;
    rdfs:label "has focus pattern"@en ;
    rdfs:comment "Associates a trajectory with its focus pattern."@en ;
    rdfs:domain datacron:Trajectory ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:range patterns:FocusPattern ;
    rdfs:subPropertyOf patterns:exhibitsPattern .

patterns:hasSegmentType a owl:ObjectProperty ;
    rdfs:label "has segment type"@en ;
    rdfs:comment "Classifies a trajectory segment by its behavioral type."@en ;
    rdfs:domain datacron:Segment ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:range patterns:TrajectorySegmentType .

patterns:hasVelocityPattern a owl:ObjectProperty ;
    rdfs:label "has velocity pattern"@en ;
    rdfs:comment "Associates a trajectory with its velocity pattern."@en ;
    rdfs:domain datacron:Trajectory ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:range patterns:VelocityPattern ;
    rdfs:subPropertyOf patterns:exhibitsPattern .


#################################################################
#    Data properties
#################################################################

patterns:hasDecisionTime a owl:DatatypeProperty ;
    rdfs:label "has decision time"@en ;
    rdfs:comment "Duration of time spent making a decision at a decision point."@en ;
    rdfs:domain patterns:DecisionPoint ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:range xsd:duration .

patterns:hasDirectionalChanges a owl:DatatypeProperty ;
    rdfs:label "has directional changes"@en ;
    rdfs:comment "Number of significant direction changes in a trajectory."@en ;
    rdfs:domain datacron:Trajectory ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:range xsd:positiveInteger .

patterns:hasDirectionalStraightness a owl:DatatypeProperty ;
    rdfs:label "has directional straightness"@en ;
    rdfs:comment "A numerical value (0.0-1.0) indicating how straight a trajectory is."@en ;
    rdfs:domain datacron:Trajectory ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:range xsd:float .

patterns:hasVelocityVariance a owl:DatatypeProperty ;
    rdfs:label "has velocity variance"@en ;
    rdfs:comment "A numerical value indicating the variance in velocity during a trajectory."@en ;
    rdfs:domain datacron:Trajectory ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/patterns> ;
    rdfs:range xsd:float .


#################################################################
#    Terms reused from other modules and vocabularies
#################################################################

