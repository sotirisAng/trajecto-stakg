revision 1.1
date: 2003/01/10 10:53:23;  author: danbri;  state: Exp;
basic geo vocab

"""@en .

geo:Point a owl:Class ;
    rdfs:label "point"@en ;
    rdfs:comment """ 
Uniquely identified by lat/long/alt. i.e.

spaciallyIntersects(P1, P2) :- lat(P1, LAT), long(P1, LONG), alt(P1, ALT),
  lat(P2, LAT), long(P2, LONG), alt(P2, ALT).

sameThing(P1, P2) :- type(P1, Point), type(P2, Point), spaciallyIntersects(P1, P2).
  """@en,
        """A point, typically described using a coordinate system relative to Earth, such as WGS84.
  """@en ;
    rdfs:subClassOf geo:SpatialThing .

geo:SpatialThing a owl:Class ;
    rdfs:label "SpatialThing"@en ;
    rdfs:comment """Anything with spatial extent, i.e. size, shape, or position.
 e.g. people, places, bowling balls, as well as abstract areas like cubes.
"""@en .

geo:alt a owl:AnnotationProperty ;
    rdfs:label "altitude"@en ;
    rdfs:comment """The WGS84 altitude of a SpatialThing (decimal meters 
above the local reference ellipsoid)."""@en ;
    rdfs:domain geo:SpatialThing .

geo:lat a owl:AnnotationProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "The WGS84 latitude of a SpatialThing (decimal degrees)."@en ;
    rdfs:domain geo:SpatialThing .

geo:lat_long rdfs:label "lat/long"@en ;
    rdfs:comment "A comma-separated representation of a latitude, longitude coordinate."@en .

geo:location a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "location"@en ;
    rdfs:comment """The relation between something and the point, 
 or other geometrical thing in space, where it is.  For example, the realtionship between
 a radio tower and a Point with a given lat and long.
 Or a relationship between a park and its outline as a closed arc of points, or a road and
 its location as a arc (a sequence of points).
 Clearly in practice there will be limit to the accuracy of any such statement, but one would expect
 an accuracy appropriate for the size of the object and uses such as mapping .
 """@en ;
    rdfs:range geo:SpatialThing ;
    rdfs:subPropertyOf foaf:based_near .

geo:long a owl:AnnotationProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "The WGS84 longitude of a SpatialThing (decimal degrees)."@en ;
    rdfs:domain geo:SpatialThing .

skos:definition a owl:AnnotationProperty .

foaf:based_near a owl:AnnotationProperty .
