@prefix trajecto: <http://w3id.org/trajecto#> .
@prefix poi: <http://w3id.org/trajecto/poi#> .
@prefix purposeskos: <http://w3id.org/trajecto/purpose/skos#> .
@prefix datacron: <http://www.datacron-project.eu/datAcron#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/trajecto/poi> a owl:Ontology ;
    rdfs:label "trajecto-poi"@en ;
    dcterms:created "2025-05-09"^^xsd:date ;
    dcterms:creator "Konstantinos Kotis",
        "Sotirios Angelis" ;
    dcterms:description "Point-of-interest taxonomy (aligned to OpenStreetMap tags), POI functions and attraction levels, POI sequences, and the POI interaction hierarchy (passing, meaningful, immersive, extended, dominant, start, destination). The module also carries one POITypeConfiguration individual per POI type with the dwell thresholds (minimum meaningful, typical, maximum reasonable duration) that the SPARQL enrichment uses to classify interactions."@en ;
    dcterms:issued "2026-10-01"^^xsd:date ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-10-01"^^xsd:date ;
    dcterms:publisher "i-Lab, Department of Cultural Technology and Communication, University of the Aegean" ;
    dcterms:title "Trajecto POI Module"@en ;
    vann:preferredNamespacePrefix "poi" ;
    vann:preferredNamespaceUri "http://w3id.org/trajecto/poi#" ;
    owl:priorVersion <http://w3id.org/trajecto/poi/1.0> ;
    owl:versionIRI <http://w3id.org/trajecto/poi/1.1.0> ;
    owl:versionInfo "1.1.0" .

#################################################################
#    Classes
#################################################################

poi:Accommodation a owl:Class ;
    rdfs:label "Accommodation"@en ;
    poi:hasTypeConfiguration poi:AccommodationPOI-configuration ;
    rdfs:comment "A place that offers overnight stays, such as a hotel or hostel."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf trajecto:PointOfInterest ;
    skos:related purposeskos:AccommodationPurpose .

poi:Airport a owl:Class ;
    rdfs:label "Airport"@en ;
    poi:hasTypeConfiguration poi:Airport-configuration ;
    rdfs:comment "An airport or airfield."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Transportation ;
    skos:related purposeskos:AirportTransit .

poi:Amenity a owl:Class ;
    rdfs:label "Amenity"@en ;
    poi:hasTypeConfiguration poi:AmenityPOI-configuration ;
    rdfs:comment "Points of interest providing comfort or convenience amenities."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf trajecto:PointOfInterest,
        poi:POICategory .

poi:AnomalousInteraction a owl:Class ;
    rdfs:label "Anomalous Interaction"@en ;
    rdfs:comment "An interaction with duration that exceeds reasonable bounds, potentially indicating data quality issues or unusual circumstances."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:POIInteraction ;
    skos:definition "A POI interaction with duration beyond reasonable limits, requiring investigation for data quality or exceptional circumstances."@en .

poi:Artwork a owl:Class ;
    rdfs:label "Artwork"@en ;
    poi:hasTypeConfiguration poi:ArtworkPOI-configuration ;
    rdfs:comment "Artworks as points of interest in cultural spaces."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Cultural .

poi:ATM a owl:Class ;
    rdfs:label "ATM"@en ;
    poi:hasTypeConfiguration poi:ATM-configuration ;
    rdfs:comment "Automated teller machines."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:PrivateService,
        poi:Service .

poi:AttractionLevel a owl:Class ;
    rdfs:label "Attraction Level"@en ;
    rdfs:comment "Level of attraction a point of interest has for visitors."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf dul:Abstract .

poi:Bank a owl:Class ;
    rdfs:label "Bank"@en ;
    poi:hasTypeConfiguration poi:Bank-configuration ;
    rdfs:comment "A bank branch."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Service ;
    skos:related purposeskos:Banking .

poi:Bar a owl:Class ;
    rdfs:label "Bar"@en ;
    poi:hasTypeConfiguration poi:Bar-configuration ;
    rdfs:comment "A bar or pub serving drinks."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Nightlife .

poi:Beach a owl:Class ;
    rdfs:label "Beach"@en ;
    poi:hasTypeConfiguration poi:Beach-configuration ;
    rdfs:comment "A beach used for recreation."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Leisure ;
    skos:related purposeskos:BeachVisit .

poi:Bench a owl:Class ;
    rdfs:label "Bench"@en ;
    rdfs:comment "A bench. Not yet placed in the POI hierarchy and not linked to its own dwell configuration (Bench-configuration); interactions with it use the default configuration."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Bottleneck a owl:Class ;
    rdfs:label "Bottleneck"@en ;
    rdfs:comment "Points where movement is constrained or restricted."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:TransitionPoint .

poi:BriefObservation a owl:Class ;
    rdfs:label "Brief Observation"@en ;
    rdfs:comment "Short, passing observation of a point of interest."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Observation .

poi:BusStation a owl:Class ;
    rdfs:label "Bus Station"@en ;
    poi:hasTypeConfiguration poi:BusStation-configuration ;
    rdfs:comment "A bus station or major bus stop."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Transportation ;
    skos:related purposeskos:BusStationTransit .

poi:Cafe a owl:Class ;
    rdfs:label "Cafe"@en ;
    poi:hasTypeConfiguration poi:Cafe-configuration ;
    rdfs:comment "A cafe serving coffee, drinks and light food."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Dining ;
    skos:related purposeskos:CafeVisit .

poi:Church a owl:Class ;
    rdfs:label "Church"@en ;
    poi:hasTypeConfiguration poi:Church-configuration ;
    rdfs:comment "A Christian place of worship."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Religious ;
    skos:related purposeskos:Worship .

poi:Cinema a owl:Class ;
    rdfs:label "Cinema"@en ;
    poi:hasTypeConfiguration poi:Cinema-configuration ;
    rdfs:comment "A cinema."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:PerformanceVenue .

poi:Clinic a owl:Class ;
    rdfs:label "Clinic"@en ;
    poi:hasTypeConfiguration poi:Clinic-configuration ;
    rdfs:comment "A medical clinic or doctor's practice."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Healthcare ;
    skos:related purposeskos:MedicalAppointment .

poi:Club a owl:Class ;
    rdfs:label "Club"@en ;
    poi:hasTypeConfiguration poi:Club-configuration ;
    rdfs:comment "A club, typically a nightlife venue."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Nightlife .

poi:ComfortFunction a owl:Class ;
    rdfs:label "Comfort Function"@en ;
    rdfs:comment "Function of providing comfort or rest."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:POIFunction .

poi:Commercial a owl:Class ;
    rdfs:label "Commercial"@en ;
    poi:hasTypeConfiguration poi:CommercialPOI-configuration ;
    rdfs:comment "Points of interest with commercial function."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf trajecto:PointOfInterest ;
    skos:related purposeskos:CommercialPurpose .

poi:CommercialStreet a owl:Class ;
    rdfs:label "Commercial Street"@en ;
    poi:hasTypeConfiguration poi:CommercialStreet-configuration ;
    rdfs:comment "A street lined with shops and commercial premises."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Retail .

poi:ConferenceCenter a owl:Class ;
    rdfs:label "Conference Center"@en ;
    rdfs:comment "A venue built for conferences and meetings."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Commercial .

poi:Consulate a owl:Class ;
    rdfs:label "Consulate"@en ;
    rdfs:comment "A consular office of a foreign state."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:PublicService .

poi:ContentInformation a owl:Class ;
    rdfs:label "Content Information"@en ;
    rdfs:comment "Gathering content or subject information."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Information .

poi:ConventionCenter a owl:Class ;
    rdfs:label "Convention Center"@en ;
    rdfs:comment "A large venue for conventions and trade fairs."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Commercial .

poi:Cultural a owl:Class ;
    rdfs:label "Cultural"@en ;
    poi:hasTypeConfiguration poi:CulturalPOI-configuration ;
    rdfs:comment "Points of interest with cultural significance."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf trajecto:PointOfInterest ;
    skos:related purposeskos:CulturalPurpose .

poi:CustomerService a owl:Class ;
    rdfs:label "Customer Service"@en ;
    poi:hasTypeConfiguration poi:ServicePOI-configuration ;
    rdfs:comment "Customer service points."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:PrivateService .

poi:DestinationInteraction a owl:Class ;
    rdfs:label "Destination Interaction"@en ;
    rdfs:comment "An interaction at the destination/end point of a trajectory."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:MeaningfulInteraction ;
    skos:definition "A meaningful interaction marking the end of a trajectory, typically representing the user's arrival point or final destination."@en .

poi:DigitalDisplay a owl:Class ;
    rdfs:label "Digital Display"@en ;
    poi:hasTypeConfiguration poi:DigitalDisplay-configuration ;
    rdfs:comment "An electronic display that shows information or advertising."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Information .

poi:DigitalEngagement a owl:Class ;
    rdfs:label "Digital Engagement"@en ;
    rdfs:comment "Digital or electronic interaction with a point of interest."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Engagement .

poi:Dining a owl:Class ;
    rdfs:label "Dining"@en ;
    poi:hasTypeConfiguration poi:DiningPOI-configuration ;
    rdfs:comment "A place to eat or drink. Top category of restaurants, cafes, fast food and food courts."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Commercial ;
    skos:related purposeskos:DiningExperience .

poi:DominantInteraction a owl:Class ;
    rdfs:label "Dominant Interaction"@en ;
    rdfs:comment "The single interaction with the highest engagement score within a trajectory. Singleton per trajectory."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:MeaningfulInteraction ;
    skos:definition "The POI interaction that scored highest on the engagement metric (0.8 * log_norm_dwell + 0.2 * inv_norm_distance) within its trajectory. Exactly one per trajectory."@en .

poi:Educational a owl:Class ;
    rdfs:label "Educational"@en ;
    poi:hasTypeConfiguration poi:EducationalPOI-configuration ;
    rdfs:comment "A place of education or research. Top category of schools, universities and libraries."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf trajecto:PointOfInterest ;
    skos:related purposeskos:EducationalPurpose .

poi:Elevator a owl:Class ;
    rdfs:label "Elevator"@en ;
    poi:hasTypeConfiguration poi:Elevator-configuration ;
    rdfs:comment "An elevator connecting floors or levels."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Transition .

poi:Embassy a owl:Class ;
    rdfs:label "Embassy"@en ;
    rdfs:comment "A diplomatic mission of a foreign state."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:PublicService .

poi:EmergentSequence a owl:Class ;
    rdfs:label "Emergent Sequence"@en ;
    rdfs:comment "A sequence of points of interest that emerges during movement."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:POISequence .

poi:Engagement a owl:Class ;
    rdfs:label "Engagement"@en ;
    rdfs:comment "Active engagement with a point of interest."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:POIInteraction .

poi:Entertainment a owl:Class ;
    rdfs:label "Entertainment"@en ;
    poi:hasTypeConfiguration poi:EntertainmentPOI-configuration ;
    rdfs:comment "Entertainment features as points of interest."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf trajecto:PointOfInterest,
        poi:Recreational .

poi:Entrance a owl:Class ;
    rdfs:label "Entrance"@en ;
    poi:hasTypeConfiguration poi:Entrance-configuration ;
    rdfs:comment "Entry points to spaces."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Transition,
        poi:TransitionPoint .

poi:Escalator a owl:Class ;
    rdfs:label "Escalator"@en ;
    poi:hasTypeConfiguration poi:Escalator-configuration ;
    rdfs:comment "An escalator connecting floors or levels."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Transition .

poi:EventSpace a owl:Class ;
    rdfs:label "Event Space"@en ;
    rdfs:comment "Spaces designated for events or activities."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Social .

poi:Exhibit a owl:Class ;
    rdfs:label "Exhibit"@en ;
    poi:hasTypeConfiguration poi:ExhibitPOI-configuration ;
    rdfs:comment "Exhibits as points of interest in cultural spaces."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Cultural .

poi:ExhibitionHall a owl:Class ;
    rdfs:label "Exhibition Hall"@en ;
    rdfs:comment "A hall hosting temporary exhibitions."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Cultural .

poi:Exit a owl:Class ;
    rdfs:label "Exit"@en ;
    poi:hasTypeConfiguration poi:Exit-configuration ;
    rdfs:comment "Exit points from spaces."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Transition,
        poi:TransitionPoint .

poi:ExtendedInteraction a owl:Class ;
    rdfs:label "Extended Interaction"@en ;
    rdfs:comment "An interaction that significantly exceeds typical duration, indicating deep engagement or special circumstances."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:MeaningfulInteraction ;
    skos:definition "A POI interaction with duration substantially above typical engagement levels, suggesting intensive interest or extended activity."@en .

poi:ExtendedObservation a owl:Class ;
    rdfs:label "Extended Observation"@en ;
    rdfs:comment "Longer, more focused observation of a point of interest."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Observation .

poi:FastFood a owl:Class ;
    rdfs:label "Fast Food"@en ;
    poi:hasTypeConfiguration poi:FastFood-configuration ;
    rdfs:comment "A fast-food restaurant."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Dining ;
    skos:related purposeskos:FastFoodVisit .

poi:FoodCourt a owl:Class ;
    rdfs:label "Food Court"@en ;
    poi:hasTypeConfiguration poi:FoodCourt-configuration ;
    rdfs:comment "An area with several food outlets and shared seating."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Dining .

poi:Fountain a owl:Class ;
    rdfs:label "Fountain"@en ;
    poi:hasTypeConfiguration poi:Fountain-configuration ;
    rdfs:comment "A decorative or drinking fountain."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:VisualLandmark .

poi:Gallery a owl:Class ;
    rdfs:label "Gallery"@en ;
    poi:hasTypeConfiguration poi:Gallery-configuration ;
    rdfs:comment "An art gallery."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Cultural ;
    skos:related purposeskos:GalleryVisit .

poi:GatheringArea a owl:Class ;
    rdfs:label "Gathering Area"@en ;
    rdfs:comment "Areas where people gather or socialize."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Social .

poi:Gymnasium a owl:Class ;
    rdfs:label "Gymnasium"@en ;
    poi:hasTypeConfiguration poi:Gymnasium-configuration ;
    rdfs:comment "A gym or fitness center."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Sports ;
    skos:related purposeskos:GymVisit .

poi:Healthcare a owl:Class ;
    rdfs:label "Healthcare"@en ;
    poi:hasTypeConfiguration poi:HealthcarePOI-configuration ;
    rdfs:comment "A healthcare facility. Top category of hospitals, clinics and pharmacies."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf trajecto:PointOfInterest ;
    skos:related purposeskos:HealthcarePurpose .

poi:HighAttraction a owl:Class ;
    rdfs:label "High Attraction"@en ;
    rdfs:comment "Points of interest with high attraction level."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:AttractionLevel .

poi:Historical a owl:Class ;
    rdfs:label "Historical"@en ;
    poi:hasTypeConfiguration poi:HistoricalPOI-configuration ;
    rdfs:comment "Historical objects or sites as points of interest."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf trajecto:PointOfInterest,
        poi:Cultural ;
    skos:related purposeskos:HistoricalSiteVisit .

poi:HistoricalLandmark a owl:Class ;
    rdfs:label "Historical Landmark"@en ;
    poi:hasTypeConfiguration poi:HistoricalLandmark-configuration ;
    rdfs:comment "Landmarks with historical significance."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Historical,
        poi:Landmark .

poi:HistoricalSite a owl:Class ;
    rdfs:label "Historical Site"@en ;
    poi:hasTypeConfiguration poi:HistoricalSite-configuration ;
    rdfs:comment "A site of historical interest, such as ruins or an archaeological site."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Historical .

poi:Hospital a owl:Class ;
    rdfs:label "Hospital"@en ;
    poi:hasTypeConfiguration poi:Hospital-configuration ;
    rdfs:comment "A hospital."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Healthcare ;
    skos:related purposeskos:MedicalAppointment .

poi:Hostel a owl:Class ;
    rdfs:label "Hostel"@en ;
    poi:hasTypeConfiguration poi:Hostel-configuration ;
    rdfs:comment "A hostel offering budget accommodation."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Accommodation ;
    skos:related purposeskos:HostelStay .

poi:Hotel a owl:Class ;
    rdfs:label "Hotel"@en ;
    poi:hasTypeConfiguration poi:Hotel-configuration ;
    rdfs:comment "A hotel."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Accommodation ;
    skos:related purposeskos:HotelStay .

poi:IconicBuilding a owl:Class ;
    rdfs:label "Iconic Building"@en ;
    poi:hasTypeConfiguration poi:IconicBuilding-configuration ;
    rdfs:comment "A building recognized for its architecture or symbolism."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:VisualLandmark .

poi:ImmersiveInteraction a owl:Class ;
    rdfs:label "Immersive Interaction"@en ;
    rdfs:comment "An interaction with duration significantly exceeding the meaningful threshold, indicating deep engagement or immersion at a POI."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:MeaningfulInteraction ;
    skos:definition "A POI interaction whose dwell time substantially surpasses the meaningful duration threshold, suggesting the user was deeply engaged with the location."@en .

poi:InfoDisplay a owl:Class ;
    rdfs:label "Info Display"@en ;
    poi:hasTypeConfiguration poi:Default-configuration ;
    rdfs:comment "Electronic or physical displays providing information."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Information .

poi:Information a owl:Class ;
    rdfs:label "Information"@en ;
    rdfs:comment "Information gathering at a point of interest."@en,
        "Points of interest providing information."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf trajecto:PointOfInterest,
        poi:POICategory .

poi:InformationDesk a owl:Class ;
    rdfs:label "Information Desk"@en ;
    poi:hasTypeConfiguration poi:ServicePOI-configuration ;
    rdfs:comment "Information service points."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:PublicService .

poi:InformationFunction a owl:Class ;
    rdfs:label "Information Function"@en ;
    rdfs:comment "Function of providing information."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:POIFunction .

poi:InformationKiosk a owl:Class ;
    rdfs:label "Information Kiosk"@en ;
    poi:hasTypeConfiguration poi:InformationKiosk-configuration ;
    rdfs:comment "A kiosk providing tourist or visitor information."@en ;
