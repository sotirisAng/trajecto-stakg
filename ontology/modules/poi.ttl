    poi:hasMaximumReasonableDuration "PT4H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT15M"^^xsd:duration ;
    poi:hasTypicalDuration "PT1H"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 15 min, typical at 1 h, and anomalous beyond 4 h. Used by: Dining."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:EducationalPOI-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "EducationalPOI configuration"@en ;
    poi:hasMaximumReasonableDuration "PT8H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT15M"^^xsd:duration ;
    poi:hasTypicalDuration "PT1H30M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 15 min, typical at 1 h 30 min, and anomalous beyond 8 h. Used by: Educational."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Elevator-configuration a poi:POITypeConfiguration,
