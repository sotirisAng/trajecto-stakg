    skos:related purposeskos:Worship .

poi:Theater a owl:Class ;
    rdfs:label "Theater"@en ;
    poi:hasTypeConfiguration poi:Theater-configuration ;
    rdfs:comment "A theater."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:PerformanceVenue ;
    skos:related purposeskos:TheaterVisit .

poi:Tower a owl:Class ;
    rdfs:label "Tower"@en ;
    poi:hasTypeConfiguration poi:Tower-configuration ;
    rdfs:comment "A tower, such as a bell tower or observation tower."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:VisualLandmark .

poi:TrainStation a owl:Class ;
    rdfs:label "Train Station"@en ;
    poi:hasTypeConfiguration poi:TrainStation-configuration ;
    rdfs:comment "A railway or metro station."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Transportation ;
    skos:related purposeskos:TrainStationTransit .

poi:Transaction a owl:Class ;
    rdfs:label "Transaction"@en ;
    rdfs:comment "Transaction or exchange at a point of interest."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:POIInteraction .

poi:Transition a owl:Class ;
    rdfs:label "Transition"@en ;
    poi:hasTypeConfiguration poi:TransitionPOI-configuration ;
    rdfs:comment "A feature that connects spaces or levels, such as an entrance, exit, staircase or elevator."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf trajecto:PointOfInterest .

poi:TransitionPoint a owl:Class ;
    rdfs:label "Transition Point"@en ;
    rdfs:comment "Points of interest that mark transitions between different spaces."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:POICategory .

poi:Transportation a owl:Class ;
    rdfs:label "Transportation"@en ;
    poi:hasTypeConfiguration poi:TransportationPOI-configuration ;
    rdfs:comment "A transport facility. Top category of stations, airports and parking areas. Excluded from recommendation."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf trajecto:PointOfInterest ;
    skos:related purposeskos:TransportationPurpose .

poi:University a owl:Class ;
    rdfs:label "University"@en ;
    poi:hasTypeConfiguration poi:University-configuration ;
    rdfs:comment "A university or college."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Educational ;
    skos:related purposeskos:UniversityAttendance .

poi:VendingMachine a owl:Class ;
    rdfs:label "Vending Machine"@en ;
    rdfs:comment "A vending machine. Not yet placed in the POI hierarchy and not linked to its own dwell configuration (VendingMachine-configuration); interactions with it use the default configuration."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:ViewingPoint a owl:Class ;
    rdfs:label "Viewing Point"@en ;
    poi:hasTypeConfiguration poi:ViewingPoint-configuration ;
    rdfs:comment "A viewpoint or observation point."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:VisualLandmark .

poi:VisualLandmark a owl:Class ;
    rdfs:label "Visual Landmark"@en ;
    poi:hasTypeConfiguration poi:VisualLandmark-configuration ;
    rdfs:comment "Visually distinctive landmarks."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:Landmark .

poi:WaterFountain a owl:Class ;
    rdfs:label "Water Fountain"@en ;
    rdfs:comment "A water fountain. Not yet placed in the POI hierarchy and not linked to its own dwell configuration (WaterFountain-configuration); interactions with it use the default configuration."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Waypoint a owl:Class ;
    rdfs:label "Waypoint"@en ;
    poi:hasTypeConfiguration poi:Waypoint-configuration ;
    rdfs:comment "A point used for orientation along a route."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:subClassOf poi:NavigationLandmark .


#################################################################
#    Object properties
#################################################################

poi:covisitedWith a owl:ObjectProperty ;
    rdfs:label "covisited with"@en ;
    rdfs:comment "Two POIs are interacted with meaningfully in the same trajectory (SR-05)."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range trajecto:PointOfInterest .

poi:followedBy a owl:ObjectProperty ;
    rdfs:label "followed by"@en ;
    rdfs:comment "A POI is interacted with meaningfully immediately before another in at least one trajectory (SR-06)."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range trajecto:PointOfInterest .

poi:hasInteractionClassification a owl:ObjectProperty ;
    rdfs:label "has interaction classification"@en ;
    rdfs:comment "Associates a POI interaction with its duration-based classification."@en ;
    rdfs:domain poi:POIInteraction ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range poi:InteractionClassification ;
    rdfs:subPropertyOf dul:associatedWith .

poi:hasNextPOI a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has next POI"@en ;
    rdfs:comment "Links a point of interest to the next one in a sequence."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range trajecto:PointOfInterest .

poi:hasPOIAttraction a owl:ObjectProperty ;
    rdfs:label "has POI attraction"@en ;
    rdfs:comment "Specifies the level of attraction a POI has for visitors."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range poi:AttractionLevel .

poi:hasPOICategory a owl:ObjectProperty ;
    rdfs:label "has POI category"@en ;
    rdfs:comment "Associates a point of interest with its category."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range poi:POICategory ;
    rdfs:subPropertyOf dul:associatedWith .

poi:hasPOIInteraction a owl:ObjectProperty ;
    rdfs:label "has POI interaction"@en ;
    rdfs:comment "Links a trajectory part to an interaction with a point of interest."@en ;
    rdfs:domain datacron:TrajectoryPart ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range poi:POIInteraction .

poi:hasPOISequence a owl:ObjectProperty ;
    rdfs:label "has POI sequence"@en ;
    rdfs:comment "Links a trajectory to a sequence of visited points of interest."@en ;
    rdfs:domain datacron:Trajectory ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range poi:POISequence .

poi:hasPrimaryFunction a owl:ObjectProperty ;
    rdfs:label "has primary function"@en ;
    rdfs:comment "Associates a point of interest with its main function."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range poi:POIFunction ;
    rdfs:subPropertyOf dul:associatedWith .

poi:hasRoom a owl:ObjectProperty ;
    rdfs:label "has room"@en ;
    rdfs:comment "The museum room in which an artwork is exhibited (BIRD instantiation)."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:interactsWith a owl:ObjectProperty ;
    rdfs:label "interacts with"@en ;
    rdfs:comment "Specifies the point of interest involved in an interaction."@en ;
    rdfs:domain poi:POIInteraction ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range trajecto:PointOfInterest .


#################################################################
#    Data properties
#################################################################

poi:creationPeriod a owl:DatatypeProperty ;
    rdfs:label "creation period"@en ;
    rdfs:comment "Creation date or period of an artwork point of interest."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range xsd:string .

poi:creator a owl:DatatypeProperty ;
    rdfs:label "creator"@en ;
    rdfs:comment "Creator or artist of an artwork point of interest."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range xsd:string .

poi:hasAttractionStrength a owl:DatatypeProperty ;
    rdfs:label "has attraction strength"@en ;
    rdfs:comment "Numerical value indicating the strength of attraction of a POI."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range xsd:float .

poi:hasDwellTime a owl:DatatypeProperty ;
    rdfs:label "has dwell time"@en ;
    rdfs:comment "Duration of time spent at a point of interest."@en ;
    rdfs:domain poi:POIInteraction ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range xsd:duration .

poi:hasDwellTimeInSeconds a owl:DatatypeProperty ;
    rdfs:label "has dwell time in seconds"@en ;
    rdfs:comment "Duration of time spent at a point of interest, in seconds. Numeric counterpart of hasDwellTime used by the CSV-to-RDF mappings and analytics queries."@en ;
    rdfs:domain poi:POIInteraction ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range xsd:float .

poi:hasEra a owl:DatatypeProperty ;
    rdfs:label "has era"@en ;
    rdfs:comment "The art-historical era of an artwork (BIRD instantiation)."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range xsd:string .

poi:hasPopularity a owl:DatatypeProperty ;
    rdfs:label "has popularity"@en ;
    rdfs:comment "Numerical value indicating the popularity of a POI."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range xsd:float .

poi:hasRevisitCount a owl:DatatypeProperty ;
    rdfs:label "has revisit count"@en ;
    rdfs:comment "Number of times a point of interest is revisited in a trajectory."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range xsd:positiveInteger .

poi:hasType a owl:DatatypeProperty ;
    rdfs:label "has type"@en ;
    rdfs:comment "Medium or type of an artwork (e.g. Oil on canvas, Bronze)."@en ;
    rdfs:domain trajecto:PointOfInterest ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range xsd:string .


#################################################################
#    Annotation properties
#################################################################

poi:hasMaximumReasonableDuration a owl:AnnotationProperty ;
    rdfs:label "has maximum reasonable duration"@en ;
    rdfs:comment "Maximum reasonable duration for interaction with this POI category before it becomes anomalous."@en ;
    rdfs:domain poi:POITypeConfiguration ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range xsd:duration ;
    skos:definition "The upper threshold beyond which an interaction duration is considered unusually long."@en .

poi:hasMinimumMeaningfulDuration a owl:AnnotationProperty ;
    rdfs:label "has minimum meaningful duration"@en ;
    rdfs:comment "Minimum duration required for an interaction to be considered meaningful for this POI category."@en ;
    rdfs:domain poi:POITypeConfiguration ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range xsd:duration ;
    skos:definition "The threshold duration below which an interaction is considered too brief to be meaningful for the specific POI type."@en .

poi:hasTypeConfiguration a owl:AnnotationProperty ;
    rdfs:label "has type configuration"@en ;
    rdfs:comment "Links a POI class to the configuration individual carrying its dwell parameters."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range poi:POITypeConfiguration .

poi:hasTypicalDuration a owl:AnnotationProperty ;
    rdfs:label "has typical duration"@en ;
    rdfs:comment "Typical or expected duration for meaningful engagement with this POI category."@en ;
    rdfs:domain poi:POITypeConfiguration ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> ;
    rdfs:range xsd:duration ;
    skos:definition "The average or expected duration for normal engagement with this type of POI."@en .


#################################################################
#    Individuals
#################################################################

poi:AccommodationPOI-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "AccommodationPOI configuration"@en ;
    poi:hasMaximumReasonableDuration "P1D"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT30M"^^xsd:duration ;
    poi:hasTypicalDuration "PT2H"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 30 min, typical at 2 h, and anomalous beyond P1D. Used by: Accommodation."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Airport-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "Airport configuration"@en ;
    poi:hasMaximumReasonableDuration "PT12H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT1H"^^xsd:duration ;
    poi:hasTypicalDuration "PT3H"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 1 h, typical at 3 h, and anomalous beyond 12 h. Used by: Airport."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:AmenityPOI-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "AmenityPOI configuration"@en ;
    poi:hasMaximumReasonableDuration "PT1H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT1M"^^xsd:duration ;
    poi:hasTypicalDuration "PT10M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 1 min, typical at 10 min, and anomalous beyond 1 h. Used by: Amenity."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:ArtworkPOI-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "ArtworkPOI configuration"@en ;
    poi:hasMaximumReasonableDuration "PT30M"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT2M"^^xsd:duration ;
    poi:hasTypicalDuration "PT5M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 2 min, typical at 5 min, and anomalous beyond 30 min. Used by: Artwork."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:ATM-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "ATM configuration"@en ;
    poi:hasMaximumReasonableDuration "PT15M"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT1M"^^xsd:duration ;
    poi:hasTypicalDuration "PT3M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 1 min, typical at 3 min, and anomalous beyond 15 min. Used by: ATM."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Bank-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "Bank configuration"@en ;
    poi:hasMaximumReasonableDuration "PT1H30M"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT5M"^^xsd:duration ;
    poi:hasTypicalDuration "PT15M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 5 min, typical at 15 min, and anomalous beyond 1 h 30 min. Used by: Bank."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Bar-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "Bar configuration"@en ;
    poi:hasMaximumReasonableDuration "PT6H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT20M"^^xsd:duration ;
    poi:hasTypicalDuration "PT1H30M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 20 min, typical at 1 h 30 min, and anomalous beyond 6 h. Used by: Bar."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Beach-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "Beach configuration"@en ;
    poi:hasMaximumReasonableDuration "PT10H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT30M"^^xsd:duration ;
    poi:hasTypicalDuration "PT3H"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 30 min, typical at 3 h, and anomalous beyond 10 h. Used by: Beach."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Bench-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "Bench configuration"@en ;
    poi:hasMaximumReasonableDuration "PT30M"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT1M"^^xsd:duration ;
    poi:hasTypicalDuration "PT5M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 1 min, typical at 5 min, and anomalous beyond 30 min. Used by: no POI class (not linked in this version)."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:BusStation-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "BusStation configuration"@en ;
    poi:hasMaximumReasonableDuration "PT2H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT5M"^^xsd:duration ;
    poi:hasTypicalDuration "PT15M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 5 min, typical at 15 min, and anomalous beyond 2 h. Used by: BusStation."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Cafe-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "Cafe configuration"@en ;
    poi:hasMaximumReasonableDuration "PT3H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT15M"^^xsd:duration ;
    poi:hasTypicalDuration "PT45M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 15 min, typical at 45 min, and anomalous beyond 3 h. Used by: Cafe."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Church-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "Church configuration"@en ;
    poi:hasMaximumReasonableDuration "PT3H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT15M"^^xsd:duration ;
    poi:hasTypicalDuration "PT1H"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 15 min, typical at 1 h, and anomalous beyond 3 h. Used by: Church."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Cinema-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "Cinema configuration"@en ;
    poi:hasMaximumReasonableDuration "PT5H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT1H30M"^^xsd:duration ;
    poi:hasTypicalDuration "PT2H30M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 1 h 30 min, typical at 2 h 30 min, and anomalous beyond 5 h. Used by: Cinema."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Clinic-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "Clinic configuration"@en ;
    poi:hasMaximumReasonableDuration "PT4H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT20M"^^xsd:duration ;
    poi:hasTypicalDuration "PT1H"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 20 min, typical at 1 h, and anomalous beyond 4 h. Used by: Clinic."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Club-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "Club configuration"@en ;
    poi:hasMaximumReasonableDuration "PT12H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT45M"^^xsd:duration ;
    poi:hasTypicalDuration "PT4H"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 45 min, typical at 4 h, and anomalous beyond 12 h. Used by: Club."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:CommercialPOI-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "CommercialPOI configuration"@en ;
    poi:hasMaximumReasonableDuration "PT5H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT3M"^^xsd:duration ;
    poi:hasTypicalDuration "PT25M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 3 min, typical at 25 min, and anomalous beyond 5 h. Used by: Commercial, Promotional."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:CommercialStreet-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "CommercialStreet configuration"@en ;
    poi:hasMaximumReasonableDuration "PT6H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT20M"^^xsd:duration ;
    poi:hasTypicalDuration "PT1H15M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 20 min, typical at 1 h 15 min, and anomalous beyond 6 h. Used by: CommercialStreet."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:CulturalPOI-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "CulturalPOI configuration"@en ;
    poi:hasMaximumReasonableDuration "PT4H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT2M"^^xsd:duration ;
    poi:hasTypicalDuration "PT20M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 2 min, typical at 20 min, and anomalous beyond 4 h. Used by: Cultural."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:Default-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "Default POI configuration"@en ;
    poi:hasMaximumReasonableDuration "PT1H"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT15S"^^xsd:duration ;
    poi:hasTypicalDuration "PT5M"^^xsd:duration ;
    rdfs:comment "Default dwell thresholds: an interaction is meaningful from 15 s, typical at 5 min, and anomalous beyond 60 min. Linked to trajecto:PointOfInterest, so they apply to POIs without a category and to POIs whose class has no configuration of its own (for example Bench, WaterFountain, VendingMachine, InfoDisplay)."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:DigitalDisplay-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
    rdfs:label "DigitalDisplay configuration"@en ;
    poi:hasMaximumReasonableDuration "PT15M"^^xsd:duration ;
    poi:hasMinimumMeaningfulDuration "PT30S"^^xsd:duration ;
    poi:hasTypicalDuration "PT3M"^^xsd:duration ;
    rdfs:comment "Dwell thresholds: an interaction is meaningful from 30 s, typical at 3 min, and anomalous beyond 15 min. Used by: DigitalDisplay."@en ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/poi> .

poi:DiningPOI-configuration a poi:POITypeConfiguration,
        owl:NamedIndividual ;
