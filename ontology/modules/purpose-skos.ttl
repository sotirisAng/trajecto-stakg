    skos:broader purposeskos:EducationalPurpose ;
    skos:definition "Purpose related to visiting a library for study or research."@en ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Library Visit"@en .

purposeskos:LocalCommunityEngagement a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:ResidentialPurpose ;
    skos:definition "Purpose related to engaging with the local community near one's residence."@en ;
    skos:exactMatch purpose:LocalCommunityEngagement ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Local Community Engagement"@en .

purposeskos:MedicalAppointment a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:HealthcarePurpose ;
    skos:definition "Purpose related to scheduled medical consultations or check-ups."@en ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Medical Appointment"@en .

purposeskos:MuseumVisit a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:CulturalPurpose ;
    skos:definition "Purpose related to visiting museums or exhibitions."@en ;
    skos:exactMatch purpose:MuseumVisit ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Museum Visit"@en .

purposeskos:NightlifeActivity a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:EntertainmentAttendance ;
    skos:definition "Purpose related to nightlife entertainment (bars, clubs, night venues)."@en ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Nightlife Activity"@en .

purposeskos:OfficeWork a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:WorkPurpose ;
    skos:definition "Purpose related to working in an office environment."@en ;
    skos:exactMatch purpose:OfficeWork ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Office Work"@en .

purposeskos:OutdoorRecreation a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:ExerciseActivity ;
    skos:definition "Purpose related to outdoor recreational activities (hiking, cycling, etc.)."@en ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
