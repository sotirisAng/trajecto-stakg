purposeskos:ReligiousPurpose a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:definition "Movement purpose related to religious or spiritual activities."@en ;
    skos:example "Attending church, mosque, temple, or spiritual retreat"@en ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:narrower purposeskos:ReligiousCeremony,
        purposeskos:ReligiousPilgrimage,
        purposeskos:SpiritualRetreat,
        purposeskos:Worship ;
