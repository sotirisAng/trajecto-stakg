    skos:topConceptOf purposeskos:TrajectoryPurposeScheme .

purposeskos:Research a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:EducationalPurpose ;
    skos:definition "Purpose related to research activities."@en ;
    skos:exactMatch purpose:Research ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Research"@en .

