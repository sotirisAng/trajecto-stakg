purposeskos:Parking a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:TransportationPurpose ;
    skos:definition "Purpose related to parking a vehicle."@en ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Parking"@en .

purposeskos:ParkVisit a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:LeisureActivity ;
    skos:definition "Purpose related to visiting parks for relaxation or recreation."@en ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Park Visit"@en .

purposeskos:PharmacyVisit a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:HealthcarePurpose ;
    skos:definition "Purpose related to obtaining medication or pharmaceutical services."@en ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Pharmacy Visit"@en .

purposeskos:PostalService a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:ServiceAccess ;
    skos:definition "Purpose related to using postal or courier services."@en ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Postal Service"@en .

purposeskos:ProfessionalEvent a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:WorkPurpose ;
    skos:definition "Purpose related to attending professional events, conferences, or trade shows."@en ;
    skos:exactMatch purpose:ProfessionalEvent ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Professional Event"@en .

purposeskos:RecreationalPurpose a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:definition "Movement purpose related to leisure and recreational activities."@en ;
    skos:exactMatch purpose:RecreationalPurpose ;
    skos:example "Park visits, beach trips, attending sporting events"@en ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:narrower purposeskos:EntertainmentAttendance,
        purposeskos:ExerciseActivity,
        purposeskos:LeisureActivity,
        purposeskos:SocialGathering,
        purposeskos:Tourism ;
    skos:prefLabel "Recreational Purpose"@en ;
    skos:topConceptOf purposeskos:TrajectoryPurposeScheme .

purposeskos:ReligiousCeremony a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:ReligiousPurpose ;
    skos:definition "Purpose related to attending religious ceremonies (weddings, funerals, baptisms)."@en ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Religious Ceremony"@en .

purposeskos:ReligiousPilgrimage a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:ReligiousPurpose ;
    skos:definition "Purpose related to visiting sacred sites as part of a religious journey."@en ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
