    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Information Seeking"@en ;
    skos:related purposeskos:Tourism .

purposeskos:LeisureActivity a skos:Concept ;
    rdfs:isDefinedBy <http://w3id.org/trajecto/purpose/skos> ;
    skos:broader purposeskos:RecreationalPurpose ;
    skos:definition "Purpose related to casual leisure activities."@en ;
    skos:exactMatch purpose:LeisureActivity ;
    skos:inScheme purposeskos:TrajectoryPurposeScheme ;
    skos:prefLabel "Leisure Activity"@en .

purposeskos:LibraryVisit a skos:Concept ;
