PREFIX dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#>
PREFIX context: <http://w3id.org/trajecto/context#>
PREFIX trajecto: <http://w3id.org/trajecto#>
PREFIX datAcron: <http://www.datacron-project.eu/datAcron#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX time: <http://www.w3.org/2006/time#>


INSERT {
    ?trajectory context:hasTemporalContext ?startTimeOfDay ;
                context:hasTemporalContext ?endTimeOfDay ;
                context:hasTemporalContext ?weekdayType ;
                context:hasTemporalContext ?dayName ;
                context:hasTemporalContext ?season ;
                time:hasDuration ?duration .
}
WHERE {
    ?trajectory a datAcron:Trajectory .

    # Find first position (index = 1)
  	?firstPos dul:isPartOf ?trajectory.
    ?firstPos trajecto:hasPositionIndex 1 ;
              trajecto:timestamp ?startTimestamp .

    # Find last position (no next position)
  	?lastPos dul:isPartOf ?trajectory .
    ?lastPos trajecto:timestamp ?endTimestamp .
    FILTER NOT EXISTS {
        ?lastPos trajecto:hasNextPosition ?anyNext .
    }

    BIND(?endTimestamp - ?startTimestamp AS ?duration)

#    # Extract hours from start and end
  	BIND(HOURS(xsd:dateTime(?startTimestamp)) AS ?startHour)
  	BIND(HOURS(xsd:dateTime(?endTimestamp)) AS ?endHour)

#    Determine time of day for start
    BIND(
        IF(?startHour >= 6 && ?startHour < 12, context:Morning,
        IF(?startHour >= 12 && ?startHour < 18, context:Afternoon,
        IF(?startHour >= 18 && ?startHour < 22, context:Evening,
        context:Night)))
        AS ?startTimeOfDay
    )

#    Determine time of day for end
    BIND(
        IF(?endHour >= 6 && ?endHour < 12, context:Morning,
        IF(?endHour >= 12 && ?endHour < 18, context:Afternoon,
        IF(?endHour >= 18 && ?endHour < 22, context:Evening,
        context:Night)))
        AS ?endTimeOfDay
    )

    BIND(MONTH(xsd:dateTime(?startTimestamp)) AS ?month)
    BIND(
        IF(?month >= 3 && ?month <= 5, context:Spring,
        IF(?month >= 6 && ?month <= 8, context:Summer,
        IF(?month >= 9 && ?month <= 11, context:Fall,
        context:Winter)))
        AS ?season
    )

#    Calculate day of week for start point
  BIND(xsd:date(xsd:dateTime(?startTimestamp)) AS ?startDate)
  # Calculate days since epoch (1970-01-01 was a Thursday)
  BIND("1970-01-01"^^xsd:date AS ?epoch)
  BIND((?startDate - ?epoch) / "P1D"^^xsd:dayTimeDuration AS ?daysSinceEpoch)

  # dayOfWeek = days - (floor(days/7) * 7)
  BIND(FLOOR(?daysSinceEpoch) AS ?totalDays)
  BIND(FLOOR(?totalDays / 7) AS ?weeks)
  BIND(?totalDays - (?weeks * 7) AS ?dayOffset)

  # Thursday = 4, so we add 3 to align Monday = 0
  BIND(?dayOffset + 3 AS ?tempDay)
  BIND(FLOOR(?tempDay / 7) AS ?tempWeeks)
  BIND(?tempDay - (?tempWeeks * 7) AS ?adjustedDay)
  BIND(?adjustedDay + 1 AS ?dayOfWeek)

  BIND(
    IF(?dayOfWeek = 1, time:Monday,
    IF(?dayOfWeek = 2, time:Tuesday,
    IF(?dayOfWeek = 3, time:Wednesday,
    IF(?dayOfWeek = 4, time:Thursday,
    IF(?dayOfWeek = 5, time:Friday,
    IF(?dayOfWeek = 6, time:Saturday,
    IF(?dayOfWeek = 7, time:Sunday, "Unknown"))))))) AS ?dayName)

    BIND(
        IF(?dayOfWeek > 0 && ?dayOfWeek <= 5, context:Weekday, context:Weekend)
        AS ?weekdayType
    )
}